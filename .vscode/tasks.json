{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Set Conf File",
            "command": "${workspaceFolder}\\Tools\\configure.bat",
            "args": ["${workspaceFolder}"],
            "group": "none",
            "problemMatcher": [],
            "detail": "Set DOSBox config"
        },

        {
            "type": "shell",
            "label": "Assemble Only",
            "command": "${workspaceFolder}\\Tools\\nasm",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.COM"
            ],
            "group": "build",
            "problemMatcher": []
        },

        {
            "type": "shell",
            "label": "Assemble and Link",
            "command": "${workspaceFolder}\\Tools\\nasm",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.COM",
                "-l",
                "${fileDirname}\\${fileBasenameNoExtension}.LST"
            ],
            "group": "build",
            "problemMatcher": []
        },

        {
            "type": "shell",
            "label": "Build ELF File",
            "command": "${workspaceFolder}\\Tools\\convert_to_elf.bat",
            "args": [
                "${file}",
                "${fileDirname}",
                "${fileBasenameNoExtension}",
                "${workspaceFolder}\\Tools\\nasm"
            ],
            "group": "build",
            "problemMatcher": []
        },

        {
            "type": "shell",
            "label": "Assemble and Run",
            "command": "${workspaceFolder}\\DOSBoxPortable\\DOSBoxPortable.exe",
            "args": [
                "-conf",
                "${workspaceFolder}\\dosbox.conf",
                "-c",
                "mount c ${workspaceFolder}\\Code",
                "-c",
                "c:",
                "-c",
                "Code\\coden.COM"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "Set Conf File",
                "Assemble and Link"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },

        {
            "type": "shell",
            "label": "Debug with AFD",
            "command": "${workspaceFolder}\\DOSBoxPortable\\DOSBoxPortable.exe",
            "args": [
                "-conf",
                "${workspaceFolder}\\dosbox.conf",
                "-c",
                "mount c ${workspaceFolder}",
                "-c",
                "c:",
                "-c",
                "Tools\\afd Code\\${fileBasenameNoExtension}.COM"
            ],
            "dependsOn": ["Set Conf File", "Assemble and Link"],
            "group": "test",
            "problemMatcher": []
        },

        {
            "type": "shell",
            "label": "Assemble and Debug",
            "command": "${workspaceFolder}\\DOSBoxPortable\\DOSBoxPortable.exe",
            "args": [
                "-conf",
                "${workspaceFolder}\\dosbox.conf",
                "-c",
                "mount c ${workspaceFolder}",
                "-c",
                "c:",
                "-c",
                "Code\\debug.COM Code\\${fileBasenameNoExtension}.COM"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "Set Conf File",
                "Assemble and Link",
                "Build ELF File"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
