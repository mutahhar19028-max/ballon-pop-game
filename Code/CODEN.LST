   202 00002B25 BA5A00              <1>     mov dx, 90
   203 00002B28 BE[862B]            <1>     mov si, help_line1
   204 00002B2B 8A1E[1100]          <1>     mov bl, [dark_brown]
   205 00002B2F B701                <1>     mov bh, 1
   206 00002B31 E8ACD6              <1>     call drawText
   207                              <1> 
   208 00002B34 B91E00              <1>     mov cx, 30
   209 00002B37 BA6900              <1>     mov dx, 105
   210 00002B3A BE[9F2B]            <1>     mov si, help_line2
   211 00002B3D 8A1E[1100]          <1>     mov bl, [dark_brown]
   212 00002B41 B701                <1>     mov bh, 1
   213 00002B43 E89AD6              <1>     call drawText
   214                              <1> 
   215 00002B46 B91E00              <1>     mov cx, 30
   216 00002B49 BA7800              <1>     mov dx, 120
   217 00002B4C BE[B72B]            <1>     mov si, help_line3
   218 00002B4F 8A1E[1100]          <1>     mov bl, [dark_brown]
   219 00002B53 B701                <1>     mov bh, 1
   220 00002B55 E888D6              <1>     call drawText
   221                              <1> 
   222 00002B58 B93200              <1>     mov cx, 50
   223 00002B5B BA9600              <1>     mov dx, 150
   224 00002B5E BE[CA2B]            <1>     mov si, help_exit
   225 00002B61 8A1E[1000]          <1>     mov bl, [nature_dark_green]
   226 00002B65 B701                <1>     mov bh, 1
   227 00002B67 E876D6              <1>     call drawText
   228                              <1> 
   229                              <1>     ; Wait for keypress
