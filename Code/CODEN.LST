   271                              <1> 
   272                              <1> ; Selected button index
   273 0000060C 00                  <1> selected_pause_button db 0        ; Tracks which button is currently selected
   274                              <1> 
   275                              <1> ; Placeholder for redraw function
   276                              <1> ; If you already implement this in ui.asm, make it PUBLIC
   277                              <1> redraw_pause_buttons_only  equ 0  ; Can be a dummy placeholder if function is implemented elsewhere
    13                                  %include "Code\timer.asm"
     1                              <1> ; ============================================================
     2                              <1> ; timer.asm — IRQ0-based Timer System (1 second updates)
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> ; ------------------------------------------------------------
     6                              <1> ; TIMER CONFIGURATION
     7                              <1> ; ------------------------------------------------------------
     8                              <1> %define PIT_CHANNEL0    0x40    ; PIT channel 0 data port
     9                              <1> %define PIT_COMMAND     0x43    ; PIT command port
    10                              <1> %define PIC_COMMAND     0x20    ; 8259 PIC command port
    11                              <1> %define PIC_DATA        0x21    ; 8259 PIC data port
    12                              <1> 
    13                              <1> %define TICKS_PER_SEC   18      ; Default: 18.2 Hz, we'll use 18 for simplicity
    14                              <1> %define GAME_TIME_SEC   120     ; 2 minutes = 120 seconds
    15 0000060D 0000                <1> ticks       dw 0            ; global tick counter
    16                              <1> 
    17                              <1> 
    18                              <1> ; ------------------------------------------------------------
    19                              <1> ; TIMER VARIABLES
    20                              <1> ; ------------------------------------------------------------
    21 0000060F 7800                <1> timer_seconds       dw GAME_TIME_SEC    ; Remaining seconds (120)
    22 00000611 02                  <1> timer_minutes       db 2                ; Display minutes
    23 00000612 00                  <1> timer_display_sec   db 0                ; Display seconds
    24 00000613 00                  <1> timer_ticks         db 0                ; Tick counter (0-17)
    25 00000614 00000000            <1> old_timer_vector    dd 0                ; Original IRQ0 handler address
    26 00000618 00                  <1> timer_active        db 0                ; Timer running flag
    27                              <1> 
    28                              <1> ; ------------------------------------------------------------
    29                              <1> ; installTimerISR
    30                              <1> ; Hooks IRQ0 (INT 08h) to custom timer handler
    31                              <1> ; Saves original vector for restoration
    32                              <1> ; ------------------------------------------------------------
    33                              <1> installTimerISR:
    34 00000619 50                  <1>     push ax
    35 0000061A 53                  <1>     push bx
    36 0000061B 51                  <1>     push cx
    37 0000061C 52                  <1>     push dx
    38 0000061D 06                  <1>     push es
    39                              <1> 
    40                              <1>     ; Save old INT 08h vector
    41 0000061E B80835              <1>     mov ax, 0x3508          ; AH=35h (Get interrupt vector), AL=08h
    42 00000621 CD21                <1>     int 0x21
    43 00000623 891E[1406]          <1>     mov word [old_timer_vector], bx
    44 00000627 8C06[1606]          <1>     mov word [old_timer_vector+2], es
    45                              <1> 
    46                              <1>     ; Install new handler
    47 0000062B 1E                  <1>     push ds
    48 0000062C 8CC8                <1>     mov ax, cs
    49 0000062E 8ED8                <1>     mov ds, ax
    50 00000630 BA[6906]            <1>     mov dx, timerISR
    51 00000633 B80825              <1>     mov ax, 0x2508          ; AH=25h (Set interrupt vector), AL=08h
    52 00000636 CD21                <1>     int 0x21
    53 00000638 1F                  <1>     pop ds
    54                              <1> 
    55                              <1>     ; Initialize timer variables
    56 00000639 C706[0F06]7800      <1>     mov word [timer_seconds], GAME_TIME_SEC
    57 0000063F C606[1106]02        <1>     mov byte [timer_minutes], 2
    58 00000644 C606[1206]00        <1>     mov byte [timer_display_sec], 0
    59 00000649 C606[1306]00        <1>     mov byte [timer_ticks], 0
    60 0000064E C606[1806]01        <1>     mov byte [timer_active], 1
    61                              <1> 
    62 00000653 07                  <1>     pop es
    63 00000654 5A                  <1>     pop dx
    64 00000655 59                  <1>     pop cx
    65 00000656 5B                  <1>     pop bx
    66 00000657 58                  <1>     pop ax
    67 00000658 C3                  <1>     ret
    68                              <1> 
    69                              <1> ; ------------------------------------------------------------
    70                              <1> ; restoreTimerISR
    71                              <1> ; Restores original IRQ0 handler
    72                              <1> ; Call before program exit!
    73                              <1> ; ------------------------------------------------------------
    74                              <1> restoreTimerISR:
    75 00000659 50                  <1>     push ax
    76 0000065A 52                  <1>     push dx
    77 0000065B 1E                  <1>     push ds
    78                              <1> 
    79                              <1>     ; Restore old INT 08h vector
    80 0000065C C516[1406]          <1>     lds dx, [old_timer_vector]
    81 00000660 B80825              <1>     mov ax, 0x2508
    82 00000663 CD21                <1>     int 0x21
    83                              <1> 
    84 00000665 1F                  <1>     pop ds
    85 00000666 5A                  <1>     pop dx
    86 00000667 58                  <1>     pop ax
    87 00000668 C3                  <1>     ret
    88                              <1> 
    89                              <1> ; ------------------------------------------------------------
    90                              <1> ; timerISR
    91                              <1> ; Custom IRQ0 handler - called ~18.2 times per second
    92                              <1> ; Decrements timer every 18 ticks (approximately 1 second)
    93                              <1> ; ------------------------------------------------------------
    94                              <1> timerISR:
    95 00000669 50                  <1>     push ax
    96 0000066A 53                  <1>     push bx
    97 0000066B 51                  <1>     push cx
    98 0000066C 52                  <1>     push dx
    99 0000066D 56                  <1>     push si
   100 0000066E 57                  <1>     push di
   101 0000066F 1E                  <1>     push ds
   102 00000670 06                  <1>     push es
   103                              <1> 
   104                              <1>     ; Set DS to our data segment
   105 00000671 8CC8                <1>     mov ax, cs
   106 00000673 8ED8                <1>     mov ds, ax
   107                              <1> 
   108                              <1>     ; Check if timer is active
   109 00000675 803E[1806]01        <1>     cmp byte [timer_active], 1
   110 0000067A 7522                <1>     jne .chain_to_old
   111                              <1> 
   112                              <1>     ; Increment tick counter
   113 0000067C FE06[1306]          <1>     inc byte [timer_ticks]
   114 00000680 803E[1306]12        <1>     cmp byte [timer_ticks], TICKS_PER_SEC
   115 00000685 7217                <1>     jb .chain_to_old        ; Not 1 second yet
   116                              <1> 
   117                              <1>     ; Reset tick counter
   118 00000687 C606[1306]00        <1>     mov byte [timer_ticks], 0
   119                              <1> 
   120                              <1>     ; Decrement seconds
   121 0000068C 833E[0F06]00        <1>     cmp word [timer_seconds], 0
   122 00000691 7418                <1>     je .timer_expired       ; Already at 0
   123                              <1> 
   124 00000693 FF0E[0F06]          <1>     dec word [timer_seconds]
   125 00000697 FF06[0D06]          <1>     inc word [ticks]
   126                              <1> 
   127                              <1>     ; Update display format (MM:SS)
   128 0000069B E81400              <1>     call updateTimerDisplay
   129                              <1> 
   130                              <1> .chain_to_old:
   131                              <1>     ; Send EOI to PIC
   132 0000069E B020                <1>     mov al, 0x20
   133 000006A0 E620                <1>     out PIC_COMMAND, al
   134                              <1> 
   135 000006A2 07                  <1>     pop es
   136 000006A3 1F                  <1>     pop ds
   137 000006A4 5F                  <1>     pop di
   138 000006A5 5E                  <1>     pop si
   139 000006A6 5A                  <1>     pop dx
   140 000006A7 59                  <1>     pop cx
   141 000006A8 5B                  <1>     pop bx
   142 000006A9 58                  <1>     pop ax
   143 000006AA CF                  <1>     iret                    ; Return from interrupt
   144                              <1> 
   145                              <1> .timer_expired:
   146                              <1>     ; Timer reached 0 - trigger game over
   147 000006AB C606[1806]00        <1>     mov byte [timer_active], 0
   148                              <1>     ; Game state will be checked in main loop
   149 000006B0 EBEC                <1>     jmp .chain_to_old
   150                              <1> 
   151                              <1> ; ------------------------------------------------------------
   152                              <1> ; updateTimerDisplay
   153                              <1> ; Converts timer_seconds to MM:SS format
   154                              <1> ; Updates timer_minutes and timer_display_sec
   155                              <1> ; ------------------------------------------------------------
   156                              <1> updateTimerDisplay:
   157 000006B2 50                  <1>     push ax
   158 000006B3 53                  <1>     push bx
   159 000006B4 52                  <1>     push dx
   160                              <1> 
   161                              <1>     ; Get total seconds
   162 000006B5 A1[0F06]            <1>     mov ax, [timer_seconds]
   163                              <1> 
   164                              <1>     ; Divide by 60 to get minutes
   165 000006B8 31D2                <1>     xor dx, dx
   166 000006BA BB3C00              <1>     mov bx, 60
   167 000006BD F7F3                <1>     div bx                  ; AX = minutes, DX = seconds
   168                              <1> 
   169                              <1>     ; Store results
   170 000006BF A2[1106]            <1>     mov [timer_minutes], al
   171 000006C2 8816[1206]          <1>     mov [timer_display_sec], dl
   172                              <1> 
   173 000006C6 5A                  <1>     pop dx
   174 000006C7 5B                  <1>     pop bx
   175 000006C8 58                  <1>     pop ax
   176 000006C9 C3                  <1>     ret
   177                              <1> 
   178                              <1> ; ------------------------------------------------------------
   179                              <1> ; resetTimer
   180                              <1> ; Resets timer to initial value (120 seconds)
   181                              <1> ; ------------------------------------------------------------
   182                              <1> resetTimer:
   183 000006CA 50                  <1>     push ax
   184                              <1> 
   185 000006CB C706[0F06]7800      <1>     mov word [timer_seconds], GAME_TIME_SEC
   186 000006D1 C606[1106]02        <1>     mov byte [timer_minutes], 2
   187 000006D6 C606[1206]00        <1>     mov byte [timer_display_sec], 0
   188 000006DB C606[1306]00        <1>     mov byte [timer_ticks], 0
   189 000006E0 C606[1806]01        <1>     mov byte [timer_active], 1
   190                              <1> 
   191 000006E5 58                  <1>     pop ax
   192 000006E6 C3                  <1>     ret
   193                              <1> 
   194                              <1> ; ------------------------------------------------------------
   195                              <1> ; pauseTimer
   196                              <1> ; Pauses the timer (stops decrementing)
   197                              <1> ; ------------------------------------------------------------
   198                              <1> pauseTimer:
   199 000006E7 C606[1806]00        <1>     mov byte [timer_active], 0
   200 000006EC C3                  <1>     ret
   201                              <1> 
   202                              <1> ; ------------------------------------------------------------
   203                              <1> ; resumeTimer
   204                              <1> ; Resumes the timer (continues decrementing)
   205                              <1> ; ------------------------------------------------------------
   206                              <1> resumeTimer:
   207 000006ED C606[1806]01        <1>     mov byte [timer_active], 1
   208 000006F2 C3                  <1>     ret
   209                              <1> 
   210                              <1> ; ------------------------------------------------------------
   211                              <1> ; isTimerExpired
   212                              <1> ; Returns: AL = 1 if timer expired, 0 otherwise
   213                              <1> ; ------------------------------------------------------------
   214                              <1> isTimerExpired:
   215 000006F3 53                  <1>     push bx
   216                              <1>     
   217 000006F4 B000                <1>     mov al, 0
   218 000006F6 833E[0F06]00        <1>     cmp word [timer_seconds], 0
   219 000006FB 7502                <1>     jne .not_expired
   220 000006FD B001                <1>     mov al, 1
   221                              <1> 
   222                              <1> .not_expired:
   223 000006FF 5B                  <1>     pop bx
   224 00000700 C3                  <1>     ret
   225                              <1> 
   226                              <1> ; ------------------------------------------------------------
   227                              <1> ; getTimerString
   228                              <1> ; Converts timer to "MM:SS" string format
   229                              <1> ; INPUT: SI = pointer to 6-byte buffer (output)
   230                              <1> ; OUTPUT: Buffer filled with "MM:SS\0"
   231                              <1> ; ------------------------------------------------------------
   232                              <1> getTimerString:
   233 00000701 50                  <1>     push ax
   234 00000702 53                  <1>     push bx
   235 00000703 51                  <1>     push cx
   236 00000704 52                  <1>     push dx
   237 00000705 57                  <1>     push di
   238                              <1> 
   239 00000706 89F7                <1>     mov di, si              ; DI = output buffer
   240                              <1> 
   241                              <1>     ; Convert minutes to ASCII
   242 00000708 30E4                <1>     xor ah, ah
   243 0000070A A0[1106]            <1>     mov al, [timer_minutes]
   244 0000070D B30A                <1>     mov bl, 10
   245 0000070F F6F3                <1>     div bl                  ; AH = ones, AL = tens
   246 00000711 0430                <1>     add al, '0'
   247 00000713 8805                <1>     mov [di], al
   248 00000715 47                  <1>     inc di
   249 00000716 88E0                <1>     mov al, ah
   250 00000718 0430                <1>     add al, '0'
   251 0000071A 8805                <1>     mov [di], al
   252 0000071C 47                  <1>     inc di
   253                              <1> 
   254                              <1>     ; Add colon
   255 0000071D C6053A              <1>     mov byte [di], ':'
   256 00000720 47                  <1>     inc di
   257                              <1> 
   258                              <1>     ; Convert seconds to ASCII
   259 00000721 30E4                <1>     xor ah, ah
   260 00000723 A0[1206]            <1>     mov al, [timer_display_sec]
   261 00000726 B30A                <1>     mov bl, 10
   262 00000728 F6F3                <1>     div bl                  ; AH = ones, AL = tens
   263 0000072A 0430                <1>     add al, '0'
   264 0000072C 8805                <1>     mov [di], al
   265 0000072E 47                  <1>     inc di
   266 0000072F 88E0                <1>     mov al, ah
   267 00000731 0430                <1>     add al, '0'
   268 00000733 8805                <1>     mov [di], al
   269 00000735 47                  <1>     inc di
   270                              <1> 
   271                              <1>     ; Null terminator
   272 00000736 C60500              <1>     mov byte [di], 0
   273                              <1> 
   274 00000739 5F                  <1>     pop di
   275 0000073A 5A                  <1>     pop dx
   276 0000073B 59                  <1>     pop cx
   277 0000073C 5B                  <1>     pop bx
   278 0000073D 58                  <1>     pop ax
   279 0000073E C3                  <1>     ret
    14                                  %include "Code\sound.asm"
     1                              <1> ; sound.asm — PC Speaker victory sound
     2                              <1> ; Compatible with NASM (COM or EXE)
     3                              <1> 
     4                              <1> melodyFreqs:
     5 0000073F 20038403E8034C04B0- <1>     dw 800, 900, 1000, 1100, 1200, 1300, 1400, 1500
     5 00000748 0414057805DC05      <1>
     6 0000074F DC0578051405B0044C- <1>     dw 1500, 1400, 1300, 1200, 1100, 1000, 900, 800
     6 00000758 04E80384032003      <1>
     7                              <1> numNotes    equ 16
     8 0000075F 0200                <1> tempo       dw 2
     9 00000761 DC341200            <1> pit_constant: dd 1193180    ; Store as 32-bit constant
    10                              <1> 
    11                              <1> ; ---------------------------------------
    12                              <1> ; playCompletionSound — main entry
    13                              <1> ; ---------------------------------------
    14                              <1> playCompletionSound:
    15 00000765 50                  <1>     push ax
    16 00000766 53                  <1>     push bx
    17 00000767 51                  <1>     push cx
    18 00000768 52                  <1>     push dx
    19 00000769 56                  <1>     push si
    20                              <1> 
    21 0000076A BE[3F07]            <1>     mov si, melodyFreqs
    22 0000076D B91000              <1>     mov cx, numNotes
    23                              <1> .loopNotes:
    24 00000770 AD                  <1>     lodsw                  ; AX = frequency
    25 00000771 09C0                <1>     or  ax, ax
    26 00000773 7405                <1>     jz  .done
    27 00000775 E80800              <1>     call playTune
    28 00000778 E2F6                <1>     loop .loopNotes
    29                              <1> 
    30                              <1> .done:
    31 0000077A 5E                  <1>     pop si
    32 0000077B 5A                  <1>     pop dx
    33 0000077C 59                  <1>     pop cx
    34 0000077D 5B                  <1>     pop bx
    35 0000077E 58                  <1>     pop ax
    36 0000077F C3                  <1>     ret
    37                              <1> 
    38                              <1> ; ---------------------------------------
    39                              <1> ; playTune — AX = frequency (Hz)
    40                              <1> ; ---------------------------------------
    41                              <1> playTune:
    42 00000780 50                  <1>     push ax
    43 00000781 53                  <1>     push bx
    44 00000782 51                  <1>     push cx
    45 00000783 52                  <1>     push dx
    46                              <1> 
    47 00000784 89C3                <1>     mov bx, ax              ; Save frequency in BX
    48                              <1>     
    49                              <1>     ; Load 1193180 into DX:AX
    50 00000786 A1[6107]            <1>     mov ax, word [pit_constant]      ; Low word
    51 00000789 8B16[6307]          <1>     mov dx, word [pit_constant + 2]  ; High word
    52                              <1>     
    53                              <1>     ; Divide DX:AX by BX -> quotient in AX
    54 0000078D F7F3                <1>     div bx                  ; DX:AX / BX = AX (remainder in DX)
    55 0000078F 89C3                <1>     mov bx, ax              ; BX = divisor
    56                              <1> 
    57                              <1>     ; Program PIT channel 2
    58 00000791 B0B6                <1>     mov al, 0xB6
    59 00000793 E643                <1>     out 0x43, al
    60 00000795 89D8                <1>     mov ax, bx
    61 00000797 E642                <1>     out 0x42, al            ; low byte
    62 00000799 88E0                <1>     mov al, ah
    63 0000079B E642                <1>     out 0x42, al            ; high byte
    64                              <1> 
    65                              <1>     ; Enable speaker
    66 0000079D E461                <1>     in al, 0x61
    67 0000079F 0C03                <1>     or al, 3
    68 000007A1 E661                <1>     out 0x61, al
    69                              <1> 
    70                              <1>     ; Hold tone
    71 000007A3 E80B00              <1>     call toneDelay
    72                              <1> 
    73                              <1>     ; Disable speaker
    74 000007A6 E461                <1>     in al, 0x61
    75 000007A8 24FC                <1>     and al, 0xFC
    76 000007AA E661                <1>     out 0x61, al
    77                              <1> 
    78 000007AC 5A                  <1>     pop dx
    79 000007AD 59                  <1>     pop cx
    80 000007AE 5B                  <1>     pop bx
    81 000007AF 58                  <1>     pop ax
    82 000007B0 C3                  <1>     ret
    83                              <1> 
    84                              <1> ; ---------------------------------------
    85                              <1> ; toneDelay — simple busy wait
    86                              <1> ; ---------------------------------------
    87                              <1> toneDelay:
    88 000007B1 51                  <1>     push cx
    89 000007B2 52                  <1>     push dx
    90 000007B3 8B16[5F07]          <1>     mov dx, [tempo]
    91                              <1> .delayOuter:
    92 000007B7 B9FFAF              <1>     mov cx, 0xAFFF
    93                              <1> .delayInner:
    94 000007BA E2FE                <1>     loop .delayInner
    95 000007BC 4A                  <1>     dec dx
    96 000007BD 75F8                <1>     jnz .delayOuter
    97 000007BF 5A                  <1>     pop dx
    98 000007C0 59                  <1>     pop cx
    99 000007C1 C3                  <1>     ret
    15                                  %include "Code\show_bg.asm"
     1                              <1> ; ============================================================
     2                              <1> ; show_bg.asm — Draws VGA 320x200x256 background with palette
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> %define MODE_VGA13H  0x0013
     6                              <1> %define VIDEO_SEG    0xA000
     7                              <1> %define SCREEN_SIZE  64000
     8                              <1> %define CHUNK_SIZE   8192
     9                              <1> 
    10                              <1> ; ------------------------------------------------------------
    11                              <1> ; PUBLIC: showBackground320x200
    12                              <1> ; Loads and displays final.raw using vga.bin palette
    13                              <1> ; Palette is loaded only on first call.
    14                              <1> ; ------------------------------------------------------------
    15                              <1> showBackground320x200:
    16 000007C2 50                  <1>     push ax
    17 000007C3 53                  <1>     push bx
    18 000007C4 51                  <1>     push cx
    19 000007C5 52                  <1>     push dx
    20 000007C6 56                  <1>     push si
    21 000007C7 57                  <1>     push di
    22 000007C8 1E                  <1>     push ds
    23 000007C9 06                  <1>     push es
    24                              <1> 
    25                              <1>     ; If palette not loaded yet -> load it once
    26 000007CA A0[762B]            <1>     mov al, [palette_loaded]
    27 000007CD 3C01                <1>     cmp al, 1
    28 000007CF 7408                <1>     je .skip_palette
    29 000007D1 E84E00              <1>     call load_palette
    30 000007D4 C606[762B]01        <1>     mov byte [palette_loaded], 1
    31                              <1> 
    32                              <1> .skip_palette:
    33                              <1>     ; --------------------------------------------------------
    34                              <1>     ; Load and display background image from "final.raw"
    35                              <1>     ; (same behavior as before)
    36                              <1>     ; --------------------------------------------------------
    37 000007D9 B800A0              <1>     mov ax, VIDEO_SEG
    38 000007DC 8EC0                <1>     mov es, ax
    39 000007DE 31FF                <1>     xor di, di
    40                              <1> 
    41                              <1>     ; Open RAW file (read-only)
    42 000007E0 8D16[5E08]          <1>     lea dx, [filename]
    43 000007E4 B43D                <1>     mov ah, 0x3D
    44 000007E6 30C0                <1>     xor al, al
    45 000007E8 CD21                <1>     int 0x21
    46 000007EA 722D                <1>     jc .cleanup
    47 000007EC 89C3                <1>     mov bx, ax                  ; BX = file handle
    48                              <1> 
    49                              <1> .read_loop:
    50                              <1>     ; Read chunk into buffer
    51 000007EE B43F                <1>     mov ah, 0x3F
    52 000007F0 B90020              <1>     mov cx, CHUNK_SIZE
    53 000007F3 8D16[7608]          <1>     lea dx, [buffer]
    54 000007F7 CD21                <1>     int 0x21
    55 000007F9 721A                <1>     jc .close_file
    56 000007FB 09C0                <1>     or ax, ax
    57 000007FD 7416                <1>     jz .close_file              ; EOF reached
    58                              <1> 
    59                              <1>     ; Copy to VGA memory (use ES:DI for video, DS:SI for buffer)
    60 000007FF 1E                  <1>     push ds
    61 00000800 BE[7608]            <1>     mov si, buffer
    62 00000803 89C1                <1>     mov cx, ax
    63                              <1> .copy_loop:
    64 00000805 8A04                <1>     mov al, [si]
    65 00000807 268805              <1>     mov [es:di], al
    66 0000080A 46                  <1>     inc si
    67 0000080B 47                  <1>     inc di
    68 0000080C E2F7                <1>     loop .copy_loop
    69 0000080E 1F                  <1>     pop ds
    70                              <1> 
    71 0000080F 81FF00FA            <1>     cmp di, SCREEN_SIZE
    72 00000813 72D9                <1>     jb .read_loop
    73                              <1> 
    74                              <1> .close_file:
    75 00000815 B43E                <1>     mov ah, 0x3E
    76 00000817 CD21                <1>     int 0x21
    77                              <1> 
    78                              <1> .cleanup:
    79 00000819 07                  <1>     pop es
