   734 000003AC 8B4EFE              <1>     mov cx, [bp-2]
   735 000003AF 034EF4              <1>     add cx, [bp-12]
   736 000003B2 8B56FC              <1>     mov dx, [bp-4]
   737 000003B5 2B56F6              <1>     sub dx, [bp-10]
   738 000003B8 E805FF              <1>     call putPixel
   739                              <1> 
   740                              <1>     ; 8: (cx - y, cy - x)
   741 000003BB 8B4EFE              <1>     mov cx, [bp-2]
   742 000003BE 2B4EF4              <1>     sub cx, [bp-12]
   743 000003C1 8B56FC              <1>     mov dx, [bp-4]
   744 000003C4 2B56F6              <1>     sub dx, [bp-10]
   745 000003C7 E8F6FE              <1>     call putPixel
   746                              <1> 
   747 000003CA 8B46F2              <1>     mov ax, [bp-14]
