    64                              <1> ; ------------------------------------------------------------
    65                              <1> ; PUBLIC: drawScoreValue
    66                              <1> ; Draws the current score at defined position
    67                              <1> ; Called by drawScorePanel
    68                              <1> ; ------------------------------------------------------------
    69                              <1> drawScoreValue:
    70 00002E2F 50                  <1>     push ax
    71 00002E30 53                  <1>     push bx
    72 00002E31 51                  <1>     push cx
    73 00002E32 52                  <1>     push dx
    74 00002E33 56                  <1>     push si
    75 00002E34 57                  <1>     push di
    76 00002E35 55                  <1>     push bp
    77                              <1> 
    78                              <1>     ; Allocate 5 bytes for "0000\0"
    79 00002E36 83EC05              <1>     sub sp, 5
    80 00002E39 89E5                <1>     mov bp, sp          ; BP points to buffer
    81                              <1> 
    82 00002E3B A1[E405]            <1>     mov ax, [current_score]  ; AX = current score
    83                              <1> 
    84                              <1>     ; --- Thousands digit ---
    85 00002E3E B9E803              <1>     mov cx, 1000
    86 00002E41 31D2                <1>     xor dx, dx
    87 00002E43 F7F1                <1>     div cx                  ; AX / 1000 -> AX = quotient in AL, DX = remainder
    88 00002E45 0430                <1>     add al, '0'
    89 00002E47 884600              <1>     mov [bp], al            ; store thousands digit
    90                              <1> 
    91                              <1>     ; --- Hundreds digit ---
    92 00002E4A 89D0                <1>     mov ax, dx               ; remainder from thousands division
    93 00002E4C B96400              <1>     mov cx, 100
    94 00002E4F 31D2                <1>     xor dx, dx
    95 00002E51 F7F1                <1>     div cx                   ; AX / 100 -> AL = hundreds, DX = remainder
    96 00002E53 0430                <1>     add al, '0'
    97 00002E55 884601              <1>     mov [bp+1], al
    98                              <1> 
    99                              <1>     ; --- Tens digit ---
   100 00002E58 89D0                <1>     mov ax, dx               ; remainder from hundreds
   101 00002E5A B90A00              <1>     mov cx, 10
   102 00002E5D 31D2                <1>     xor dx, dx
   103 00002E5F F7F1                <1>     div cx                   ; AX / 10 -> AL = tens, DX = ones
   104 00002E61 0430                <1>     add al, '0'
   105 00002E63 884602              <1>     mov [bp+2], al
   106                              <1> 
   107                              <1>     ; --- Ones digit ---
   108 00002E66 88D0                <1>     mov al, dl               ; remainder from tens division
   109 00002E68 0430                <1>     add al, '0'
   110 00002E6A 884603              <1>     mov [bp+3], al
   111                              <1> 
   112                              <1>     ; --- Null terminator ---
   113 00002E6D C6460400            <1>     mov byte [bp+4], 0
   114                              <1> 
   115                              <1>     ; Draw score string
   116 00002E71 B98C00              <1>     mov cx, SCORE_VALUE_X - 14
   117 00002E74 BA0A00              <1>     mov dx, SCORE_VALUE_Y - 2
   118 00002E77 89EE                <1>     mov si, bp
   119 00002E79 8A1E[1100]          <1>     mov bl, [dark_brown]
   120 00002E7D B701                <1>     mov bh, 1
   121 00002E7F E85ED3              <1>     call drawText
   122                              <1> 
   123 00002E82 83C405              <1>     add sp, 5
   124 00002E85 5D                  <1>     pop bp
   125 00002E86 5F                  <1>     pop di
   126 00002E87 5E                  <1>     pop si
   127 00002E88 5A                  <1>     pop dx
   128 00002E89 59                  <1>     pop cx
   129 00002E8A 5B                  <1>     pop bx
   130 00002E8B 58                  <1>     pop ax
   131 00002E8C C3                  <1>     ret
   132                              <1> 
   133                              <1> ;; ------------------------------------------------------------
   134                              <1> ; drawTimerPanel
   135                              <1> ; Draws timer panel with dynamic time display
   136                              <1> ; ------------------------------------------------------------
   137                              <1> drawTimerPanel:
   138 00002E8D 50                  <1>     push ax
   139 00002E8E 53                  <1>     push bx
   140 00002E8F 51                  <1>     push cx
   141 00002E90 52                  <1>     push dx
   142 00002E91 56                  <1>     push si
   143 00002E92 57                  <1>     push di
   144                              <1> 
   145                              <1>     ; Draw panel background
   146 00002E93 B8D100              <1>     mov ax, TIMER_PANEL_X
   147 00002E96 BB0400              <1>     mov bx, TIMER_PANEL_Y
   148 00002E99 B96900              <1>     mov cx, TIMER_PANEL_WIDTH
   149 00002E9C BA1400              <1>     mov dx, TIMER_PANEL_HEIGHT
   150 00002E9F 8B36[0700]          <1>     mov si, TIMER_PANEL_COLOR
   151 00002EA3 8B3E[0800]          <1>     mov di, TIMER_BORDER_COLOR
   152 00002EA7 E86AD1              <1>     call drawRoundedRect
   153                              <1> 
