   134                              <1> ; drawTimerPanel
   135                              <1> ; Draws timer panel with dynamic time display
   136                              <1> ; ------------------------------------------------------------
   137                              <1> drawTimerPanel:
   138 00002E87 50                  <1>     push ax
   139 00002E88 53                  <1>     push bx
   140 00002E89 51                  <1>     push cx
   141 00002E8A 52                  <1>     push dx
   142 00002E8B 56                  <1>     push si
