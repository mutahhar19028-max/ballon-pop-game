     1                              <1> ; ============================================================
     2                              <1> ; navigation.asm — Menu Navigation System with Arrow Keys
     3                              <1> ; ============================================================
     4                              <1> ; ------------------------------------------------------------
     5                              <1> ; drawMenuArrow
     6                              <1> ; Draws '>' arrow at current selection position
     7                              <1> ; ------------------------------------------------------------
     8                              <1> drawMenuArrow:
     9 00002B77 50                  <1>     push ax
    10 00002B78 53                  <1>     push bx
    11 00002B79 51                  <1>     push cx
    12 00002B7A 52                  <1>     push dx
    13                              <1> 
    14                              <1>     ; Calculate Y position based on selection
    15 00002B7B 31C0                <1>     xor ax, ax
    16 00002B7D A0[0A06]            <1>     mov al, [current_selection]
    17 00002B80 BB1700              <1>     mov bx, MENU_BUTTON_HEIGHT
    18 00002B83 83C30B              <1>     add bx, MENU_BUTTON_HEIGHT / 2  ; Spacing between buttons
    19 00002B86 F7E3                <1>     mul bx
    20 00002B88 83C058              <1>     add ax, ARROW_FIRST_Y
    21 00002B8B 89C2                <1>     mov dx, ax
    22                              <1> 
    23                              <1>     ; Draw arrow
    24 00002B8D B96400              <1>     mov cx, ARROW_X_OFFSET
    25 00002B90 8A1E[1100]          <1>     mov bl, [dark_brown]     ; Arrow color
    26 00002B94 E858D7              <1>     call drawSelectionArrow
    27                              <1> 
    28 00002B97 5A                  <1>     pop dx
    29 00002B98 59                  <1>     pop cx
    30 00002B99 5B                  <1>     pop bx
    31 00002B9A 58                  <1>     pop ax
    32 00002B9B C3                  <1>     ret
    33                              <1> 
    34                              <1> ; ------------------------------------------------------------
    35                              <1> ; clearMenuArrow
    36                              <1> ; Erases arrow at current selection (draws space in bg color)
    37                              <1> ; ------------------------------------------------------------
    38                              <1> clearMenuArrow:
    39 00002B9C 50                  <1>     push ax
    40 00002B9D 53                  <1>     push bx
    41 00002B9E 51                  <1>     push cx
    42 00002B9F 52                  <1>     push dx
    43                              <1> 
    44                              <1>     ; Calculate Y position
    45 00002BA0 31C0                <1>     xor ax, ax
    46 00002BA2 A0[0A06]            <1>     mov al, [current_selection]
    47 00002BA5 BB1700              <1>     mov bx, MENU_BUTTON_HEIGHT
    48 00002BA8 83C30B              <1>     add bx, MENU_BUTTON_HEIGHT / 2
    49 00002BAB F7E3                <1>     mul bx
    50 00002BAD 83C058              <1>     add ax, ARROW_FIRST_Y
    51 00002BB0 89C2                <1>     mov dx, ax
    52                              <1> 
    53                              <1>     ; Draw space (or redraw background color)
    54 00002BB2 B96400              <1>     mov cx, ARROW_X_OFFSET
    55 00002BB5 8A1E[0300]          <1>     mov bl, [char_color]     ; Background color
    56 00002BB9 E833D7              <1>     call drawSelectionArrow  ; Draws space in bg color
    57                              <1> 
    58 00002BBC 5A                  <1>     pop dx
    59 00002BBD 59                  <1>     pop cx
    60 00002BBE 5B                  <1>     pop bx
    61 00002BBF 58                  <1>     pop ax
    62 00002BC0 C3                  <1>     ret
    63                              <1> handleMainMenuInput:
    64 00002BC1 53                  <1>     push bx
    65 00002BC2 51                  <1>     push cx
    66 00002BC3 52                  <1>     push dx
    67                              <1> 
    68 00002BC4 C606[0A06]00        <1>     mov byte [current_selection], MENU_OPTION_PLAY
    69                              <1> 
    70                              <1> .input_loop:
    71 00002BC9 E8ABFF              <1>     call drawMenuArrow
    72                              <1> 
    73 00002BCC B400                <1>     mov ah, 0x00
    74 00002BCE CD16                <1>     int 0x16            ; wait key
    75                              <1> 
    76 00002BD0 80FC48              <1>     cmp ah, KEY_UP
    77 00002BD3 7411                <1>     je .move_up
    78 00002BD5 80FC50              <1>     cmp ah, KEY_DOWN
    79 00002BD8 7423                <1>     je .move_down
    80 00002BDA 80FC1C              <1>     cmp ah, KEY_ENTER
    81 00002BDD 7435                <1>     je .select_option
    82 00002BDF 80FC01              <1>     cmp ah, KEY_ESC
    83 00002BE2 743A                <1>     je .exit_pressed
    84 00002BE4 EBE3                <1>     jmp .input_loop
    85                              <1> 
    86                              <1> .move_up:
    87 00002BE6 E8B3FF              <1>     call clearMenuArrow
    88 00002BE9 A0[0A06]            <1>     mov al, [current_selection]
    89 00002BEC 3C00                <1>     cmp al, 0
    90 00002BEE 7406                <1>     je .wrap_bottom
    91 00002BF0 FE0E[0A06]          <1>     dec byte [current_selection]
    92 00002BF4 EBD3                <1>     jmp .input_loop
    93                              <1> 
    94                              <1> .wrap_bottom:
    95 00002BF6 C606[0A06]02        <1>     mov byte [current_selection], TOTAL_MENU_OPTIONS - 1
    96 00002BFB EBCC                <1>     jmp .input_loop
    97                              <1> 
    98                              <1> .move_down:
    99 00002BFD E89CFF              <1>     call clearMenuArrow
   100 00002C00 A0[0A06]            <1>     mov al, [current_selection]
   101 00002C03 3C02                <1>     cmp al, TOTAL_MENU_OPTIONS - 1
   102 00002C05 7406                <1>     je .wrap_top
   103 00002C07 FE06[0A06]          <1>     inc byte [current_selection]
   104 00002C0B EBBC                <1>     jmp .input_loop
   105                              <1> 
   106                              <1> .wrap_top:
   107 00002C0D C606[0A06]00        <1>     mov byte [current_selection], 0
   108 00002C12 EBB5                <1>     jmp .input_loop
   109                              <1> 
   110                              <1> .select_option:
   111 00002C14 E885FF              <1>     call clearMenuArrow
   112 00002C17 A0[0A06]            <1>     mov al, [current_selection]
   113 00002C1A 5A                  <1>     pop dx
   114 00002C1B 59                  <1>     pop cx
   115 00002C1C 5B                  <1>     pop bx
   116 00002C1D C3                  <1>     ret
   117                              <1> 
   118                              <1> .exit_pressed:
   119 00002C1E B0FF                <1>     mov al, 0xFF
   120 00002C20 5A                  <1>     pop dx
   121 00002C21 59                  <1>     pop cx
   122 00002C22 5B                  <1>     pop bx
   123 00002C23 C3                  <1>     ret
