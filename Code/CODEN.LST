     4                              <1> ; PUBLIC: showPauseScreen
     5                              <1> ; Draws pause overlay and handles input
     6                              <1> showPauseScreen:
     7 00002FE3 50                  <1>     push ax
     8 00002FE4 53                  <1>     push bx
     9 00002FE5 51                  <1>     push cx
    10 00002FE6 52                  <1>     push dx
    11 00002FE7 56                  <1>     push si
    12 00002FE8 57                  <1>     push di
    13 00002FE9 1E                  <1>     push ds
    14                              <1> 
    15                              <1>     ; DS = CS for data access
    16 00002FEA 0E                  <1>     push cs
    17 00002FEB 1F                  <1>     pop ds
    18                              <1> 
    19 00002FEC C706[AD05]0000      <1>     mov word [DIST], 0
    20                              <1> 
    21                              <1> .pause_input_loop:
    22                              <1>     ; Draw complete pause screen
    23 00002FF2 E86900              <1>     call drawPausePanel
    24 00002FF5 E88600              <1>     call drawPauseTitle
    25 00002FF8 E8A200              <1>     call drawPauseMenu
    26                              <1> 
    27                              <1>     ; Clear keyboard buffer
    28                              <1> .clear_buffer:
    29 00002FFB B401                <1>     mov ah, 0x01
    30 00002FFD CD16                <1>     int 0x16
    31 00002FFF 7406                <1>     jz .buffer_clear
    32 00003001 B400                <1>     mov ah, 0x00
    33 00003003 CD16                <1>     int 0x16
    34 00003005 EBF4                <1>     jmp .clear_buffer
    35                              <1> .buffer_clear:
    36                              <1> 
    37                              <1>     ; Wait for key
    38 00003007 B400                <1>     mov ah, 0x00
    39 00003009 CD16                <1>     int 0x16              ; AL = ASCII, AH = scan
    40                              <1> 
    41                              <1>     ; Check ASCII codes
    42 0000300B 3C1B                <1>     cmp al, 27            ; ESC
    43 0000300D 7412                <1>     je .action_resume
    44 0000300F 3C72                <1>     cmp al, 'r'            
    45 00003011 741C                <1>     je .action_retry
    46 00003013 3C52                <1>     cmp al, 'R'            
    47 00003015 7418                <1>     je .action_retry
    48 00003017 3C71                <1>     cmp al, 'q'            
    49 00003019 7430                <1>     je .action_mainmenu
    50 0000301B 3C51                <1>     cmp al, 'Q'
    51 0000301D 742C                <1>     je .action_mainmenu
    52                              <1> 
    53 0000301F EBD1                <1>     jmp .pause_input_loop
    54                              <1> 
    55                              <1> .action_resume:
    56 00003021 E8C9D6              <1>     call resumeTimer
    57 00003024 C606[0B06]01        <1>     mov byte [game_state], STATE_GAME
    58 00003029 E896D7              <1>     call showBackground320x200
    59 0000302C E9C518              <1>     jmp game_loop
    60                              <1> 
    61                              <1> .action_retry:
    62 0000302F E898D6              <1>     call resetTimer
    63 00003032 C606[1806]01        <1>     mov byte [timer_active], 1
    64 00003037 C706[F605]0000      <1>     mov word [current_score], 0
    65 0000303D E8DF14              <1>     call initBalloonSystem
    66 00003040 C606[0B06]01        <1>     mov byte [game_state], STATE_GAME
    67 00003045 E87AD7              <1>     call showBackground320x200
    68 00003048 E9A918              <1>     jmp game_loop
    69                              <1> 
    70                              <1> .action_mainmenu:
    71 0000304B E80BD6              <1>     call restoreTimerISR
    72 0000304E C606[1806]00        <1>     mov byte [timer_active], 0
    73 00003053 C606[0B06]00        <1>     mov byte [game_state], STATE_MENU   
    74 00003058 E867D7              <1>     call showBackground320x200
    75 0000305B E99618              <1>     jmp game_loop
    76                              <1> 
