   322                              <1> ; ------------------------------------------------------------
   323                              <1> ; saveBalloonBackground
   324                              <1> ; INPUT: SI = pointer to balloon structure
   325                              <1> ; Saves 16x14 pixel area to buffer
   326                              <1> ; ------------------------------------------------------------
   327                              <1> saveBalloonBackground:
   328 000039B6 50                  <1>     push ax
   329 000039B7 53                  <1>     push bx
   330 000039B8 51                  <1>     push cx
   331 000039B9 52                  <1>     push dx
   332 000039BA 57                  <1>     push di
   333 000039BB 56                  <1>     push si
   334 000039BC 06                  <1>     push es
   335 000039BD 1E                  <1>     push ds
   336                              <1> 
   337                              <1>     ; Get balloon position
   338 000039BE 8B04                <1>     mov ax, [si+0]              ; X
   339 000039C0 8B5C02              <1>     mov bx, [si+2]              ; Y
   340 000039C3 8B7C08              <1>     mov di, [si+8]              ; Buffer offset
   341                              <1> 
   342                              <1>     ; Check bounds
   343 000039C6 83FB00              <1>     cmp bx, 0
   344 000039C9 7C4F                <1>     jl .done_save
   345 000039CB 81FBC800            <1>     cmp bx, 200
   346 000039CF 7D49                <1>     jge .done_save
   347                              <1> 
   348                              <1>     ; Setup segments
   349 000039D1 BA00A0              <1>     mov dx, 0xA000
   350 000039D4 8EDA                <1>     mov ds, dx                  ; DS = VGA segment
   351 000039D6 0E                  <1>     push cs
   352 000039D7 07                  <1>     pop es                      ; ES = our data segment
   353 000039D8 81C7[9B32]          <1>     add di, background_buffer   ; DI = buffer address
   354                              <1> 
   355                              <1>     ; Save 14 rows
   356 000039DC B91500              <1>     mov cx, BALLOON_HEIGHT
   357                              <1> 
   358                              <1> .save_row:
   359 000039DF 51                  <1>     push cx
   360 000039E0 50                  <1>     push ax
   361 000039E1 53                  <1>     push bx
   362                              <1> 
   363                              <1>     ; Check if row is visible
   364 000039E2 83FB00              <1>     cmp bx, 0
   365 000039E5 7C22                <1>     jl .skip_row
   366 000039E7 81FBC800            <1>     cmp bx, 200
   367 000039EB 7D1C                <1>     jge .skip_row
   368                              <1> 
   369                              <1>     ; Calculate VGA offset: Y * 320 + X
   370 000039ED 50                  <1>     push ax
   371 000039EE 89D8                <1>     mov ax, bx
   372 000039F0 BA4001              <1>     mov dx, 320
   373 000039F3 F7E2                <1>     mul dx
   374 000039F5 5A                  <1>     pop dx
   375 000039F6 01D0                <1>     add ax, dx                  ; AX = VGA offset
   376 000039F8 89C6                <1>     mov si, ax
   377                              <1> 
   378                              <1>     ; Copy 16 pixels
   379 000039FA B91800              <1>     mov cx, BALLOON_WIDTH
   380                              <1> .copy_pixel:
   381 000039FD 3E8A04              <1>     mov al, [ds:si]
   382 00003A00 268805              <1>     mov [es:di], al
   383 00003A03 46                  <1>     inc si
   384 00003A04 47                  <1>     inc di
   385 00003A05 E2F6                <1>     loop .copy_pixel
   386 00003A07 EB0B                <1>     jmp .next_row
   387                              <1> 
   388                              <1> .skip_row:
   389                              <1>     ; Fill with zeros if off-screen
   390 00003A09 B91800              <1>     mov cx, BALLOON_WIDTH
   391 00003A0C 30C0                <1>     xor al, al
   392                              <1> .fill_zero:
   393 00003A0E 268805              <1>     mov [es:di], al
   394 00003A11 47                  <1>     inc di
   395 00003A12 E2FA                <1>     loop .fill_zero
   396                              <1> 
   397                              <1> .next_row:
   398 00003A14 5B                  <1>     pop bx
   399 00003A15 58                  <1>     pop ax
   400 00003A16 43                  <1>     inc bx                      ; Next Y
   401 00003A17 59                  <1>     pop cx
   402 00003A18 E2C5                <1>     loop .save_row
   403                              <1> 
   404                              <1> .done_save:
   405 00003A1A 1F                  <1>     pop ds
   406 00003A1B 07                  <1>     pop es
   407 00003A1C 5E                  <1>     pop si
   408 00003A1D 5F                  <1>     pop di
   409 00003A1E 5A                  <1>     pop dx
   410 00003A1F 59                  <1>     pop cx
   411 00003A20 5B                  <1>     pop bx
   412 00003A21 58                  <1>     pop ax
   413 00003A22 C3                  <1>     ret
   414                              <1> 
   415                              <1> 
   416                              <1> ; ------------------------------------------------------------
   417                              <1> ; restoreBalloonBackground
   418                              <1> ; INPUT: SI = pointer to balloon structure
   419                              <1> ; Restores 16x14 pixel area from buffer
   420                              <1> ; ------------------------------------------------------------
   421                              <1> restoreBalloonBackground:
   422 00003A23 50                  <1>     push ax
   423 00003A24 53                  <1>     push bx
   424 00003A25 51                  <1>     push cx
   425 00003A26 52                  <1>     push dx
   426 00003A27 57                  <1>     push di
   427 00003A28 56                  <1>     push si
   428 00003A29 06                  <1>     push es
   429 00003A2A 1E                  <1>     push ds
   430                              <1> 
   431                              <1>     ; Get balloon position
   432 00003A2B 8B04                <1>     mov ax, [si+0]              ; X
   433 00003A2D 8B5C02              <1>     mov bx, [si+2]              ; Y
   434 00003A30 8B7408              <1>     mov si, [si+8]              ; Buffer offset
   435                              <1> 
   436                              <1>     ; Check bounds
   437 00003A33 83FB00              <1>     cmp bx, 0
   438 00003A36 7C47                <1>     jl .done_restore
   439 00003A38 81FBC800            <1>     cmp bx, 200
   440 00003A3C 7D41                <1>     jge .done_restore
   441                              <1> 
   442                              <1>     ; Setup segments
   443 00003A3E 0E                  <1>     push cs
   444 00003A3F 1F                  <1>     pop ds                      ; DS = our data segment
   445 00003A40 81C6[9B32]          <1>     add si, background_buffer   ; SI = buffer address
   446 00003A44 BA00A0              <1>     mov dx, 0xA000
   447 00003A47 8EC2                <1>     mov es, dx                  ; ES = VGA segment
   448                              <1> 
   449                              <1>     ; Restore 14 rows
   450 00003A49 B91500              <1>     mov cx, BALLOON_HEIGHT
   451                              <1> 
   452                              <1> .restore_row:
   453 00003A4C 51                  <1>     push cx
   454 00003A4D 50                  <1>     push ax
   455 00003A4E 53                  <1>     push bx
   456                              <1> 
   457                              <1>     ; Check if row is visible
   458 00003A4F 83FB00              <1>     cmp bx, 0
   459 00003A52 7C22                <1>     jl .skip_restore_row
   460 00003A54 81FBC800            <1>     cmp bx, 200
   461 00003A58 7D1C                <1>     jge .skip_restore_row
   462                              <1> 
   463                              <1>     ; Calculate VGA offset
   464 00003A5A 50                  <1>     push ax
   465 00003A5B 89D8                <1>     mov ax, bx
   466 00003A5D BA4001              <1>     mov dx, 320
   467 00003A60 F7E2                <1>     mul dx
   468 00003A62 5A                  <1>     pop dx
   469 00003A63 01D0                <1>     add ax, dx
   470 00003A65 89C7                <1>     mov di, ax
   471                              <1> 
   472                              <1>     ; Copy 16 pixels
   473 00003A67 B91800              <1>     mov cx, BALLOON_WIDTH
   474                              <1> .restore_pixel:
   475 00003A6A 3E8A04              <1>     mov al, [ds:si]
   476 00003A6D 268805              <1>     mov [es:di], al
   477 00003A70 46                  <1>     inc si
   478 00003A71 47                  <1>     inc di
   479 00003A72 E2F6                <1>     loop .restore_pixel
   480 00003A74 EB03                <1>     jmp .next_restore_row
   481                              <1> 
   482                              <1> .skip_restore_row:
   483 00003A76 83C618              <1>     add si, BALLOON_WIDTH       ; Skip buffer row
   484                              <1> 
   485                              <1> .next_restore_row:
   486 00003A79 5B                  <1>     pop bx
   487 00003A7A 58                  <1>     pop ax
   488 00003A7B 43                  <1>     inc bx
   489 00003A7C 59                  <1>     pop cx
   490 00003A7D E2CD                <1>     loop .restore_row
   491                              <1> 
   492                              <1> .done_restore:
   493 00003A7F 1F                  <1>     pop ds
   494 00003A80 07                  <1>     pop es
   495 00003A81 5E                  <1>     pop si
   496 00003A82 5F                  <1>     pop di
   497 00003A83 5A                  <1>     pop dx
   498 00003A84 59                  <1>     pop cx
   499 00003A85 5B                  <1>     pop bx
   500 00003A86 58                  <1>     pop ax
   501 00003A87 C3                  <1>     ret
   502                              <1> 
