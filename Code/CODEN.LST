   164                              <1> %define SCORE_PANEL_HEIGHT  BOX_HEIGHT
   165                              <1> %define SCORE_PANEL_COLOR   [light_orange]
   166                              <1> %define SCORE_BORDER_COLOR  [dark_orange]
