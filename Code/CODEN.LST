   445                              <1> .space:
   446                              <1>     ; Move cursor: advance by (9 * scale) pixels (9 width for 9x16)
   447 00000205 A0[8A05]            <1>     mov al, [dt_scale]
   448 00000208 30E4                <1>     xor ah, ah
   449 0000020A B109                <1>     mov cl, 9
   450 0000020C F6E1                <1>     mul cl
   451 0000020E 0106[8505]          <1>     add [dt_x_pos], ax
   452 00000212 8B0E[8505]          <1>     mov cx, [dt_x_pos]
   453 00000216 8B16[8705]          <1>     mov dx, [dt_y_pos]
