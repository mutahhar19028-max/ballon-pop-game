   249 00003973 8306[E405]0A        <1>     add word [current_score], 10
   250                              <1> 
   251 00003978 B001                <1>     mov al, 1
   252                              <1> 
   253                              <1> .done:
   254 0000397A 5E                  <1>     pop si
   255 0000397B 59                  <1>     pop cx
   256 0000397C 5B                  <1>     pop bx
   257 0000397D C3                  <1>     ret
