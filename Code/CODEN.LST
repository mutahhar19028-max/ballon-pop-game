   175                              <1> ; ------------------------------------------------------------
   176                              <1> ; drawTimerValue
   177                              <1> ; Draws the current timer value in MM:SS format
   178                              <1> ; Called every frame by drawTimerPanel
   179                              <1> ; Reads current values from timer_minutes and timer_display_sec
   180                              <1> ; These variables are updated by the timer ISR (once per second)
   181                              <1> ; ------------------------------------------------------------
   182                              <1> drawTimerValue:
   183 00002EE0 50                  <1>     push ax
   184 00002EE1 53                  <1>     push bx
   185 00002EE2 51                  <1>     push cx
   186 00002EE3 52                  <1>     push dx
   187 00002EE4 56                  <1>     push si
   188 00002EE5 57                  <1>     push di
   189 00002EE6 55                  <1>     push bp
   190                              <1> 
   191                              <1>     ; Allocate 6 bytes on stack for timer string "MM:SS\0"
   192 00002EE7 83EC06              <1>     sub sp, 6
   193 00002EEA 89E5                <1>     mov bp, sp              ; BP points to buffer
   194                              <1> 
   195                              <1>     ; Build "MM:SS" string from current timer values
   196                              <1>     ; --- Minutes tens digit ---
   197 00002EEC 30E4                <1>     xor ah, ah
   198 00002EEE A0[1106]            <1>     mov al, [timer_minutes]
   199 00002EF1 B30A                <1>     mov bl, 10
   200 00002EF3 F6F3                <1>     div bl                  ; AL = tens, AH = ones
   201 00002EF5 0430                <1>     add al, '0'             ; Convert to ASCII
   202 00002EF7 884600              <1>     mov [bp], al            ; Store tens digit
   203                              <1>     
   204                              <1>     ; --- Minutes ones digit ---
   205 00002EFA 88E0                <1>     mov al, ah              ; Get ones from AH
   206 00002EFC 0430                <1>     add al, '0'
   207 00002EFE 884601              <1>     mov [bp+1], al
   208                              <1> 
   209                              <1>     ; --- Colon separator ---
   210 00002F01 C646023A            <1>     mov byte [bp+2], ':'
   211                              <1> 
   212                              <1>     ; --- Seconds tens digit ---
   213 00002F05 30E4                <1>     xor ah, ah
   214 00002F07 A0[1206]            <1>     mov al, [timer_display_sec]
   215 00002F0A B30A                <1>     mov bl, 10
   216 00002F0C F6F3                <1>     div bl                  ; AL = tens, AH = ones
   217 00002F0E 0430                <1>     add al, '0'
   218 00002F10 884603              <1>     mov [bp+3], al
   219                              <1> 
   220                              <1>     ; --- Seconds ones digit ---
   221 00002F13 88E0                <1>     mov al, ah
   222 00002F15 0430                <1>     add al, '0'
   223 00002F17 884604              <1>     mov [bp+4], al
   224                              <1> 
   225                              <1>     ; --- Null terminator ---
   226 00002F1A C6460500            <1>     mov byte [bp+5], 0
   227                              <1> 
   228                              <1>     ; Draw the timer string at defined position
   229 00002F1E B90301              <1>     mov cx, TIMER_VALUE_X
   230 00002F21 BA0A00              <1>     mov dx, TIMER_VALUE_Y
   231 00002F24 89EE                <1>     mov si, bp              ; SI points to our string buffer
   232 00002F26 8A1E[1100]          <1>     mov bl, [dark_brown]    ; Text color
   233 00002F2A B701                <1>     mov bh, 1              ; Scale (2 = medium size)
   234 00002F2C E8B1D2              <1>     call drawText
   235                              <1> 
   236                              <1>     ; Clean up stack
   237 00002F2F 83C406              <1>     add sp, 6
   238                              <1> 
   239 00002F32 5D                  <1>     pop bp
   240 00002F33 5F                  <1>     pop di
   241 00002F34 5E                  <1>     pop si
   242 00002F35 5A                  <1>     pop dx
   243 00002F36 59                  <1>     pop cx
   244 00002F37 5B                  <1>     pop bx
   245 00002F38 58                  <1>     pop ax
   246 00002F39 C3                  <1>     ret
   247                              <1> 
   248                              <1> ; ------------------------------------------------------------
