   593                              <1>     ; offset = y*320 + x
   594 000002D2 89D0                <1>     mov ax, dx
   595 000002D4 BB4001              <1>     mov bx, 320
   596 000002D7 F7E3                <1>     mul bx
   597 000002D9 01C8                <1>     add ax, cx
   598 000002DB 89C7                <1>     mov di, ax
   599                              <1> 
   600 000002DD B800A0              <1>     mov ax, 0xA000
   601 000002E0 8EC0                <1>     mov es, ax
   602 000002E2 A0[7705]            <1>     mov al, [dt_color]
   603 000002E5 268805              <1>     mov [es:di], al
   604                              <1> 
   605                              <1> .done_put:
   606 000002E8 07                  <1>     pop es
   607 000002E9 5F                  <1>     pop di
   608 000002EA 5A                  <1>     pop dx
   609 000002EB 59                  <1>     pop cx
   610 000002EC 5B                  <1>     pop bx
   611 000002ED 58                  <1>     pop ax
   612 000002EE C3                  <1>     ret
