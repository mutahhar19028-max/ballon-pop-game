   200 0000393C E2D0                <1>     loop .render_loop
   201                              <1> 
   202 0000393E 5F                  <1>     pop di
   203 0000393F 5E                  <1>     pop si
   204 00003940 5A                  <1>     pop dx
   205 00003941 59                  <1>     pop cx
   206 00003942 5B                  <1>     pop bx
   207 00003943 58                  <1>     pop ax
   208 00003944 C3                  <1>     ret
   209                              <1> 
