    19                                  %include "Code\balloon_system.asm" 
     1                              <1> ; ============================================================================
     2                              <1> ; balloon_system.asm — Balloon System with Background Buffer
     3                              <1> ; ============================================================================
     4                              <1> ; Uses background buffering to avoid redrawing entire screen
     5                              <1> ; Saves pixels before drawing, restores them before moving
     6                              <1> ; ============================================================================
     7                              <1> 
     8                              <1> ; ------------------------------------------------------------
     9                              <1> ; BALLOON CONSTANTS
    10                              <1> ; ------------------------------------------------------------
    11                              <1> %define MAX_BALLOONS        9
    12                              <1> %define BALLOON_WIDTH       24              ; Pixels wide
    13                              <1> %define BALLOON_HEIGHT      21              ; Pixels tall
    14                              <1> %define BALLOON_STRING_LEN  2
    15                              <1> 
    16                              <1> %define SPAWN_Y             186             ; 200 - 14 = 186 (bottom)
    17                              <1> %define DESPAWN_Y           40
    18                              <1> %define MIN_SPAWN_X         30
    19                              <1> %define MAX_SPAWN_X         286             ; 320 - 16 = 304
    20                              <1> 
    21                              <1> %define BALLOON_SPEED       1
    22                              <1> %define MOVEMENT_DELAY      3               ; Move every 3 frames (slower!)
    23                              <1> %define SPAWN_DELAY         100
    24                              <1> 
    25                              <1> ; Buffer size per balloon: 16 * 14 = 224 bytes
    26                              <1> %define BUFFER_SIZE         504
    27                              <1> 
    28                              <1> ; Balloon colors (8 vibrant colors from your palette)
    29                              <1> balloon_colors:
    30 00003262 1A1C1F3F48472F37    <1>     db 26, 28, 31, 63, 72, 71, 47, 55
    31                              <1> 
    32                              <1> ; ------------------------------------------------------------
    33                              <1> ; BALLOON DATA STRUCTURE (16 bytes per balloon)
    34                              <1> ; ------------------------------------------------------------
    35                              <1> ; Offset | Size | Description
    36                              <1> ; -------+------+---------------------------
    37                              <1> ; +0     | 2    | x_position (word)
    38                              <1> ; +2     | 2    | y_position (word)
    39                              <1> ; +4     | 1    | letter (byte, ASCII 'A'-'Z')
    40                              <1> ; +5     | 1    | color_index (byte, 0-7)
    41                              <1> ; +6     | 1    | active_flag (byte, 0=inactive, 1=active)
    42                              <1> ; +7     | 1    | speed (byte, pixels/frame)
    43                              <1> ; +8     | 2    | buffer_offset (word, pointer to background buffer)
    44                              <1> ; +10-15 | 6    | Reserved
    45                              <1> ; ------------------------------------------------------------
    46                              <1> 
    47 0000326A 00<rep 90h>         <1> balloon_array:      times (MAX_BALLOONS * 16) db 0
    48 000032FA 00                  <1> balloon_count:      db 0
    49 000032FB 0000                <1> spawn_timer:        dw 0
    50 000032FD 0000                <1> random_seed:        dw 0
    51 000032FF 00                  <1> movement_counter:   db 0        ; NEW: Frame counter for slower movement
    52                              <1> 
    53                              <1> ; Background buffer: 10 balloons × 224 bytes = 2240 bytes
    54 00003300 00<rep 11B8h>       <1> background_buffer:  times (MAX_BALLOONS * BUFFER_SIZE) db 0
    55                              <1> 
    56                              <1> 
    57                              <1> ; ============================================================================
    58                              <1> ; PUBLIC API FUNCTIONS
    59                              <1> ; ============================================================================
    60                              <1> 
    61                              <1> ; ------------------------------------------------------------
    62                              <1> ; initBalloonSystem
    63                              <1> ; ------------------------------------------------------------
    64                              <1> initBalloonSystem:
    65 000044B8 50                  <1>     push ax
    66 000044B9 53                  <1>     push bx
    67 000044BA 51                  <1>     push cx
    68 000044BB 57                  <1>     push di
    69 000044BC 06                  <1>     push es
    70                              <1> 
    71                              <1>     ; Clear balloon array
    72 000044BD 8CD8                <1>     mov ax, ds
    73 000044BF 8EC0                <1>     mov es, ax
    74 000044C1 BF[6A32]            <1>     mov di, balloon_array
    75 000044C4 B99000              <1>     mov cx, (MAX_BALLOONS * 16)
    76 000044C7 30C0                <1>     xor al, al
    77 000044C9 F3AA                <1>     rep stosb
    78                              <1> 
    79                              <1>     ; Initialize buffer offsets for each balloon
    80 000044CB BE[6A32]            <1>     mov si, balloon_array
    81 000044CE B80000              <1>     mov ax, 0                   ; Buffer offset starts at 0
    82 000044D1 B90900              <1>     mov cx, MAX_BALLOONS
    83                              <1> 
    84                              <1> .init_buffers:
    85 000044D4 894408              <1>     mov [si+8], ax              ; Store buffer offset
    86 000044D7 05F801              <1>     add ax, BUFFER_SIZE         ; Next buffer
    87 000044DA 83C610              <1>     add si, 16                  ; Next balloon
    88 000044DD E2F5                <1>     loop .init_buffers
    89                              <1> 
    90                              <1>     ; Reset counters
    91 000044DF C606[FA32]00        <1>     mov byte [balloon_count], 0
    92 000044E4 C706[FB32]0000      <1>     mov word [spawn_timer], 0
    93 000044EA C606[FF32]00        <1>     mov byte [movement_counter], 0  ; Reset movement counter
    94                              <1> 
    95                              <1>     ; Seed random
    96 000044EF B400                <1>     mov ah, 0x00
    97 000044F1 CD1A                <1>     int 0x1A
    98 000044F3 8916[FD32]          <1>     mov [random_seed], dx
    99                              <1> 
   100 000044F7 07                  <1>     pop es
   101 000044F8 5F                  <1>     pop di
   102 000044F9 59                  <1>     pop cx
   103 000044FA 5B                  <1>     pop bx
   104 000044FB 58                  <1>     pop ax
   105 000044FC C3                  <1>     ret
