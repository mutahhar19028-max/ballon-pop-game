   571                              <1> ; ------------------------------------------------------------
   572                              <1> ; moveBalloons
   573                              <1> ; ------------------------------------------------------------
   574                              <1> moveBalloons:
   575 00003AE4 50                  <1>     push ax
   576 00003AE5 51                  <1>     push cx
   577 00003AE6 56                  <1>     push si
   578                              <1> 
   579 00003AE7 BE[6532]            <1>     mov si, balloon_array
   580 00003AEA B90300              <1>     mov cx, MAX_BALLOONS
   581                              <1> 
   582                              <1> .move_loop:
   583 00003AED 8A4406              <1>     mov al, [si+6]
   584 00003AF0 3C01                <1>     cmp al, 1
   585 00003AF2 7508                <1>     jne .next_move
   586                              <1> 
