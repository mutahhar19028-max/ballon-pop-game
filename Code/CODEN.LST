    45 0000003E 83EA04              <1>     sub dx, 4
    46 00000041 8B76F6              <1>     mov si, [bp-10]
    47 00000044 E85200              <1>     call drawFilledRect
    48                              <1> 
    49 00000047 8B46FE              <1>     mov ax, [bp-2]
