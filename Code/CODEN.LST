   687                              <1> .circle_outline_loop:
   688 0000034C 8B46F6              <1>     mov ax, [bp-10]
   689 0000034F 8B5EF4              <1>     mov bx, [bp-12]
   690                              <1> 
   691                              <1>     ; 1: (cx + x, cy + y)
   692 00000352 8B4EFE              <1>     mov cx, [bp-2]
   693 00000355 034EF6              <1>     add cx, [bp-10]
   694 00000358 8B56FC              <1>     mov dx, [bp-4]
   695 0000035B 0356F4              <1>     add dx, [bp-12]
