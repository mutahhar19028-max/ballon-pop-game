   221                              <1> 
   222                              <1> .check_loop:
   223 0000394E 8A5C06              <1>     mov bl, [si+6]
   224 00003951 80FB01              <1>     cmp bl, 1
   225 00003954 7507                <1>     jne .next_check
   226                              <1> 
   227 00003956 8A5C04              <1>     mov bl, [si+4]
   228 00003959 38D8                <1>     cmp al, bl
   229 0000395B 7409                <1>     je .hit_found
   230                              <1> 
   231                              <1> .next_check:
   232 0000395D 83C610              <1>     add si, 16
