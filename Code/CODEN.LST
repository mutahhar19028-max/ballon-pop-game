   867 000004A5 035EF6              <1>     add bx, [bp-10]
   868 000004A8 89D0                <1>     mov ax, dx
   869 000004AA 31F6                <1>     xor si, si
   870 000004AC 8B76F8              <1>     mov si, word [bp-8]
   871 000004AF 81E6FF00            <1>     and si, 0x00FF
   872 000004B3 E87CFC              <1>     call drawHorizontalLine
   873                              <1> 
   874 000004B6 8B46F2              <1>     mov ax, [bp-14]
   875 000004B9 83F800              <1>     cmp ax, 0
   876 000004BC 7C1C                <1>     jl .f_d_less_zero
   877                              <1>     
   878 000004BE 8B46F2              <1>     mov ax, [bp-14]
   879 000004C1 8B56F6              <1>     mov dx, [bp-10]
   880 000004C4 D1E2                <1>     shl dx, 1
   881 000004C6 8B76F4              <1>     mov si, [bp-12]
   882 000004C9 D1E6                <1>     shl si, 1
   883 000004CB 29F2                <1>     sub dx, si
   884 000004CD 01D0                <1>     add ax, dx
   885 000004CF 83C005              <1>     add ax, 5
   886 000004D2 8946F2              <1>     mov [bp-14], ax
   887 000004D5 FF4EF4              <1>     dec word [bp-12]
   888 000004D8 EB10                <1>     jmp .f_d_done
   889                              <1> 
   890                              <1> .f_d_less_zero:
   891 000004DA 8B46F2              <1>     mov ax, [bp-14]
   892 000004DD 8B56F6              <1>     mov dx, [bp-10]
   893 000004E0 D1E2                <1>     shl dx, 1
   894 000004E2 01D0                <1>     add ax, dx
   895 000004E4 83C003              <1>     add ax, 3
   896 000004E7 8946F2              <1>     mov [bp-14], ax
   897                              <1> 
   898                              <1> .f_d_done:
   899 000004EA FF46F6              <1>     inc word [bp-10]
   900 000004ED 8B46F6              <1>     mov ax, [bp-10]
   901 000004F0 3B46F4              <1>     cmp ax, [bp-12]
   902 000004F3 0F8E4BFF            <1>     jle .fill_loop
   903                              <1> 
   904 000004F7 83C410              <1>     add sp, 16
   905 000004FA 5D                  <1>     pop bp
