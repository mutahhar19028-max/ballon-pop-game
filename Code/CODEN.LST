     1                              <1> ; ============================================================
     2                              <1> ; navigation.asm — Menu Navigation System with Arrow Keys
     3                              <1> ; ============================================================
     4                              <1> ; ------------------------------------------------------------
     5                              <1> ; drawMenuArrow
     6                              <1> ; Draws '>' arrow at current selection position
     7                              <1> ; ------------------------------------------------------------
     8                              <1> drawMenuArrow:
     9 00002B69 50                  <1>     push ax
    10 00002B6A 53                  <1>     push bx
    11 00002B6B 51                  <1>     push cx
    12 00002B6C 52                  <1>     push dx
    13                              <1> 
    14                              <1>     ; Calculate Y position based on selection
    15 00002B6D 31C0                <1>     xor ax, ax
    16 00002B6F A0[FD05]            <1>     mov al, [current_selection]
    17 00002B72 BB1700              <1>     mov bx, MENU_BUTTON_HEIGHT
    18 00002B75 83C30B              <1>     add bx, MENU_BUTTON_HEIGHT / 2  ; Spacing between buttons
    19 00002B78 F7E3                <1>     mul bx
    20 00002B7A 83C058              <1>     add ax, ARROW_FIRST_Y
    21 00002B7D 89C2                <1>     mov dx, ax
    22                              <1> 
    23                              <1>     ; Draw arrow
    24 00002B7F B96400              <1>     mov cx, ARROW_X_OFFSET
    25 00002B82 8A1E[1100]          <1>     mov bl, [dark_brown]     ; Arrow color
    26 00002B86 E866D7              <1>     call drawSelectionArrow
    27                              <1> 
    28 00002B89 5A                  <1>     pop dx
    29 00002B8A 59                  <1>     pop cx
    30 00002B8B 5B                  <1>     pop bx
    31 00002B8C 58                  <1>     pop ax
    32 00002B8D C3                  <1>     ret
    33                              <1> 
    34                              <1> ; ------------------------------------------------------------
    35                              <1> ; clearMenuArrow
    36                              <1> ; Erases arrow at current selection (draws space in bg color)
    37                              <1> ; ------------------------------------------------------------
    38                              <1> clearMenuArrow:
    39 00002B8E 50                  <1>     push ax
    40 00002B8F 53                  <1>     push bx
    41 00002B90 51                  <1>     push cx
    42 00002B91 52                  <1>     push dx
    43                              <1> 
    44                              <1>     ; Calculate Y position
    45 00002B92 31C0                <1>     xor ax, ax
    46 00002B94 A0[FD05]            <1>     mov al, [current_selection]
    47 00002B97 BB1700              <1>     mov bx, MENU_BUTTON_HEIGHT
    48 00002B9A 83C30B              <1>     add bx, MENU_BUTTON_HEIGHT / 2
    49 00002B9D F7E3                <1>     mul bx
    50 00002B9F 83C058              <1>     add ax, ARROW_FIRST_Y
    51 00002BA2 89C2                <1>     mov dx, ax
    52                              <1> 
    53                              <1>     ; Draw space (or redraw background color)
    54 00002BA4 B96400              <1>     mov cx, ARROW_X_OFFSET
    55 00002BA7 8A1E[0300]          <1>     mov bl, [char_color]     ; Background color
    56 00002BAB E841D7              <1>     call drawSelectionArrow  ; Draws space in bg color
    57                              <1> 
    58 00002BAE 5A                  <1>     pop dx
    59 00002BAF 59                  <1>     pop cx
    60 00002BB0 5B                  <1>     pop bx
    61 00002BB1 58                  <1>     pop ax
    62 00002BB2 C3                  <1>     ret
    63                              <1> handleMainMenuInput:
    64 00002BB3 53                  <1>     push bx
    65 00002BB4 51                  <1>     push cx
    66 00002BB5 52                  <1>     push dx
    67                              <1> 
    68 00002BB6 C606[FD05]00        <1>     mov byte [current_selection], MENU_OPTION_PLAY
    69                              <1> 
    70                              <1> .input_loop:
    71 00002BBB E8ABFF              <1>     call drawMenuArrow
    72                              <1> 
    73 00002BBE B400                <1>     mov ah, 0x00
    74 00002BC0 CD16                <1>     int 0x16            ; wait key
    75                              <1> 
    76 00002BC2 80FC48              <1>     cmp ah, KEY_UP
    77 00002BC5 7411                <1>     je .move_up
    78 00002BC7 80FC50              <1>     cmp ah, KEY_DOWN
    79 00002BCA 7423                <1>     je .move_down
    80 00002BCC 80FC1C              <1>     cmp ah, KEY_ENTER
    81 00002BCF 7435                <1>     je .select_option
    82 00002BD1 80FC01              <1>     cmp ah, KEY_ESC
    83 00002BD4 743A                <1>     je .exit_pressed
    84 00002BD6 EBE3                <1>     jmp .input_loop
    85                              <1> 
    86                              <1> .move_up:
    87 00002BD8 E8B3FF              <1>     call clearMenuArrow
    88 00002BDB A0[FD05]            <1>     mov al, [current_selection]
    89 00002BDE 3C00                <1>     cmp al, 0
    90 00002BE0 7406                <1>     je .wrap_bottom
    91 00002BE2 FE0E[FD05]          <1>     dec byte [current_selection]
    92 00002BE6 EBD3                <1>     jmp .input_loop
    93                              <1> 
    94                              <1> .wrap_bottom:
    95 00002BE8 C606[FD05]02        <1>     mov byte [current_selection], TOTAL_MENU_OPTIONS - 1
    96 00002BED EBCC                <1>     jmp .input_loop
    97                              <1> 
    98                              <1> .move_down:
    99 00002BEF E89CFF              <1>     call clearMenuArrow
   100 00002BF2 A0[FD05]            <1>     mov al, [current_selection]
   101 00002BF5 3C02                <1>     cmp al, TOTAL_MENU_OPTIONS - 1
   102 00002BF7 7406                <1>     je .wrap_top
   103 00002BF9 FE06[FD05]          <1>     inc byte [current_selection]
   104 00002BFD EBBC                <1>     jmp .input_loop
   105                              <1> 
   106                              <1> .wrap_top:
   107 00002BFF C606[FD05]00        <1>     mov byte [current_selection], 0
   108 00002C04 EBB5                <1>     jmp .input_loop
   109                              <1> 
   110                              <1> .select_option:
   111 00002C06 E885FF              <1>     call clearMenuArrow
   112 00002C09 A0[FD05]            <1>     mov al, [current_selection]
   113 00002C0C 5A                  <1>     pop dx
   114 00002C0D 59                  <1>     pop cx
   115 00002C0E 5B                  <1>     pop bx
   116 00002C0F C3                  <1>     ret
   117                              <1> 
