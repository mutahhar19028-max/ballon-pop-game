   212                              <1> ; checkBalloonHit
   213                              <1> ; ------------------------------------------------------------
   214                              <1> checkBalloonHit:
   215 00003945 53                  <1>     push bx
   216 00003946 51                  <1>     push cx
   217 00003947 56                  <1>     push si
   218                              <1> 
   219 00003948 BE[6532]            <1>     mov si, balloon_array
