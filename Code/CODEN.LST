   449 0000020A B109                <1>     mov cl, 9
   450 0000020C F6E1                <1>     mul cl
   451 0000020E 0106[7305]          <1>     add [dt_x_pos], ax
   452 00000212 8B0E[7305]          <1>     mov cx, [dt_x_pos]
   453 00000216 8B16[7505]          <1>     mov dx, [dt_y_pos]
