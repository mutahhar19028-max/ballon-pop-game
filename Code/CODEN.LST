   175 0000454C 8B5C02              <1>     mov bx, [si+2]              ; Y position
   176 0000454F 8A5404              <1>     mov dl, [si+4]              ; Letter
   177 00004552 8A7405              <1>     mov dh, [si+5]              ; Color index
   178                              <1> 
   179                              <1>     ; Get actual color
   180 00004555 56                  <1>     push si
   181 00004556 51                  <1>     push cx
   182 00004557 30ED                <1>     xor ch, ch
   183 00004559 88F1                <1>     mov cl, dh
   184 0000455B 80E107              <1>     and cl, 0x07
   185 0000455E BE[6232]            <1>     mov si, balloon_colors
   186 00004561 01CE                <1>     add si, cx
   187 00004563 8A0C                <1>     mov cl, [si]
   188 00004565 59                  <1>     pop cx
   189 00004566 5E                  <1>     pop si
   190                              <1> 
   191                              <1>     ; Draw balloon
   192 00004567 56                  <1>     push si
   193 00004568 51                  <1>     push cx
   194 00004569 E81202              <1>     call drawBalloon
   195 0000456C 59                  <1>     pop cx
   196 0000456D 5E                  <1>     pop si
   197                              <1> 
   198                              <1> .next_balloon:
   199 0000456E 83C610              <1>     add si, 16
   200 00004571 E2D0                <1>     loop .render_loop
   201                              <1> 
   202 00004573 5F                  <1>     pop di
   203 00004574 5E                  <1>     pop si
   204 00004575 5A                  <1>     pop dx
   205 00004576 59                  <1>     pop cx
   206 00004577 5B                  <1>     pop bx
   207 00004578 58                  <1>     pop ax
   208 00004579 C3                  <1>     ret
   209                              <1> 
