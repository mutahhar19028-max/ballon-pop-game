    29 00000019 57                  <1>     push di
    30 0000001A 55                  <1>     push bp
    31                              <1> 
    32 0000001B 89E5                <1>     mov bp, sp
    33 0000001D 83EC0A              <1>     sub sp, 10
    34 00000020 8946FE              <1>     mov word [bp-2], ax
    35 00000023 895EFC              <1>     mov word [bp-4], bx
    36 00000026 894EFA              <1>     mov word [bp-6], cx
    37 00000029 8956F8              <1>     mov word [bp-8], dx
    38 0000002C 8976F6              <1>     mov word [bp-10], si
    39                              <1> 
    40 0000002F 8B46FE              <1>     mov ax, [bp-2]
