   383 000046A0 47                  <1>     inc di
   384 000046A1 E2F6                <1>     loop .copy_pixel
   385 000046A3 EB0B                <1>     jmp .next_row
   386                              <1> 
   387                              <1> .skip_row:
   388                              <1>     ; Fill with zeros if off-screen
   389 000046A5 B91800              <1>     mov cx, BALLOON_WIDTH
   390 000046A8 30C0                <1>     xor al, al
   391                              <1> .fill_zero:
   392 000046AA 268805              <1>     mov [es:di], al
   393 000046AD 47                  <1>     inc di
   394 000046AE E2FA                <1>     loop .fill_zero
   395                              <1> 
   396                              <1> .next_row:
   397 000046B0 5B                  <1>     pop bx
   398 000046B1 58                  <1>     pop ax
   399 000046B2 43                  <1>     inc bx                      ; Next Y
   400 000046B3 59                  <1>     pop cx
   401 000046B4 E2C5                <1>     loop .save_row
   402                              <1> 
   403                              <1> .done_save:
   404 000046B6 1F                  <1>     pop ds
   405 000046B7 07                  <1>     pop es
   406 000046B8 5E                  <1>     pop si
   407 000046B9 5F                  <1>     pop di
   408 000046BA 5A                  <1>     pop dx
   409 000046BB 59                  <1>     pop cx
   410 000046BC 5B                  <1>     pop bx
   411 000046BD 58                  <1>     pop ax
   412 000046BE C3                  <1>     ret
   413                              <1> 
