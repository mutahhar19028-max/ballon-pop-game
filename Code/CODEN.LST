    64                              <1> ; PUBLIC: drawScoreValue
    65                              <1> ; Draws the current score at defined position
    66                              <1> ; Called by drawScorePanel
    67                              <1> ; ------------------------------------------------------------
    68                              <1> drawScoreValue:
    69 00002E42 50                  <1>     push ax
    70 00002E43 53                  <1>     push bx
    71 00002E44 51                  <1>     push cx
    72 00002E45 52                  <1>     push dx
    73 00002E46 56                  <1>     push si
    74 00002E47 57                  <1>     push di
    75 00002E48 55                  <1>     push bp
    76                              <1> 
    77                              <1>     ; Allocate 5 bytes for "0000\0"
    78 00002E49 83EC05              <1>     sub sp, 5
    79 00002E4C 89E5                <1>     mov bp, sp          ; BP points to buffer
    80                              <1> 
    81 00002E4E A1[F605]            <1>     mov ax, [current_score]  ; AX = current score
    82                              <1> 
    83                              <1>     ; --- Thousands digit ---
    84 00002E51 B9E803              <1>     mov cx, 1000
    85 00002E54 31D2                <1>     xor dx, dx
    86 00002E56 F7F1                <1>     div cx                  ; AX / 1000 -> AX = quotient in AL, DX = remainder
    87 00002E58 0430                <1>     add al, '0'
    88 00002E5A 884600              <1>     mov [bp], al            ; store thousands digit
    89                              <1> 
    90                              <1>     ; --- Hundreds digit ---
    91 00002E5D 89D0                <1>     mov ax, dx               ; remainder from thousands division
    92 00002E5F B96400              <1>     mov cx, 100
    93 00002E62 31D2                <1>     xor dx, dx
    94 00002E64 F7F1                <1>     div cx                   ; AX / 100 -> AL = hundreds, DX = remainder
    95 00002E66 0430                <1>     add al, '0'
    96 00002E68 884601              <1>     mov [bp+1], al
    97                              <1> 
    98                              <1>     ; --- Tens digit ---
    99 00002E6B 89D0                <1>     mov ax, dx               ; remainder from hundreds
   100 00002E6D B90A00              <1>     mov cx, 10
   101 00002E70 31D2                <1>     xor dx, dx
   102 00002E72 F7F1                <1>     div cx                   ; AX / 10 -> AL = tens, DX = ones
   103 00002E74 0430                <1>     add al, '0'
   104 00002E76 884602              <1>     mov [bp+2], al
   105                              <1> 
   106                              <1>     ; --- Ones digit ---
   107 00002E79 88D0                <1>     mov al, dl               ; remainder from tens division
   108 00002E7B 0430                <1>     add al, '0'
   109 00002E7D 884603              <1>     mov [bp+3], al
   110                              <1> 
   111                              <1>     ; --- Null terminator ---
   112 00002E80 C6460400            <1>     mov byte [bp+4], 0
   113                              <1> 
   114                              <1>     ; Draw score string
   115 00002E84 B94100              <1>     mov cx, SCORE_VALUE_X - 14
   116 00002E87 BA0A00              <1>     mov dx, SCORE_VALUE_Y - 2
   117 00002E8A 89EE                <1>     mov si, bp
   118 00002E8C 8A1E[1100]          <1>     mov bl, [dark_brown]
   119 00002E90 B701                <1>     mov bh, 1
   120 00002E92 E84BD3              <1>     call drawText
   121                              <1> 
   122 00002E95 83C405              <1>     add sp, 5
   123 00002E98 5D                  <1>     pop bp
   124 00002E99 5F                  <1>     pop di
   125 00002E9A 5E                  <1>     pop si
   126 00002E9B 5A                  <1>     pop dx
   127 00002E9C 59                  <1>     pop cx
   128 00002E9D 5B                  <1>     pop bx
   129 00002E9E 58                  <1>     pop ax
   130 00002E9F C3                  <1>     ret
   131                              <1> 
