   576                              <1> ; putPixel (VGA 320x200)
   577                              <1> ; CX=x, DX=y, color in [dt_color]
   578                              <1> ; ======================================================================
   579                              <1> putPixel:
   580 000002C0 50                  <1>     push ax
   581 000002C1 53                  <1>     push bx
   582 000002C2 51                  <1>     push cx
   583 000002C3 52                  <1>     push dx
   584 000002C4 57                  <1>     push di
   585 000002C5 06                  <1>     push es
   586                              <1> 
   587                              <1>     ; bounds check (safe for 320x200)
   588 000002C6 81F94001            <1>     cmp cx, 320
   589 000002CA 731C                <1>     jae .done_put
   590 000002CC 81FAC800            <1>     cmp dx, 200
   591 000002D0 7316                <1>     jae .done_put
   592                              <1> 
   593                              <1>     ; offset = y*320 + x
   594 000002D2 89D0                <1>     mov ax, dx
   595 000002D4 BB4001              <1>     mov bx, 320
   596 000002D7 F7E3                <1>     mul bx
   597 000002D9 01C8                <1>     add ax, cx
   598 000002DB 89C7                <1>     mov di, ax
   599                              <1> 
   600 000002DD B800A0              <1>     mov ax, 0xA000
   601 000002E0 8EC0                <1>     mov es, ax
   602 000002E2 A0[8905]            <1>     mov al, [dt_color]
   603 000002E5 268805              <1>     mov [es:di], al
   604                              <1> 
   605                              <1> .done_put:
   606 000002E8 07                  <1>     pop es
   607 000002E9 5F                  <1>     pop di
   608 000002EA 5A                  <1>     pop dx
   609 000002EB 59                  <1>     pop cx
   610 000002EC 5B                  <1>     pop bx
   611 000002ED 58                  <1>     pop ax
   612 000002EE C3                  <1>     ret
