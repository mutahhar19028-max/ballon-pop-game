   296                              <1> ; ------------------------------------------------------------
   297                              <1> restoreAllBackgrounds:
   298 0000399A 50                  <1>     push ax
   299 0000399B 51                  <1>     push cx
   300 0000399C 56                  <1>     push si
   301                              <1> 
   302 0000399D BE[6532]            <1>     mov si, balloon_array
   303 000039A0 B90300              <1>     mov cx, MAX_BALLOONS
