   504                              <1> ; ============================================================================
   505                              <1> ; HELPER FUNCTIONS
   506                              <1> ; ============================================================================
   507                              <1> 
   508                              <1> ; ------------------------------------------------------------
   509                              <1> ; spawnBalloon
   510                              <1> ; ------------------------------------------------------------
   511                              <1> spawnBalloon:
   512 000046BD 50                  <1>     push ax
   513 000046BE 53                  <1>     push bx
   514 000046BF 51                  <1>     push cx
   515 000046C0 56                  <1>     push si
   516                              <1> 
   517 000046C1 A0[FA32]            <1>     mov al, [balloon_count]
   518 000046C4 3C09                <1>     cmp al, MAX_BALLOONS
   519 000046C6 734C                <1>     jae .no_spawn
   520                              <1> 
   521 000046C8 BE[6A32]            <1>     mov si, balloon_array
   522 000046CB B90900              <1>     mov cx, MAX_BALLOONS
   523                              <1> 
   524                              <1> .find_slot:
   525 000046CE 8A4406              <1>     mov al, [si+6]
   526 000046D1 3C00                <1>     cmp al, 0
   527 000046D3 7407                <1>     je .found_slot
   528 000046D5 83C610              <1>     add si, 16
   529 000046D8 E2F4                <1>     loop .find_slot
   530 000046DA EB38                <1>     jmp .no_spawn
   531                              <1> 
   532                              <1> .found_slot:
   533                              <1>     ; Random X
   534 000046DC E88900              <1>     call getRandomNumber
   535 000046DF BB0001              <1>     mov bx, 256
   536 000046E2 31D2                <1>     xor dx, dx
   537 000046E4 F7F3                <1>     div bx
   538 000046E6 83C21E              <1>     add dx, MIN_SPAWN_X
   539 000046E9 8914                <1>     mov [si+0], dx
   540                              <1> 
   541                              <1>     ; Y at bottom
   542 000046EB C74402BA00          <1>     mov word [si+2], SPAWN_Y
   543                              <1> 
   544                              <1>     ; Random letter
   545 000046F0 E87500              <1>     call getRandomNumber
   546 000046F3 BB1A00              <1>     mov bx, 26
   547 000046F6 31D2                <1>     xor dx, dx
   548 000046F8 F7F3                <1>     div bx
   549 000046FA 80C241              <1>     add dl, 'A'
   550 000046FD 885404              <1>     mov [si+4], dl
   551                              <1> 
   552                              <1>     ; Random color
   553 00004700 E86500              <1>     call getRandomNumber
   554 00004703 2407                <1>     and al, 0x07
   555 00004705 884405              <1>     mov [si+5], al
   556                              <1> 
   557                              <1>     ; Activate
   558 00004708 C6440601            <1>     mov byte [si+6], 1
   559 0000470C C6440701            <1>     mov byte [si+7], BALLOON_SPEED
   560                              <1> 
   561 00004710 FE06[FA32]          <1>     inc byte [balloon_count]
   562                              <1> 
   563                              <1> .no_spawn:
   564 00004714 5E                  <1>     pop si
   565 00004715 59                  <1>     pop cx
   566 00004716 5B                  <1>     pop bx
   567 00004717 58                  <1>     pop ax
   568 00004718 C3                  <1>     ret
   569                              <1> 
   570                              <1> 
   571                              <1> ; ------------------------------------------------------------
   572                              <1> ; moveBalloons
   573                              <1> ; ------------------------------------------------------------
   574                              <1> moveBalloons:
   575 00004719 50                  <1>     push ax
   576 0000471A 51                  <1>     push cx
   577 0000471B 56                  <1>     push si
   578                              <1> 
   579 0000471C BE[6A32]            <1>     mov si, balloon_array
   580 0000471F B90900              <1>     mov cx, MAX_BALLOONS
   581                              <1> 
   582                              <1> .move_loop:
   583 00004722 8A4406              <1>     mov al, [si+6]
   584 00004725 3C01                <1>     cmp al, 1
   585 00004727 7508                <1>     jne .next_move
   586                              <1> 
   587                              <1>     ; Move UP: Y -= speed
   588 00004729 8A4407              <1>     mov al, [si+7]
   589 0000472C 30E4                <1>     xor ah, ah
   590 0000472E 294402              <1>     sub [si+2], ax
