     1                              <1> ; ============================================================
     2                              <1> ; timer.asm — IRQ0-based Timer System (1 second updates)
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> ; ------------------------------------------------------------
     6                              <1> ; TIMER CONFIGURATION
     7                              <1> ; ------------------------------------------------------------
     8                              <1> %define PIT_CHANNEL0    0x40    ; PIT channel 0 data port
     9                              <1> %define PIT_COMMAND     0x43    ; PIT command port
    10                              <1> %define PIC_COMMAND     0x20    ; 8259 PIC command port
    11                              <1> %define PIC_DATA        0x21    ; 8259 PIC data port
    12                              <1> 
    13                              <1> %define TICKS_PER_SEC   18      ; Default: 18.2 Hz, we'll use 18 for simplicity
    14                              <1> %define GAME_TIME_SEC   120     ; 2 minutes = 120 seconds
    15                              <1> 
    16                              <1> ; ------------------------------------------------------------
    17                              <1> ; TIMER VARIABLES
    18                              <1> ; ------------------------------------------------------------
    19 000005FA 7800                <1> timer_seconds       dw GAME_TIME_SEC    ; Remaining seconds (120)
    20 000005FC 02                  <1> timer_minutes       db 2                ; Display minutes
    21 000005FD 00                  <1> timer_display_sec   db 0                ; Display seconds
    22 000005FE 00                  <1> timer_ticks         db 0                ; Tick counter (0-17)
    23 000005FF 00000000            <1> old_timer_vector    dd 0                ; Original IRQ0 handler address
    24 00000603 00                  <1> timer_active        db 0                ; Timer running flag
    25                              <1> 
    26                              <1> ; ------------------------------------------------------------
    27                              <1> ; installTimerISR
    28                              <1> ; Hooks IRQ0 (INT 08h) to custom timer handler
    29                              <1> ; Saves original vector for restoration
    30                              <1> ; ------------------------------------------------------------
    31                              <1> installTimerISR:
    32 00000604 50                  <1>     push ax
    33 00000605 53                  <1>     push bx
    34 00000606 51                  <1>     push cx
    35 00000607 52                  <1>     push dx
    36 00000608 06                  <1>     push es
    37                              <1> 
    38                              <1>     ; Save old INT 08h vector
    39 00000609 B80835              <1>     mov ax, 0x3508          ; AH=35h (Get interrupt vector), AL=08h
    40 0000060C CD21                <1>     int 0x21
    41 0000060E 891E[FF05]          <1>     mov word [old_timer_vector], bx
    42 00000612 8C06[0106]          <1>     mov word [old_timer_vector+2], es
    43                              <1> 
    44                              <1>     ; Install new handler
    45 00000616 1E                  <1>     push ds
    46 00000617 8CC8                <1>     mov ax, cs
    47 00000619 8ED8                <1>     mov ds, ax
    48 0000061B BA[5406]            <1>     mov dx, timerISR
    49 0000061E B80825              <1>     mov ax, 0x2508          ; AH=25h (Set interrupt vector), AL=08h
    50 00000621 CD21                <1>     int 0x21
    51 00000623 1F                  <1>     pop ds
    52                              <1> 
    53                              <1>     ; Initialize timer variables
    54 00000624 C706[FA05]7800      <1>     mov word [timer_seconds], GAME_TIME_SEC
    55 0000062A C606[FC05]02        <1>     mov byte [timer_minutes], 2
    56 0000062F C606[FD05]00        <1>     mov byte [timer_display_sec], 0
    57 00000634 C606[FE05]00        <1>     mov byte [timer_ticks], 0
    58 00000639 C606[0306]01        <1>     mov byte [timer_active], 1
    59                              <1> 
    60 0000063E 07                  <1>     pop es
    61 0000063F 5A                  <1>     pop dx
    62 00000640 59                  <1>     pop cx
    63 00000641 5B                  <1>     pop bx
    64 00000642 58                  <1>     pop ax
    65 00000643 C3                  <1>     ret
    66                              <1> 
    67                              <1> ; ------------------------------------------------------------
    68                              <1> ; restoreTimerISR
    69                              <1> ; Restores original IRQ0 handler
    70                              <1> ; Call before program exit!
    71                              <1> ; ------------------------------------------------------------
    72                              <1> restoreTimerISR:
    73 00000644 50                  <1>     push ax
    74 00000645 52                  <1>     push dx
    75 00000646 1E                  <1>     push ds
    76                              <1> 
    77                              <1>     ; Restore old INT 08h vector
    78 00000647 C516[FF05]          <1>     lds dx, [old_timer_vector]
    79 0000064B B80825              <1>     mov ax, 0x2508
    80 0000064E CD21                <1>     int 0x21
    81                              <1> 
    82 00000650 1F                  <1>     pop ds
    83 00000651 5A                  <1>     pop dx
    84 00000652 58                  <1>     pop ax
    85 00000653 C3                  <1>     ret
    86                              <1> 
    87                              <1> ; ------------------------------------------------------------
    88                              <1> ; timerISR
    89                              <1> ; Custom IRQ0 handler - called ~18.2 times per second
    90                              <1> ; Decrements timer every 18 ticks (approximately 1 second)
    91                              <1> ; ------------------------------------------------------------
    92                              <1> timerISR:
    93 00000654 50                  <1>     push ax
    94 00000655 53                  <1>     push bx
    95 00000656 51                  <1>     push cx
    96 00000657 52                  <1>     push dx
    97 00000658 56                  <1>     push si
    98 00000659 57                  <1>     push di
    99 0000065A 1E                  <1>     push ds
   100 0000065B 06                  <1>     push es
   101                              <1>     
   102                              <1>     ; Set DS to our data segment
   103 0000065C 8CC8                <1>     mov ax, cs
   104 0000065E 8ED8                <1>     mov ds, ax
   105                              <1> 
   106                              <1>     ; Check if timer is active
   107 00000660 803E[0306]01        <1>     cmp byte [timer_active], 1
   108 00000665 751E                <1>     jne .chain_to_old
   109                              <1> 
   110                              <1>     ; Increment tick counter
   111 00000667 FE06[FE05]          <1>     inc byte [timer_ticks]
   112 0000066B 803E[FE05]12        <1>     cmp byte [timer_ticks], TICKS_PER_SEC
   113 00000670 7213                <1>     jb .chain_to_old        ; Not 1 second yet
   114                              <1> 
   115                              <1>     ; Reset tick counter
   116 00000672 C606[FE05]00        <1>     mov byte [timer_ticks], 0
   117                              <1> 
   118                              <1>     ; Decrement seconds
   119 00000677 833E[FA05]00        <1>     cmp word [timer_seconds], 0
   120 0000067C 7414                <1>     je .timer_expired       ; Already at 0
   121                              <1> 
   122 0000067E FF0E[FA05]          <1>     dec word [timer_seconds]
   123                              <1> 
   124                              <1>     ; Update display format (MM:SS)
   125 00000682 E81400              <1>     call updateTimerDisplay
   126                              <1> 
   127                              <1> .chain_to_old:
   128                              <1>     ; Send EOI to PIC
   129 00000685 B020                <1>     mov al, 0x20
   130 00000687 E620                <1>     out PIC_COMMAND, al
   131                              <1> 
   132 00000689 07                  <1>     pop es
   133 0000068A 1F                  <1>     pop ds
   134 0000068B 5F                  <1>     pop di
   135 0000068C 5E                  <1>     pop si
   136 0000068D 5A                  <1>     pop dx
   137 0000068E 59                  <1>     pop cx
   138 0000068F 5B                  <1>     pop bx
   139 00000690 58                  <1>     pop ax
   140 00000691 CF                  <1>     iret                    ; Return from interrupt
   141                              <1> 
   142                              <1> .timer_expired:
   143                              <1>     ; Timer reached 0 - trigger game over
   144 00000692 C606[0306]00        <1>     mov byte [timer_active], 0
   145                              <1>     ; Game state will be checked in main loop
   146 00000697 EBEC                <1>     jmp .chain_to_old
   147                              <1> 
   148                              <1> ; ------------------------------------------------------------
   149                              <1> ; updateTimerDisplay
   150                              <1> ; Converts timer_seconds to MM:SS format
   151                              <1> ; Updates timer_minutes and timer_display_sec
   152                              <1> ; ------------------------------------------------------------
   153                              <1> updateTimerDisplay:
   154 00000699 50                  <1>     push ax
   155 0000069A 53                  <1>     push bx
   156 0000069B 52                  <1>     push dx
   157                              <1> 
   158                              <1>     ; Get total seconds
   159 0000069C A1[FA05]            <1>     mov ax, [timer_seconds]
   160                              <1> 
   161                              <1>     ; Divide by 60 to get minutes
   162 0000069F 31D2                <1>     xor dx, dx
   163 000006A1 BB3C00              <1>     mov bx, 60
   164 000006A4 F7F3                <1>     div bx                  ; AX = minutes, DX = seconds
   165                              <1> 
   166                              <1>     ; Store results
   167 000006A6 A2[FC05]            <1>     mov [timer_minutes], al
   168 000006A9 8816[FD05]          <1>     mov [timer_display_sec], dl
   169                              <1> 
   170 000006AD 5A                  <1>     pop dx
   171 000006AE 5B                  <1>     pop bx
   172 000006AF 58                  <1>     pop ax
   173 000006B0 C3                  <1>     ret
   174                              <1> 
   175                              <1> ; ------------------------------------------------------------
   176                              <1> ; resetTimer
   177                              <1> ; Resets timer to initial value (120 seconds)
   178                              <1> ; ------------------------------------------------------------
   179                              <1> resetTimer:
   180 000006B1 50                  <1>     push ax
   181                              <1> 
   182 000006B2 C706[FA05]7800      <1>     mov word [timer_seconds], GAME_TIME_SEC
   183 000006B8 C606[FC05]02        <1>     mov byte [timer_minutes], 2
   184 000006BD C606[FD05]00        <1>     mov byte [timer_display_sec], 0
   185 000006C2 C606[FE05]00        <1>     mov byte [timer_ticks], 0
   186 000006C7 C606[0306]01        <1>     mov byte [timer_active], 1
   187                              <1> 
   188 000006CC 58                  <1>     pop ax
   189 000006CD C3                  <1>     ret
   190                              <1> 
   191                              <1> ; ------------------------------------------------------------
   192                              <1> ; pauseTimer
   193                              <1> ; Pauses the timer (stops decrementing)
   194                              <1> ; ------------------------------------------------------------
   195                              <1> pauseTimer:
   196 000006CE C606[0306]00        <1>     mov byte [timer_active], 0
   197 000006D3 C3                  <1>     ret
   198                              <1> 
   199                              <1> ; ------------------------------------------------------------
   200                              <1> ; resumeTimer
   201                              <1> ; Resumes the timer (continues decrementing)
   202                              <1> ; ------------------------------------------------------------
   203                              <1> resumeTimer:
   204 000006D4 C606[0306]01        <1>     mov byte [timer_active], 1
   205 000006D9 C3                  <1>     ret
   206                              <1> 
   207                              <1> ; ------------------------------------------------------------
   208                              <1> ; isTimerExpired
   209                              <1> ; Returns: AL = 1 if timer expired, 0 otherwise
   210                              <1> ; ------------------------------------------------------------
   211                              <1> isTimerExpired:
   212 000006DA 53                  <1>     push bx
   213                              <1>     
   214 000006DB B000                <1>     mov al, 0
   215 000006DD 833E[FA05]00        <1>     cmp word [timer_seconds], 0
   216 000006E2 7502                <1>     jne .not_expired
   217 000006E4 B001                <1>     mov al, 1
   218                              <1> 
   219                              <1> .not_expired:
   220 000006E6 5B                  <1>     pop bx
   221 000006E7 C3                  <1>     ret
   222                              <1> 
   223                              <1> ; ------------------------------------------------------------
   224                              <1> ; getTimerString
   225                              <1> ; Converts timer to "MM:SS" string format
   226                              <1> ; INPUT: SI = pointer to 6-byte buffer (output)
   227                              <1> ; OUTPUT: Buffer filled with "MM:SS\0"
   228                              <1> ; ------------------------------------------------------------
   229                              <1> getTimerString:
   230 000006E8 50                  <1>     push ax
   231 000006E9 53                  <1>     push bx
   232 000006EA 51                  <1>     push cx
   233 000006EB 52                  <1>     push dx
   234 000006EC 57                  <1>     push di
   235                              <1> 
   236 000006ED 89F7                <1>     mov di, si              ; DI = output buffer
   237                              <1> 
   238                              <1>     ; Convert minutes to ASCII
   239 000006EF 30E4                <1>     xor ah, ah
   240 000006F1 A0[FC05]            <1>     mov al, [timer_minutes]
   241 000006F4 B30A                <1>     mov bl, 10
   242 000006F6 F6F3                <1>     div bl                  ; AH = ones, AL = tens
   243 000006F8 0430                <1>     add al, '0'
   244 000006FA 8805                <1>     mov [di], al
   245 000006FC 47                  <1>     inc di
   246 000006FD 88E0                <1>     mov al, ah
   247 000006FF 0430                <1>     add al, '0'
   248 00000701 8805                <1>     mov [di], al
   249 00000703 47                  <1>     inc di
   250                              <1> 
   251                              <1>     ; Add colon
   252 00000704 C6053A              <1>     mov byte [di], ':'
   253 00000707 47                  <1>     inc di
   254                              <1> 
   255                              <1>     ; Convert seconds to ASCII
   256 00000708 30E4                <1>     xor ah, ah
   257 0000070A A0[FD05]            <1>     mov al, [timer_display_sec]
   258 0000070D B30A                <1>     mov bl, 10
   259 0000070F F6F3                <1>     div bl                  ; AH = ones, AL = tens
   260 00000711 0430                <1>     add al, '0'
   261 00000713 8805                <1>     mov [di], al
   262 00000715 47                  <1>     inc di
   263 00000716 88E0                <1>     mov al, ah
   264 00000718 0430                <1>     add al, '0'
   265 0000071A 8805                <1>     mov [di], al
   266 0000071C 47                  <1>     inc di
   267                              <1> 
   268                              <1>     ; Null terminator
   269 0000071D C60500              <1>     mov byte [di], 0
   270                              <1> 
   271 00000720 5F                  <1>     pop di
   272 00000721 5A                  <1>     pop dx
   273 00000722 59                  <1>     pop cx
   274 00000723 5B                  <1>     pop bx
   275 00000724 58                  <1>     pop ax
   276 00000725 C3                  <1>     ret
    12                                  %include "Code\sound.asm"
     1                              <1> ; sound.asm — PC Speaker victory sound
     2                              <1> ; Compatible with NASM (COM or EXE)
     3                              <1> 
     4                              <1> melodyFreqs:
     5 00000726 20038403E8034C04B0- <1>     dw 800, 900, 1000, 1100, 1200, 1300, 1400, 1500
     5 0000072F 0414057805DC05      <1>
     6 00000736 DC0578051405B0044C- <1>     dw 1500, 1400, 1300, 1200, 1100, 1000, 900, 800
     6 0000073F 04E80384032003      <1>
     7                              <1> numNotes    equ 16
     8 00000746 0200                <1> tempo       dw 2
     9 00000748 DC341200            <1> pit_constant: dd 1193180    ; Store as 32-bit constant
    10                              <1> 
    11                              <1> ; ---------------------------------------
    12                              <1> ; playCompletionSound — main entry
    13                              <1> ; ---------------------------------------
    14                              <1> playCompletionSound:
    15 0000074C 50                  <1>     push ax
    16 0000074D 53                  <1>     push bx
    17 0000074E 51                  <1>     push cx
    18 0000074F 52                  <1>     push dx
    19 00000750 56                  <1>     push si
    20                              <1> 
    21 00000751 BE[2607]            <1>     mov si, melodyFreqs
    22 00000754 B91000              <1>     mov cx, numNotes
    23                              <1> .loopNotes:
    24 00000757 AD                  <1>     lodsw                  ; AX = frequency
    25 00000758 09C0                <1>     or  ax, ax
    26 0000075A 7405                <1>     jz  .done
    27 0000075C E80800              <1>     call playTune
    28 0000075F E2F6                <1>     loop .loopNotes
    29                              <1> 
    30                              <1> .done:
    31 00000761 5E                  <1>     pop si
    32 00000762 5A                  <1>     pop dx
    33 00000763 59                  <1>     pop cx
    34 00000764 5B                  <1>     pop bx
    35 00000765 58                  <1>     pop ax
    36 00000766 C3                  <1>     ret
    37                              <1> 
    38                              <1> ; ---------------------------------------
    39                              <1> ; playTune — AX = frequency (Hz)
    40                              <1> ; ---------------------------------------
    41                              <1> playTune:
    42 00000767 50                  <1>     push ax
    43 00000768 53                  <1>     push bx
    44 00000769 51                  <1>     push cx
    45 0000076A 52                  <1>     push dx
    46                              <1> 
    47 0000076B 89C3                <1>     mov bx, ax              ; Save frequency in BX
    48                              <1>     
    49                              <1>     ; Load 1193180 into DX:AX
    50 0000076D A1[4807]            <1>     mov ax, word [pit_constant]      ; Low word
    51 00000770 8B16[4A07]          <1>     mov dx, word [pit_constant + 2]  ; High word
    52                              <1>     
    53                              <1>     ; Divide DX:AX by BX -> quotient in AX
    54 00000774 F7F3                <1>     div bx                  ; DX:AX / BX = AX (remainder in DX)
    55 00000776 89C3                <1>     mov bx, ax              ; BX = divisor
    56                              <1> 
    57                              <1>     ; Program PIT channel 2
    58 00000778 B0B6                <1>     mov al, 0xB6
    59 0000077A E643                <1>     out 0x43, al
    60 0000077C 89D8                <1>     mov ax, bx
    61 0000077E E642                <1>     out 0x42, al            ; low byte
    62 00000780 88E0                <1>     mov al, ah
    63 00000782 E642                <1>     out 0x42, al            ; high byte
    64                              <1> 
    65                              <1>     ; Enable speaker
    66 00000784 E461                <1>     in al, 0x61
    67 00000786 0C03                <1>     or al, 3
    68 00000788 E661                <1>     out 0x61, al
    69                              <1> 
    70                              <1>     ; Hold tone
    71 0000078A E80B00              <1>     call toneDelay
    72                              <1> 
    73                              <1>     ; Disable speaker
    74 0000078D E461                <1>     in al, 0x61
    75 0000078F 24FC                <1>     and al, 0xFC
    76 00000791 E661                <1>     out 0x61, al
    77                              <1> 
    78 00000793 5A                  <1>     pop dx
    79 00000794 59                  <1>     pop cx
    80 00000795 5B                  <1>     pop bx
    81 00000796 58                  <1>     pop ax
    82 00000797 C3                  <1>     ret
    83                              <1> 
    84                              <1> ; ---------------------------------------
    85                              <1> ; toneDelay — simple busy wait
    86                              <1> ; ---------------------------------------
    87                              <1> toneDelay:
    88 00000798 51                  <1>     push cx
    89 00000799 52                  <1>     push dx
    90 0000079A 8B16[4607]          <1>     mov dx, [tempo]
    91                              <1> .delayOuter:
    92 0000079E B9FFAF              <1>     mov cx, 0xAFFF
    93                              <1> .delayInner:
    94 000007A1 E2FE                <1>     loop .delayInner
    95 000007A3 4A                  <1>     dec dx
    96 000007A4 75F8                <1>     jnz .delayOuter
    97 000007A6 5A                  <1>     pop dx
    98 000007A7 59                  <1>     pop cx
    99 000007A8 C3                  <1>     ret
    13                                  %include "Code\show_bg.asm"
     1                              <1> ; ============================================================
     2                              <1> ; show_bg.asm — Draws VGA 320x200x256 background with palette
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> %define MODE_VGA13H  0x0013
     6                              <1> %define VIDEO_SEG    0xA000
     7                              <1> %define SCREEN_SIZE  64000
     8                              <1> %define CHUNK_SIZE   8192
     9                              <1> 
    10                              <1> ; ------------------------------------------------------------
    11                              <1> ; PUBLIC: showBackground320x200
    12                              <1> ; Loads and displays final.raw using vga.bin palette
    13                              <1> ; Palette is loaded only on first call.
    14                              <1> ; ------------------------------------------------------------
    15                              <1> showBackground320x200:
    16 000007A9 50                  <1>     push ax
    17 000007AA 53                  <1>     push bx
    18 000007AB 51                  <1>     push cx
    19 000007AC 52                  <1>     push dx
    20 000007AD 56                  <1>     push si
    21 000007AE 57                  <1>     push di
    22 000007AF 1E                  <1>     push ds
    23 000007B0 06                  <1>     push es
    24                              <1> 
    25                              <1>     ; If palette not loaded yet -> load it once
    26 000007B1 A0[5D2B]            <1>     mov al, [palette_loaded]
    27 000007B4 3C01                <1>     cmp al, 1
    28 000007B6 7408                <1>     je .skip_palette
    29 000007B8 E84E00              <1>     call load_palette
    30 000007BB C606[5D2B]01        <1>     mov byte [palette_loaded], 1
    31                              <1> 
    32                              <1> .skip_palette:
    33                              <1>     ; --------------------------------------------------------
    34                              <1>     ; Load and display background image from "final.raw"
    35                              <1>     ; (same behavior as before)
    36                              <1>     ; --------------------------------------------------------
    37 000007C0 B800A0              <1>     mov ax, VIDEO_SEG
    38 000007C3 8EC0                <1>     mov es, ax
    39 000007C5 31FF                <1>     xor di, di
    40                              <1> 
    41                              <1>     ; Open RAW file (read-only)
    42 000007C7 8D16[4508]          <1>     lea dx, [filename]
    43 000007CB B43D                <1>     mov ah, 0x3D
    44 000007CD 30C0                <1>     xor al, al
    45 000007CF CD21                <1>     int 0x21
    46 000007D1 722D                <1>     jc .cleanup
    47 000007D3 89C3                <1>     mov bx, ax                  ; BX = file handle
    48                              <1> 
    49                              <1> .read_loop:
    50                              <1>     ; Read chunk into buffer
    51 000007D5 B43F                <1>     mov ah, 0x3F
    52 000007D7 B90020              <1>     mov cx, CHUNK_SIZE
    53 000007DA 8D16[5D08]          <1>     lea dx, [buffer]
    54 000007DE CD21                <1>     int 0x21
    55 000007E0 721A                <1>     jc .close_file
    56 000007E2 09C0                <1>     or ax, ax
    57 000007E4 7416                <1>     jz .close_file              ; EOF reached
    58                              <1> 
    59                              <1>     ; Copy to VGA memory (use ES:DI for video, DS:SI for buffer)
    60 000007E6 1E                  <1>     push ds
    61 000007E7 BE[5D08]            <1>     mov si, buffer
    62 000007EA 89C1                <1>     mov cx, ax
    63                              <1> .copy_loop:
    64 000007EC 8A04                <1>     mov al, [si]
    65 000007EE 268805              <1>     mov [es:di], al
    66 000007F1 46                  <1>     inc si
    67 000007F2 47                  <1>     inc di
    68 000007F3 E2F7                <1>     loop .copy_loop
    69 000007F5 1F                  <1>     pop ds
    70                              <1> 
    71 000007F6 81FF00FA            <1>     cmp di, SCREEN_SIZE
    72 000007FA 72D9                <1>     jb .read_loop
    73                              <1> 
    74                              <1> .close_file:
    75 000007FC B43E                <1>     mov ah, 0x3E
    76 000007FE CD21                <1>     int 0x21
    77                              <1> 
    78                              <1> .cleanup:
    79 00000800 07                  <1>     pop es
    80 00000801 1F                  <1>     pop ds
    81 00000802 5F                  <1>     pop di
    82 00000803 5E                  <1>     pop si
    83 00000804 5A                  <1>     pop dx
    84 00000805 59                  <1>     pop cx
    85 00000806 5B                  <1>     pop bx
    86 00000807 58                  <1>     pop ax
    87 00000808 C3                  <1>     ret
    88                              <1> 
    89                              <1> 
    90                              <1> ; ------------------------------------------------------------
    91                              <1> ; load_palette — Loads "vga.bin" and programs VGA DAC registers
    92                              <1> ; (Unchanged from your original; called only once now)
    93                              <1> ; ------------------------------------------------------------
    94                              <1> load_palette:
    95 00000809 50                  <1>     push ax
    96 0000080A 53                  <1>     push bx
    97 0000080B 51                  <1>     push cx
    98 0000080C 52                  <1>     push dx
    99 0000080D 56                  <1>     push si
   100 0000080E 1E                  <1>     push ds
   101                              <1> 
   102                              <1>     ; Open palette file
   103 0000080F 8D16[5108]          <1>     lea dx, [palette_filename]
   104 00000813 B43D                <1>     mov ah, 0x3D
   105 00000815 30C0                <1>     xor al, al
   106 00000817 CD21                <1>     int 0x21
   107 00000819 7223                <1>     jc .lp_exit
   108 0000081B 89C3                <1>     mov bx, ax
   109                              <1> 
   110                              <1>     ; Read 768 bytes (256 colors * 3 bytes)
   111 0000081D B43F                <1>     mov ah, 0x3F
   112 0000081F B90003              <1>     mov cx, 768
