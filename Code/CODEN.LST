   466                              <1> ; ======================================================================
   467                              <1> ; drawChar — draws scaled character using BIOS 8x8 font
   468                              <1> ; Input: AL = ASCII character
   469                              <1> ; Uses [dt_x_pos], [dt_y_pos], [dt_color], [dt_scale]
   470                              <1> ; ======================================================================
   471                              <1> drawChar:
   472 00000224 50                  <1>     push ax
   473 00000225 53                  <1>     push bx
   474 00000226 51                  <1>     push cx
   475 00000227 52                  <1>     push dx
   476 00000228 56                  <1>     push si
   477 00000229 57                  <1>     push di
   478 0000022A 55                  <1>     push bp
   479                              <1> 
   480                              <1>     ; --- Compute glyph offset: 8 bytes per character ---
   481 0000022B B400                <1>     mov ah, 0
   482 0000022D B308                <1>     mov bl, 8
   483 0000022F F6E3                <1>     mul bl                  ; AX = ASCII * 8 (each glyph = 8 bytes)
   484 00000231 BE6EFA              <1>     mov si, FONT_OFF
   485 00000234 01C6                <1>     add si, ax
   486 00000236 B800F0              <1>     mov ax, FONT_SEG
   487 00000239 8EC0                <1>     mov es, ax              ; ES:SI -> glyph start
   488                              <1> 
   489                              <1>     ; --- Save start X/Y ---
   490 0000023B A1[7805]            <1>     mov ax, [dt_x_pos]
   491 0000023E A3[B802]            <1>     mov [.start_x], ax
   492 00000241 A1[7A05]            <1>     mov ax, [dt_y_pos]
   493 00000244 A3[BA02]            <1>     mov [.start_y], ax
   494                              <1> 
   495 00000247 BD0800              <1>     mov bp, 8               ; 8 rows per glyph
   496                              <1> 
   497                              <1> .row_loop:
   498 0000024A 268A04              <1>     mov al, [es:si]         ; read next row (8 bits)
   499 0000024D 46                  <1>     inc si
   500                              <1> 
   501 0000024E 8B0E[B802]          <1>     mov cx, [.start_x]      ; reset X
   502 00000252 8B16[7A05]          <1>     mov dx, [dt_y_pos]      ; current Y
   503                              <1> 
   504 00000256 BF0800              <1>     mov di, 8               ; 8 bits per row
   505                              <1> 
   506                              <1> .bit_loop:
   507 00000259 8B16[7A05]          <1>     mov dx, [dt_y_pos]
   508 0000025D A880                <1>     test al, 0x80
   509 0000025F 742D                <1>     jz .skip_bit
   510                              <1> 
   511 00000261 50                  <1>     push ax
   512 00000262 57                  <1>     push di
   513                              <1> 
   514 00000263 30FF                <1>     xor bh, bh
   515 00000265 8A1E[7D05]          <1>     mov bl, [dt_scale]
   516 00000269 891E[BE02]          <1>     mov [.scale_y_count], bx
   517                              <1> 
   518                              <1> .scale_y_loop:
   519 0000026D 51                  <1>     push cx
   520 0000026E 52                  <1>     push dx
   521 0000026F 30FF                <1>     xor bh, bh
   522 00000271 8A1E[7D05]          <1>     mov bl, [dt_scale]
   523 00000275 891E[BC02]          <1>     mov [.scale_x_count], bx
   524                              <1> 
   525                              <1> .scale_x_loop:
   526 00000279 E84400              <1>     call putPixel
   527 0000027C 41                  <1>     inc cx
   528 0000027D FF0E[BC02]          <1>     dec word [.scale_x_count]
   529 00000281 75F6                <1>     jnz .scale_x_loop
   530                              <1> 
   531 00000283 5A                  <1>     pop dx
   532 00000284 59                  <1>     pop cx
   533 00000285 42                  <1>     inc dx
   534 00000286 FF0E[BE02]          <1>     dec word [.scale_y_count]
   535 0000028A 75E1                <1>     jnz .scale_y_loop
   536                              <1> 
   537 0000028C 5F                  <1>     pop di
   538 0000028D 58                  <1>     pop ax
   539                              <1> 
   540                              <1> .skip_bit:
   541 0000028E 30FF                <1>     xor bh, bh
   542 00000290 8A1E[7D05]          <1>     mov bl, [dt_scale]
   543 00000294 01D9                <1>     add cx, bx
   544 00000296 D0E0                <1>     shl al, 1
   545 00000298 4F                  <1>     dec di
   546 00000299 75BE                <1>     jnz .bit_loop
   547                              <1> 
   548                              <1>     ; Advance Y
   549 0000029B A1[7A05]            <1>     mov ax, [dt_y_pos]
   550 0000029E 8B1E[7D05]          <1>     mov bx, [dt_scale]
   551 000002A2 01D8                <1>     add ax, bx
   552 000002A4 A3[7A05]            <1>     mov [dt_y_pos], ax
   553                              <1> 
   554 000002A7 4D                  <1>     dec bp
   555 000002A8 75A0                <1>     jnz .row_loop
   556                              <1> 
   557                              <1>     ; Restore Y
   558 000002AA A1[BA02]            <1>     mov ax, [.start_y]
   559 000002AD A3[7A05]            <1>     mov [dt_y_pos], ax
   560                              <1> 
   561 000002B0 5D                  <1>     pop bp
   562 000002B1 5F                  <1>     pop di
   563 000002B2 5E                  <1>     pop si
   564 000002B3 5A                  <1>     pop dx
   565 000002B4 59                  <1>     pop cx
   566 000002B5 5B                  <1>     pop bx
   567 000002B6 58                  <1>     pop ax
   568 000002B7 C3                  <1>     ret
   569                              <1> 
   570 000002B8 0000                <1> .start_x        dw 0
   571 000002BA 0000                <1> .start_y        dw 0
   572 000002BC 0000                <1> .scale_x_count  dw 0
   573 000002BE 0000                <1> .scale_y_count  dw 0
   574                              <1> 
