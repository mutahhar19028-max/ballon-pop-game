    19                                  %include "Code\balloon_system.asm" 
     1                              <1> ; ============================================================================
     2                              <1> ; balloon_system.asm — Balloon System with Background Buffer
     3                              <1> ; ============================================================================
     4                              <1> ; Uses background buffering to avoid redrawing entire screen
     5                              <1> ; Saves pixels before drawing, restores them before moving
     6                              <1> ; ============================================================================
     7                              <1> 
     8                              <1> ; ------------------------------------------------------------
     9                              <1> ; BALLOON CONSTANTS
    10                              <1> ; ------------------------------------------------------------
    11                              <1> %define MAX_BALLOONS        3
    12                              <1> %define BALLOON_WIDTH       24              ; Pixels wide
    13                              <1> %define BALLOON_HEIGHT      21              ; Pixels tall
    14                              <1> %define BALLOON_STRING_LEN  2
    15                              <1> 
    16                              <1> %define SPAWN_Y             186             ; 200 - 14 = 186 (bottom)
    17                              <1> %define DESPAWN_Y           40
    18                              <1> %define MIN_SPAWN_X         30
    19                              <1> %define MAX_SPAWN_X         286             ; 320 - 16 = 304
    20                              <1> 
    21                              <1> %define BALLOON_SPEED       1
    22                              <1> %define MOVEMENT_DELAY      100               ; Move every 3 frames (slower!)
    23                              <1> %define SPAWN_DELAY         40
    24                              <1> 
    25                              <1> ; Buffer size per balloon: 16 * 14 = 224 bytes
    26                              <1> %define BUFFER_SIZE         504
    27                              <1> 
    28                              <1> ; Balloon colors (8 vibrant colors from your palette)
    29                              <1> balloon_colors:
    30 0000325D 1A1C1F3F48472F37    <1>     db 26, 28, 31, 63, 72, 71, 47, 55
    31                              <1> 
    32                              <1> ; ------------------------------------------------------------
    33                              <1> ; BALLOON DATA STRUCTURE (16 bytes per balloon)
    34                              <1> ; ------------------------------------------------------------
    35                              <1> ; Offset | Size | Description
    36                              <1> ; -------+------+---------------------------
    37                              <1> ; +0     | 2    | x_position (word)
    38                              <1> ; +2     | 2    | y_position (word)
    39                              <1> ; +4     | 1    | letter (byte, ASCII 'A'-'Z')
    40                              <1> ; +5     | 1    | color_index (byte, 0-7)
    41                              <1> ; +6     | 1    | active_flag (byte, 0=inactive, 1=active)
    42                              <1> ; +7     | 1    | speed (byte, pixels/frame)
    43                              <1> ; +8     | 2    | buffer_offset (word, pointer to background buffer)
    44                              <1> ; +10-15 | 6    | Reserved
    45                              <1> ; ------------------------------------------------------------
    46                              <1> 
    47 00003265 00<rep 30h>         <1> balloon_array:      times (MAX_BALLOONS * 16) db 0
    48 00003295 00                  <1> balloon_count:      db 0
    49 00003296 0000                <1> spawn_timer:        dw 0
    50 00003298 0000                <1> random_seed:        dw 0
    51 0000329A 00                  <1> movement_counter:   db 0        ; NEW: Frame counter for slower movement
    52                              <1> 
    53                              <1> ; Background buffer: 10 balloons × 224 bytes = 2240 bytes
    54 0000329B 00<rep 5E8h>        <1> background_buffer:  times (MAX_BALLOONS * BUFFER_SIZE) db 0
    55                              <1> 
    56                              <1> 
    57                              <1> ; ============================================================================
    58                              <1> ; PUBLIC API FUNCTIONS
    59                              <1> ; ============================================================================
    60                              <1> 
    61                              <1> ; ------------------------------------------------------------
    62                              <1> ; initBalloonSystem
    63                              <1> ; ------------------------------------------------------------
    64                              <1> initBalloonSystem:
    65 00003883 50                  <1>     push ax
    66 00003884 53                  <1>     push bx
    67 00003885 51                  <1>     push cx
    68 00003886 57                  <1>     push di
    69 00003887 06                  <1>     push es
    70                              <1> 
    71                              <1>     ; Clear balloon array
    72 00003888 8CD8                <1>     mov ax, ds
    73 0000388A 8EC0                <1>     mov es, ax
    74 0000388C BF[6532]            <1>     mov di, balloon_array
    75 0000388F B93000              <1>     mov cx, (MAX_BALLOONS * 16)
    76 00003892 30C0                <1>     xor al, al
    77 00003894 F3AA                <1>     rep stosb
    78                              <1> 
    79                              <1>     ; Initialize buffer offsets for each balloon
    80 00003896 BE[6532]            <1>     mov si, balloon_array
    81 00003899 B80000              <1>     mov ax, 0                   ; Buffer offset starts at 0
    82 0000389C B90300              <1>     mov cx, MAX_BALLOONS
    83                              <1> 
    84                              <1> .init_buffers:
    85 0000389F 894408              <1>     mov [si+8], ax              ; Store buffer offset
    86 000038A2 05F801              <1>     add ax, BUFFER_SIZE         ; Next buffer
    87 000038A5 83C610              <1>     add si, 16                  ; Next balloon
    88 000038A8 E2F5                <1>     loop .init_buffers
    89                              <1> 
    90                              <1>     ; Reset counters
    91 000038AA C606[9532]00        <1>     mov byte [balloon_count], 0
    92 000038AF C706[9632]0000      <1>     mov word [spawn_timer], 0
    93 000038B5 C606[9A32]00        <1>     mov byte [movement_counter], 0  ; Reset movement counter
    94                              <1> 
    95                              <1>     ; Seed random
    96 000038BA B400                <1>     mov ah, 0x00
    97 000038BC CD1A                <1>     int 0x1A
    98 000038BE 8916[9832]          <1>     mov [random_seed], dx
    99                              <1> 
   100 000038C2 07                  <1>     pop es
   101 000038C3 5F                  <1>     pop di
   102 000038C4 59                  <1>     pop cx
   103 000038C5 5B                  <1>     pop bx
   104 000038C6 58                  <1>     pop ax
   105 000038C7 C3                  <1>     ret
