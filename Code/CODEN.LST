   234                              <1> 
   235 00004597 30C0                <1>     xor al, al
   236 00004599 EB14                <1>     jmp .done
   237                              <1> 
   238                              <1> .hit_found:
   239                              <1>     ; Restore background before removing
   240 0000459B 50                  <1>     push ax
