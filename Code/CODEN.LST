   166 00002ECB 5E                  <1>     pop si
   167 00002ECC 5A                  <1>     pop dx
   168 00002ECD 59                  <1>     pop cx
   169 00002ECE 5B                  <1>     pop bx
   170 00002ECF 58                  <1>     pop ax
