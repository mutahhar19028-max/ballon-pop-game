    86                              <1> ; ------------------------------------------------------------
    87                              <1> ; drawFilledRect
    88                              <1> ; ------------------------------------------------------------
    89                              <1> ; INPUT:
    90                              <1> ;   AX = X coordinate (top-left)
    91                              <1> ;   BX = Y coordinate (top-left)
    92                              <1> ;   CX = Width in pixels
    93                              <1> ;   DX = Height in pixels
    94                              <1> ;   SI = Color value
    95                              <1> ; OUTPUT:
    96                              <1> ;   Solid filled rectangle
    97                              <1> ; EFFECT:
    98                              <1> ;   Draws DX rows, each CX pixels wide
    99                              <1> ;   Calculates offset for each row: (Y*320 + X)
   100                              <1> ;   Fills each row left to right with specified color
   101                              <1> ; ------------------------------------------------------------
   102                              <1> drawFilledRect:
   103 00000099 50                  <1>     push ax
   104 0000009A 53                  <1>     push bx
   105 0000009B 51                  <1>     push cx
   106 0000009C 52                  <1>     push dx
   107 0000009D 57                  <1>     push di
   108 0000009E 06                  <1>     push es
   109 0000009F 55                  <1>     push bp
   110                              <1> 
   111 000000A0 3D4001              <1>     cmp ax, 320
   112 000000A3 732C                <1>     jae .done
   113 000000A5 81FBC800            <1>     cmp bx, 200
   114 000000A9 7326                <1>     jae .done
   115                              <1> 
   116 000000AB BD00A0              <1>     mov bp, VGA_SEGMENT
   117 000000AE 8EC5                <1>     mov es, bp
   118                              <1> 
   119 000000B0 89D5                <1>     mov bp, dx
   120                              <1> 
   121                              <1> .row_loop:
   122 000000B2 51                  <1>     push cx
   123 000000B3 50                  <1>     push ax
   124                              <1>     
   125 000000B4 89DF                <1>     mov di, bx
   126 000000B6 52                  <1>     push dx
   127 000000B7 BA4001              <1>     mov dx, 320
   128 000000BA 50                  <1>     push ax
   129 000000BB 89F8                <1>     mov ax, di
   130 000000BD F7E2                <1>     mul dx
   131 000000BF 89C7                <1>     mov di, ax
   132 000000C1 58                  <1>     pop ax
   133 000000C2 5A                  <1>     pop dx
   134 000000C3 01C7                <1>     add di, ax
   135                              <1> 
   136                              <1> .col_loop:
   137 000000C5 268935              <1>     mov [es:di], si
   138 000000C8 47                  <1>     inc di
   139 000000C9 E2FA                <1>     loop .col_loop
   140                              <1>     
   141 000000CB 58                  <1>     pop ax
   142 000000CC 59                  <1>     pop cx
   143 000000CD 43                  <1>     inc bx
   144 000000CE 4D                  <1>     dec bp
   145 000000CF 75E1                <1>     jnz .row_loop
   146                              <1> 
   147                              <1> .done:
   148 000000D1 5D                  <1>     pop bp
   149 000000D2 07                  <1>     pop es
   150 000000D3 5F                  <1>     pop di
   151 000000D4 5A                  <1>     pop dx
   152 000000D5 59                  <1>     pop cx
   153 000000D6 5B                  <1>     pop bx
   154 000000D7 58                  <1>     pop ax
   155 000000D8 C3                  <1>     ret
   156                              <1> 
   157                              <1> ; ------------------------------------------------------------
   158                              <1> ; drawRectOutline
   159                              <1> ; ------------------------------------------------------------
   160                              <1> ; INPUT:
   161                              <1> ;   AX = X coordinate (top-left)
   162                              <1> ;   BX = Y coordinate (top-left)
   163                              <1> ;   CX = Width in pixels
   164                              <1> ;   DX = Height in pixels
   165                              <1> ;   SI = Color value for border
   166                              <1> ; OUTPUT:
   167                              <1> ;   Hollow rectangle (4 border lines only)
   168                              <1> ; EFFECT:
   169                              <1> ;   Draws top horizontal line at (X, Y)
   170                              <1> ;   Draws bottom horizontal line at (X, Y+Height-1)
   171                              <1> ;   Draws left vertical line at (X, Y)
   172                              <1> ;   Draws right vertical line at (X+Width-1, Y)
   173                              <1> ;   Interior remains unchanged
   174                              <1> ; ------------------------------------------------------------
   175                              <1> drawRectOutline:
   176 000000D9 50                  <1>     push ax
   177 000000DA 53                  <1>     push bx
   178 000000DB 51                  <1>     push cx
   179 000000DC 52                  <1>     push dx
   180 000000DD 57                  <1>     push di
   181 000000DE 55                  <1>     push bp
   182                              <1> 
   183 000000DF 89E5                <1>     mov bp, sp
   184 000000E1 83EC08              <1>     sub sp, 8
   185 000000E4 8946FE              <1>     mov [bp-2], ax
   186 000000E7 895EFC              <1>     mov [bp-4], bx
   187 000000EA 894EFA              <1>     mov [bp-6], cx
   188 000000ED 8956F8              <1>     mov [bp-8], dx
   189                              <1> 
   190 000000F0 8B46FE              <1>     mov ax, [bp-2]
   191 000000F3 8B5EFC              <1>     mov bx, [bp-4]
   192 000000F6 8B4EFA              <1>     mov cx, [bp-6]
   193 000000F9 E83600              <1>     call drawHorizontalLine
   194                              <1> 
   195 000000FC 8B46FE              <1>     mov ax, [bp-2]
   196 000000FF 8B5EFC              <1>     mov bx, [bp-4]
   197 00000102 035EF8              <1>     add bx, [bp-8]
   198 00000105 4B                  <1>     dec bx
   199 00000106 8B4EFA              <1>     mov cx, [bp-6]
   200 00000109 E82600              <1>     call drawHorizontalLine
   201                              <1> 
   202 0000010C 8B46FE              <1>     mov ax, [bp-2]
   203 0000010F 8B5EFC              <1>     mov bx, [bp-4]
   204 00000112 8B56F8              <1>     mov dx, [bp-8]
   205 00000115 E85200              <1>     call drawVerticalLine
   206                              <1> 
   207 00000118 8B46FE              <1>     mov ax, [bp-2]
   208 0000011B 0346FA              <1>     add ax, [bp-6]
   209 0000011E 48                  <1>     dec ax
   210 0000011F 8B5EFC              <1>     mov bx, [bp-4]
   211 00000122 8B56F8              <1>     mov dx, [bp-8]
   212 00000125 E84200              <1>     call drawVerticalLine
   213                              <1> 
   214 00000128 83C408              <1>     add sp, 8
   215 0000012B 5D                  <1>     pop bp
   216 0000012C 5F                  <1>     pop di
   217 0000012D 5A                  <1>     pop dx
   218 0000012E 59                  <1>     pop cx
   219 0000012F 5B                  <1>     pop bx
   220 00000130 58                  <1>     pop ax
   221 00000131 C3                  <1>     ret
   222                              <1> 
   223                              <1> 
   224                              <1> ; ------------------------------------------------------------
   225                              <1> ; drawHorizontalLine
   226                              <1> ; ------------------------------------------------------------
   227                              <1> ; INPUT:
   228                              <1> ;   AX = Starting X coordinate
   229                              <1> ;   BX = Y coordinate
   230                              <1> ;   CX = Length in pixels
   231                              <1> ;   SI = Color value
   232                              <1> ; OUTPUT:
   233                              <1> ;   Horizontal line drawn from (X,Y) extending CX pixels right
   234                              <1> ; EFFECT:
   235                              <1> ;   Calculates starting offset (Y*320 + X)
   236                              <1> ;   Writes color value CX times sequentially
   237                              <1> ;   Performs basic bounds checking
   238                              <1> ; ------------------------------------------------------------
   239                              <1> drawHorizontalLine:
   240 00000132 50                  <1>     push ax
   241 00000133 53                  <1>     push bx
   242 00000134 51                  <1>     push cx
   243 00000135 57                  <1>     push di
   244 00000136 06                  <1>     push es
   245 00000137 52                  <1>     push dx
   246                              <1> 
   247 00000138 81FBC800            <1>     cmp bx, 200
   248 0000013C 7325                <1>     jae .done
   249 0000013E 3D4001              <1>     cmp ax, 320
   250 00000141 7320                <1>     jae .done
   251                              <1> 
   252 00000143 BF00A0              <1>     mov di, 0xA000
   253 00000146 8EC7                <1>     mov es, di
   254                              <1> 
   255 00000148 89DF                <1>     mov di, bx
   256 0000014A BA4001              <1>     mov dx, 320
   257 0000014D 50                  <1>     push ax
   258 0000014E 89F8                <1>     mov ax, di
   259 00000150 F7E2                <1>     mul dx
   260 00000152 89C7                <1>     mov di, ax
   261 00000154 58                  <1>     pop ax
   262 00000155 01C7                <1>     add di, ax
   263                              <1> 
   264                              <1> .draw_loop:
   265 00000157 81FF00FA            <1>     cmp di, 64000
   266 0000015B 7306                <1>     jae .done
   267 0000015D 268935              <1>     mov [es:di], si
   268 00000160 47                  <1>     inc di
   269 00000161 E2F4                <1>     loop .draw_loop
   270                              <1> 
   271                              <1> .done:
   272 00000163 5A                  <1>     pop dx
   273 00000164 07                  <1>     pop es
   274 00000165 5F                  <1>     pop di
   275 00000166 59                  <1>     pop cx
   276 00000167 5B                  <1>     pop bx
   277 00000168 58                  <1>     pop ax
   278 00000169 C3                  <1>     ret
   279                              <1> 
   280                              <1> ; ------------------------------------------------------------
   281                              <1> ; drawVerticalLine
   282                              <1> ; ------------------------------------------------------------
   283                              <1> ; INPUT:
   284                              <1> ;   AX = X coordinate
   285                              <1> ;   BX = Starting Y coordinate
   286                              <1> ;   DX = Length in pixels (height)
   287                              <1> ;   SI = Color value
   288                              <1> ; OUTPUT:
   289                              <1> ;   Vertical line drawn from (X,Y) extending DX pixels down
   290                              <1> ; EFFECT:
   291                              <1> ;   Recalculates offset for each row (Y*320 + X)
   292                              <1> ;   Writes one pixel per row, incrementing Y
   293                              <1> ;   Loops DX times downward
   294                              <1> ; ------------------------------------------------------------
   295                              <1> drawVerticalLine:
   296 0000016A 50                  <1>     push ax
   297 0000016B 53                  <1>     push bx
   298 0000016C 52                  <1>     push dx
   299 0000016D 57                  <1>     push di
   300 0000016E 06                  <1>     push es
   301                              <1> 
   302 0000016F 3D4001              <1>     cmp ax, 320
   303 00000172 7323                <1>     jae .done
   304 00000174 81FBC800            <1>     cmp bx, 200
   305 00000178 731D                <1>     jae .done
   306                              <1> 
   307 0000017A BF00A0              <1>     mov di, 0xA000
   308 0000017D 8EC7                <1>     mov es, di
   309                              <1> 
   310                              <1> .draw_loop:
   311 0000017F 52                  <1>     push dx
   312 00000180 89DF                <1>     mov di, bx
   313 00000182 BA4001              <1>     mov dx, 320
   314 00000185 50                  <1>     push ax
   315 00000186 89F8                <1>     mov ax, di
   316 00000188 F7E2                <1>     mul dx
   317 0000018A 89C7                <1>     mov di, ax
   318 0000018C 58                  <1>     pop ax
   319 0000018D 5A                  <1>     pop dx
   320 0000018E 01C7                <1>     add di, ax
   321                              <1>     
   322 00000190 268935              <1>     mov [es:di], si
   323 00000193 43                  <1>     inc bx
   324 00000194 4A                  <1>     dec dx
   325 00000195 75E8                <1>     jnz .draw_loop
   326                              <1> 
   327                              <1> .done:
   328 00000197 07                  <1>     pop es
   329 00000198 5F                  <1>     pop di
   330 00000199 5A                  <1>     pop dx
   331 0000019A 5B                  <1>     pop bx
   332 0000019B 58                  <1>     pop ax
   333 0000019C C3                  <1>     ret
