   211                              <1> ; ------------------------------------------------------------
   212                              <1> ; checkBalloonHit
   213                              <1> ; ------------------------------------------------------------
   214                              <1> checkBalloonHit:
   215 0000457A 53                  <1>     push bx
   216 0000457B 51                  <1>     push cx
   217 0000457C 56                  <1>     push si
   218                              <1> 
   219 0000457D BE[6A32]            <1>     mov si, balloon_array
   220 00004580 B90900              <1>     mov cx, MAX_BALLOONS
   221                              <1> 
   222                              <1> .check_loop:
   223 00004583 8A5C06              <1>     mov bl, [si+6]
   224 00004586 80FB01              <1>     cmp bl, 1
   225 00004589 7507                <1>     jne .next_check
   226                              <1> 
   227 0000458B 8A5C04              <1>     mov bl, [si+4]
   228 0000458E 38D8                <1>     cmp al, bl
   229 00004590 7409                <1>     je .hit_found
   230                              <1> 
   231                              <1> .next_check:
   232 00004592 83C610              <1>     add si, 16
