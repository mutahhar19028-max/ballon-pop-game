    64                              <1> ; ------------------------------------------------------------
    65                              <1> ; PUBLIC: drawScoreValue
    66                              <1> ; Draws the current score at defined position
    67                              <1> ; Called by drawScorePanel
    68                              <1> ; ------------------------------------------------------------
    69                              <1> drawScoreValue:
    70 00002E29 50                  <1>     push ax
    71 00002E2A 53                  <1>     push bx
    72 00002E2B 51                  <1>     push cx
    73 00002E2C 52                  <1>     push dx
    74 00002E2D 56                  <1>     push si
    75 00002E2E 57                  <1>     push di
    76 00002E2F 55                  <1>     push bp
    77                              <1> 
    78                              <1>     ; Allocate 5 bytes for "0000\0"
    79 00002E30 83EC05              <1>     sub sp, 5
    80 00002E33 89E5                <1>     mov bp, sp          ; BP points to buffer
    81                              <1> 
    82 00002E35 A1[E405]            <1>     mov ax, [current_score]  ; AX = current score
    83                              <1> 
    84                              <1>     ; --- Thousands digit ---
    85 00002E38 B9E803              <1>     mov cx, 1000
    86 00002E3B 31D2                <1>     xor dx, dx
    87 00002E3D F7F1                <1>     div cx                  ; AX / 1000 -> AX = quotient in AL, DX = remainder
    88 00002E3F 0430                <1>     add al, '0'
    89 00002E41 884600              <1>     mov [bp], al            ; store thousands digit
    90                              <1> 
    91                              <1>     ; --- Hundreds digit ---
    92 00002E44 89D0                <1>     mov ax, dx               ; remainder from thousands division
    93 00002E46 B96400              <1>     mov cx, 100
    94 00002E49 31D2                <1>     xor dx, dx
    95 00002E4B F7F1                <1>     div cx                   ; AX / 100 -> AL = hundreds, DX = remainder
    96 00002E4D 0430                <1>     add al, '0'
    97 00002E4F 884601              <1>     mov [bp+1], al
    98                              <1> 
    99                              <1>     ; --- Tens digit ---
   100 00002E52 89D0                <1>     mov ax, dx               ; remainder from hundreds
   101 00002E54 B90A00              <1>     mov cx, 10
   102 00002E57 31D2                <1>     xor dx, dx
   103 00002E59 F7F1                <1>     div cx                   ; AX / 10 -> AL = tens, DX = ones
   104 00002E5B 0430                <1>     add al, '0'
   105 00002E5D 884602              <1>     mov [bp+2], al
   106                              <1> 
   107                              <1>     ; --- Ones digit ---
   108 00002E60 88D0                <1>     mov al, dl               ; remainder from tens division
   109 00002E62 0430                <1>     add al, '0'
   110 00002E64 884603              <1>     mov [bp+3], al
   111                              <1> 
   112                              <1>     ; --- Null terminator ---
   113 00002E67 C6460400            <1>     mov byte [bp+4], 0
   114                              <1> 
   115                              <1>     ; Draw score string
   116 00002E6B B9AE00              <1>     mov cx, SCORE_VALUE_X
   117 00002E6E BA0C00              <1>     mov dx, SCORE_VALUE_Y
   118 00002E71 89EE                <1>     mov si, bp
   119 00002E73 8A1E[1100]          <1>     mov bl, [dark_brown]
   120 00002E77 B701                <1>     mov bh, 1
   121 00002E79 E864D3              <1>     call drawText
   122                              <1> 
   123 00002E7C 83C405              <1>     add sp, 5
   124 00002E7F 5D                  <1>     pop bp
   125 00002E80 5F                  <1>     pop di
   126 00002E81 5E                  <1>     pop si
   127 00002E82 5A                  <1>     pop dx
   128 00002E83 59                  <1>     pop cx
   129 00002E84 5B                  <1>     pop bx
   130 00002E85 58                  <1>     pop ax
   131 00002E86 C3                  <1>     ret
   132                              <1> 
