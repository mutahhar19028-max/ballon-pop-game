   504                              <1> ; ============================================================================
   505                              <1> ; HELPER FUNCTIONS
   506                              <1> ; ============================================================================
   507                              <1> 
   508                              <1> ; ------------------------------------------------------------
   509                              <1> ; spawnBalloon
   510                              <1> ; ------------------------------------------------------------
   511                              <1> spawnBalloon:
   512 00003A88 50                  <1>     push ax
   513 00003A89 53                  <1>     push bx
   514 00003A8A 51                  <1>     push cx
   515 00003A8B 56                  <1>     push si
   516                              <1> 
   517 00003A8C A0[9532]            <1>     mov al, [balloon_count]
   518 00003A8F 3C03                <1>     cmp al, MAX_BALLOONS
   519 00003A91 734C                <1>     jae .no_spawn
   520                              <1> 
   521 00003A93 BE[6532]            <1>     mov si, balloon_array
   522 00003A96 B90300              <1>     mov cx, MAX_BALLOONS
   523                              <1> 
   524                              <1> .find_slot:
   525 00003A99 8A4406              <1>     mov al, [si+6]
   526 00003A9C 3C00                <1>     cmp al, 0
   527 00003A9E 7407                <1>     je .found_slot
   528 00003AA0 83C610              <1>     add si, 16
   529 00003AA3 E2F4                <1>     loop .find_slot
   530 00003AA5 EB38                <1>     jmp .no_spawn
   531                              <1> 
   532                              <1> .found_slot:
   533                              <1>     ; Random X
   534 00003AA7 E88900              <1>     call getRandomNumber
   535 00003AAA BB0001              <1>     mov bx, 256
   536 00003AAD 31D2                <1>     xor dx, dx
   537 00003AAF F7F3                <1>     div bx
   538 00003AB1 83C21E              <1>     add dx, MIN_SPAWN_X
   539 00003AB4 8914                <1>     mov [si+0], dx
   540                              <1> 
   541                              <1>     ; Y at bottom
   542 00003AB6 C74402BA00          <1>     mov word [si+2], SPAWN_Y
   543                              <1> 
   544                              <1>     ; Random letter
   545 00003ABB E87500              <1>     call getRandomNumber
   546 00003ABE BB1A00              <1>     mov bx, 26
   547 00003AC1 31D2                <1>     xor dx, dx
   548 00003AC3 F7F3                <1>     div bx
   549 00003AC5 80C241              <1>     add dl, 'A'
   550 00003AC8 885404              <1>     mov [si+4], dl
   551                              <1> 
   552                              <1>     ; Random color
   553 00003ACB E86500              <1>     call getRandomNumber
   554 00003ACE 2407                <1>     and al, 0x07
   555 00003AD0 884405              <1>     mov [si+5], al
   556                              <1> 
   557                              <1>     ; Activate
   558 00003AD3 C6440601            <1>     mov byte [si+6], 1
   559 00003AD7 C6440701            <1>     mov byte [si+7], BALLOON_SPEED
   560                              <1> 
   561 00003ADB FE06[9532]          <1>     inc byte [balloon_count]
   562                              <1> 
   563                              <1> .no_spawn:
   564 00003ADF 5E                  <1>     pop si
   565 00003AE0 59                  <1>     pop cx
   566 00003AE1 5B                  <1>     pop bx
   567 00003AE2 58                  <1>     pop ax
   568 00003AE3 C3                  <1>     ret
   569                              <1> 
