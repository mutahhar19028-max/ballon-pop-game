   321                              <1> ; ------------------------------------------------------------
   322                              <1> ; saveBalloonBackground
   323                              <1> ; INPUT: SI = pointer to balloon structure
   324                              <1> ; Saves 16x14 pixel area to buffer
   325                              <1> ; ------------------------------------------------------------
   326                              <1> saveBalloonBackground:
   327 00004652 50                  <1>     push ax
   328 00004653 53                  <1>     push bx
   329 00004654 51                  <1>     push cx
   330 00004655 52                  <1>     push dx
   331 00004656 57                  <1>     push di
   332 00004657 56                  <1>     push si
   333 00004658 06                  <1>     push es
   334 00004659 1E                  <1>     push ds
   335                              <1> 
   336                              <1>     ; Get balloon position
   337 0000465A 8B04                <1>     mov ax, [si+0]              ; X
   338 0000465C 8B5C02              <1>     mov bx, [si+2]              ; Y
   339 0000465F 8B7C08              <1>     mov di, [si+8]              ; Buffer offset
   340                              <1> 
   341                              <1>     ; Check bounds
   342 00004662 83FB00              <1>     cmp bx, 0
   343 00004665 7C4F                <1>     jl .done_save
   344 00004667 81FBC800            <1>     cmp bx, 200
   345 0000466B 7D49                <1>     jge .done_save
   346                              <1> 
   347                              <1>     ; Setup segments
   348 0000466D BA00A0              <1>     mov dx, 0xA000
   349 00004670 8EDA                <1>     mov ds, dx                  ; DS = VGA segment
   350 00004672 0E                  <1>     push cs
   351 00004673 07                  <1>     pop es                      ; ES = our data segment
   352 00004674 81C7[6733]          <1>     add di, background_buffer   ; DI = buffer address
   353                              <1> 
   354                              <1>     ; Save 14 rows
   355 00004678 B91500              <1>     mov cx, BALLOON_HEIGHT
   356                              <1> 
   357                              <1> .save_row:
   358 0000467B 51                  <1>     push cx
   359 0000467C 50                  <1>     push ax
   360 0000467D 53                  <1>     push bx
   361                              <1> 
   362                              <1>     ; Check if row is visible
   363 0000467E 83FB00              <1>     cmp bx, 0
   364 00004681 7C22                <1>     jl .skip_row
   365 00004683 81FBC800            <1>     cmp bx, 200
   366 00004687 7D1C                <1>     jge .skip_row
   367                              <1> 
   368                              <1>     ; Calculate VGA offset: Y * 320 + X
   369 00004689 50                  <1>     push ax
   370 0000468A 89D8                <1>     mov ax, bx
   371 0000468C BA4001              <1>     mov dx, 320
   372 0000468F F7E2                <1>     mul dx
   373 00004691 5A                  <1>     pop dx
   374 00004692 01D0                <1>     add ax, dx                  ; AX = VGA offset
   375 00004694 89C6                <1>     mov si, ax
   376                              <1> 
   377                              <1>     ; Copy 16 pixels
   378 00004696 B91800              <1>     mov cx, BALLOON_WIDTH
   379                              <1> .copy_pixel:
   380 00004699 3E8A04              <1>     mov al, [ds:si]
