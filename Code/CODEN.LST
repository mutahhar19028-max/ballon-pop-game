   335                              <1> ; ------------------------------------------------------------
   336                              <1> ; clearScreen
   337                              <1> ; ------------------------------------------------------------
   338                              <1> ; INPUT:
   339                              <1> ;   [char_color] = Color value to fill screen (0-255)
   340                              <1> ; OUTPUT:
   341                              <1> ;   Entire screen filled with specified color
   342                              <1> ; EFFECT:
   343                              <1> ;   Uses REP STOSB to efficiently write 64000 bytes
   344                              <1> ;   Sets all VGA memory (0xA000:0000) to same color
   345                              <1> ; ------------------------------------------------------------
   346                              <1> clearScreen:
   347 0000019D 50                  <1>     push ax
   348 0000019E 51                  <1>     push cx
   349 0000019F 57                  <1>     push di
   350 000001A0 06                  <1>     push es
   351                              <1> 
   352 000001A1 B800A0              <1>     mov ax, VGA_SEGMENT
   353 000001A4 8EC0                <1>     mov es, ax
   354 000001A6 31FF                <1>     xor di, di
   355 000001A8 B900FA              <1>     mov cx, SCREEN_WIDTH * SCREEN_HEIGHT   ; 64000
   356 000001AB 30E4                <1>     xor ah, ah
   357 000001AD A0[0300]            <1>     mov al, [char_color]
   358 000001B0 F3AA                <1>     rep stosb
   359                              <1> 
   360 000001B2 07                  <1>     pop es
   361 000001B3 5F                  <1>     pop di
   362 000001B4 59                  <1>     pop cx
   363 000001B5 58                  <1>     pop ax
   364 000001B6 C3                  <1>     ret
   365                              <1> 
   366                              <1> ; ------------------------------------------------------------
   367                              <1> ; display_palette_wide
   368                              <1> ; ------------------------------------------------------------
   369                              <1> ; EFFECT:
   370                              <1> ;   Prints 256 colors as wide strips (160 pixels each)
   371                              <1> ; ------------------------------------------------------------
   372                              <1> display_palette_wide:
   373 000001B7 50                  <1>     push ax
   374 000001B8 53                  <1>     push bx             ; Preserve BX for inner loop counter
   375 000001B9 51                  <1>     push cx
   376 000001BA 57                  <1>     push di
   377 000001BB 06                  <1>     push es
   378                              <1>     
   379                              <1>     ; 1. Setup ES:DI to point to the start of VGA memory (A000:0000)
   380 000001BC B800A0              <1>     mov ax, 0A000h      ; VGA_SEGMENT
   381 000001BF 8EC0                <1>     mov es, ax
   382 000001C1 31FF                <1>     xor di, di          ; DI = 0 (start of video memory)
   383                              <1> 
   384                              <1>     ; 2. Setup Outer Loop (256 Colors)
   385 000001C3 B90001              <1>     mov cx, 256          ; CX = Outer loop counter (256 colors)
   386 000001C6 B000                <1>     mov al, 0         ; AL = Color Index (starts at 0)
   387                              <1> 
   388                              <1> outer_color_loop:
   389                              <1>     ; 3. Setup Inner Loop (160 Pixels)
   390 000001C8 BB00FA              <1>     mov bx, 320*200         ; BX = Inner loop counter (160 pixels wide)
   391                              <1> 
   392                              <1> inner_pixel_loop:
   393 000001CB AA                  <1>     stosb               ; Write AL (current color) to [ES:DI], then DI = DI + 1
   394 000001CC 4B                  <1>     dec bx              ; BX = BX - 1
   395 000001CD 75FC                <1>     jnz inner_pixel_loop; Continue inner loop until 160 pixels are written
   396                              <1> 
   397 000001CF 50                  <1>     push ax
   398 000001D0 B80000              <1>     mov ax, 0
   399 000001D3 CD16                <1>     int 16h
   400 000001D5 58                  <1>     pop ax
   401                              <1> 
   402                              <1>     ; 4. Increment Color Index
   403 000001D6 FEC0                <1>     inc al              ; AL = AL + 1 (move to the next color)
   404                              <1> 
   405                              <1>     ; 5. Continue Outer Loop
   406 000001D8 E2EE                <1>     loop outer_color_loop ; Decrement CX, jump to outer_color_loop if CX != 0
   407                              <1> 
   408                              <1>     ; Restore registers
   409 000001DA 07                  <1>     pop es
   410 000001DB 5F                  <1>     pop di
   411 000001DC 59                  <1>     pop cx
   412 000001DD 5B                  <1>     pop bx
   413 000001DE 58                  <1>     pop ax
   414 000001DF C3                  <1>     ret
   415                              <1> 
   416                              <1> 
   417                              <1> ; ======================================================================
   418                              <1> ; drawText  (CX=x, DX=y, SI=ptr, BL=color, BH=scale)
   419                              <1> ; ======================================================================
   420                              <1> drawText:
   421 000001E0 50                  <1>     push ax
   422 000001E1 53                  <1>     push bx
   423 000001E2 51                  <1>     push cx
   424 000001E3 52                  <1>     push dx
   425 000001E4 56                  <1>     push si
   426 000001E5 57                  <1>     push di
   427 000001E6 55                  <1>     push bp
   428                              <1> 
   429 000001E7 890E[7305]          <1>     mov [dt_x_pos], cx
   430 000001EB 8916[7505]          <1>     mov [dt_y_pos], dx
   431 000001EF 881E[7705]          <1>     mov [dt_color], bl
   432 000001F3 883E[7805]          <1>     mov [dt_scale], bh
   433                              <1> 
   434                              <1> .next:
   435 000001F7 AC                  <1>     lodsb
   436 000001F8 08C0                <1>     or al, al
   437 000001FA 7420                <1>     jz .done
   438 000001FC 3C20                <1>     cmp al, ' '
   439 000001FE 7405                <1>     je .space
   440                              <1> 
   441 00000200 56                  <1>     push si
   442 00000201 E82000              <1>     call drawChar
