   914                              <1> ; ------------------------------------------------------------
   915                              <1> ; clearScreen320x200
   916                              <1> ; Clears entire 320x200 VGA screen to specified color
   917                              <1> ; INPUT: AL = Color value (0-255)
   918                              <1> ; Uses BIOS interrupt for compatibility
   919                              <1> ; ------------------------------------------------------------
   920                              <1> clearScreen320x200:
   921 00000502 50                  <1>     push ax
   922 00000503 53                  <1>     push bx
   923 00000504 51                  <1>     push cx
   924 00000505 52                  <1>     push dx
   925 00000506 57                  <1>     push di
   926 00000507 06                  <1>     push es
   927                              <1> 
   928                              <1>     ; Method 1: Direct VGA memory write (faster)
   929 00000508 BB00A0              <1>     mov bx, VGA_SEGMENT
   930 0000050B 8EC3                <1>     mov es, bx
   931 0000050D 31FF                <1>     xor di, di
   932 0000050F B900FA              <1>     mov cx, SCREEN_WIDTH * SCREEN_HEIGHT   ; 64000
   933 00000512 88C4                <1>     mov ah, al              ; Duplicate color in AH
   934 00000514 F3AA                <1>     rep stosb
   935                              <1> 
   936 00000516 07                  <1>     pop es
   937 00000517 5F                  <1>     pop di
   938 00000518 5A                  <1>     pop dx
   939 00000519 59                  <1>     pop cx
   940 0000051A 5B                  <1>     pop bx
   941 0000051B 58                  <1>     pop ax
   942 0000051C C3                  <1>     ret
   943                              <1> 
   944                              <1> ; ------------------------------------------------------------
   945                              <1> ; clearScreenBIOS
   946                              <1> ; Alternative: Uses BIOS scroll to clear screen (slower but safer)
   947                              <1> ; INPUT: AL = Color value
   948                              <1> ; ------------------------------------------------------------
   949                              <1> clearScreenBIOS:
   950 0000051D 50                  <1>     push ax
   951 0000051E 53                  <1>     push bx
   952 0000051F 51                  <1>     push cx
   953 00000520 52                  <1>     push dx
   954                              <1> 
   955                              <1>     ; BIOS: Scroll window (clear screen)
   956 00000521 B406                <1>     mov ah, 0x06        ; Scroll up function
   957 00000523 B000                <1>     mov al, 0           ; Clear entire window
   958 00000525 B700                <1>     mov bh, 0           ; Attribute (ignored in mode 13h)
   959 00000527 B90000              <1>     mov cx, 0           ; Upper left (0,0)
   960 0000052A BA13C8              <1>     mov dx, 0xC813      ; Lower right (200, 320 in rows/cols)
   961 0000052D CD10                <1>     int 0x10
   962                              <1> 
   963 0000052F 5A                  <1>     pop dx
   964 00000530 59                  <1>     pop cx
   965 00000531 5B                  <1>     pop bx
   966 00000532 58                  <1>     pop ax
   967 00000533 C3                  <1>     ret
   968                              <1> 
   969                              <1> ; ------------------------------------------------------------
   970                              <1> ; setVideoMode13h
   971                              <1> ; Sets VGA mode 320x200x256 using BIOS interrupt
   972                              <1> ; ------------------------------------------------------------
   973                              <1> setVideoMode13h:
   974 00000534 50                  <1>     push ax
   975 00000535 B81300              <1>     mov ax, 0x0013
   976 00000538 CD10                <1>     int 0x10
   977 0000053A 58                  <1>     pop ax
   978 0000053B C3                  <1>     ret
   979                              <1> 
   980                              <1> ; ------------------------------------------------------------
   981                              <1> ; setTextMode
   982                              <1> ; Returns to text mode 80x25
   983                              <1> ; ------------------------------------------------------------
   984                              <1> setTextMode:
   985 0000053C 50                  <1>     push ax
   986 0000053D B80300              <1>     mov ax, 0x0003
   987 00000540 CD10                <1>     int 0x10
   988 00000542 58                  <1>     pop ax
   989 00000543 C3                  <1>     ret
