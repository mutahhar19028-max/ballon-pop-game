   108                              <1> ; ------------------------------------------------------------
   109                              <1> ; updateBalloons
   110                              <1> ; ------------------------------------------------------------
   111                              <1> updateBalloons:
   112 000038C8 50                  <1>     push ax
   113 000038C9 53                  <1>     push bx
   114 000038CA 51                  <1>     push cx
   115 000038CB 52                  <1>     push dx
   116                              <1> 
   117                              <1>     ; Restore old backgrounds first
   118 000038CC E8CB00              <1>     call restoreAllBackgrounds
   119                              <1> 
   120                              <1>     ; Check spawn timer
   121 000038CF FF06[9632]          <1>     inc word [spawn_timer]
   122 000038D3 A1[9632]            <1>     mov ax, [spawn_timer]
   123 000038D6 83F828              <1>     cmp ax, SPAWN_DELAY
   124 000038D9 7209                <1>     jb .skip_spawn
   125                              <1>     
   126 000038DB E8AA01              <1>     call spawnBalloon
   127 000038DE C706[9632]0000      <1>     mov word [spawn_timer], 0
   128                              <1> 
   129                              <1> .skip_spawn:
   130                              <1>     ; Check movement timer (move every N frames)
   131 000038E4 FE06[9A32]          <1>     inc byte [movement_counter]
   132 000038E8 A0[9A32]            <1>     mov al, [movement_counter]
   133 000038EB 3C64                <1>     cmp al, MOVEMENT_DELAY
   134 000038ED 7208                <1>     jb .skip_move
   135                              <1>     
   136 000038EF C606[9A32]00        <1>     mov byte [movement_counter], 0
   137 000038F4 E8ED01              <1>     call moveBalloons           ; Only move every MOVEMENT_DELAY frames
   138                              <1>     
   139                              <1> .skip_move:
   140                              <1>     ; Remove off-screen balloons
   141 000038F7 E80B02              <1>     call removeOffscreenBalloons
   142                              <1> 
   143                              <1>     ; Save new backgrounds
   144 000038FA E88100              <1>     call saveAllBackgrounds
   145                              <1> 
   146 000038FD 5A                  <1>     pop dx
   147 000038FE 59                  <1>     pop cx
   148 000038FF 5B                  <1>     pop bx
   149 00003900 58                  <1>     pop ax
   150 00003901 C3                  <1>     ret
   151                              <1> 
   152                              <1> 
