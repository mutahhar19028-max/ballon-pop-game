    19                                  ; --------------------------------------------------------------------------
    20                                  ; PROGRAM ENTRY
    21                                  ; --------------------------------------------------------------------------
    22                                  start:
    23                                      ; Set VGA 320x200x256 mode
    24 000031E2 B81300                      mov ax, 0x0013
    25 000031E5 CD10                        int 0x10
    26                                  
    27                                      ; Initialize game state
    28 000031E7 C606[0106]00                mov byte [game_state], STATE_MENU
    29                                  
    30                                  ; --------------------------------------------------------------------------
    31                                  ; MAIN GAME LOOP
    32                                  ; --------------------------------------------------------------------------
    33                                  game_loop:
    34 000031EC A0[0106]                    mov al, [game_state]
    35                                  
    36 000031EF E80BD3                      call clearScreen320x200
    37 000031F2 E890D4                      call showBackground320x200
    38                                      
    39 000031F5 3C00                        cmp al, STATE_MENU
    40 000031F7 7412                        je .handle_menu
    41 000031F9 3C01                        cmp al, STATE_GAME
    42 000031FB 741D                        je .handle_game
    43 000031FD 3C02                        cmp al, STATE_PAUSE
    44 000031FF 7427                        je .handle_pause
    45 00003201 3C03                        cmp al, STATE_GAMEOVER
    46 00003203 742D                        je .handle_gameover
    47 00003205 3C04                        cmp al, STATE_EXIT
    48 00003207 7450                        je .exit_program
    49                                      
    50 00003209 EBE1                        jmp game_loop           ; Safety fallback
    51                                  
    52                                  .handle_menu:
    53 0000320B E8CDF9                      call drawMainMenu
    54 0000320E E81CF8                      call handleMainMenuInput    ; Returns selection in AL
    55                                      
    56 00003211 3CFF                        cmp al, 0xFF                ; ESC pressed?
    57 00003213 7444                        je .exit_program
    58                                      
    59 00003215 E8C2F8                      call executeMenuChoice
    60 00003218 EBD2                        jmp game_loop
    61                                  
    62                                  .handle_game:
    63                                      ; TODO: Main game logic goes here
    64 0000321A E899FA                      call showMainGameScreen
    65                                      
    66                                      ; Temporary: Press any key to go to game over
    67 0000321D B400                        mov ah, 0x00
    68 0000321F CD16                        int 0x16
    69 00003221 C606[0106]03                mov byte [game_state], STATE_GAMEOVER
    70 00003226 EBC4                        jmp game_loop
    71                                  
    72                                  .handle_pause:
    73 00003228 E829FD                      call showPauseScreen
    74                                      ; TODO: Handle pause input
    75 0000322B C606[0106]01                mov byte [game_state], STATE_GAME
    76 00003230 EBBA                        jmp game_loop
    77                                  
    78                                  .handle_gameover:
    79 00003232 E841FE                      call showGameOverScreen
    80                                      
    81                                      ; Wait for R (Retry) or Q (Quit)
    82 00003235 B400                        mov ah, 0x00
    83 00003237 CD16                        int 0x16
    84                                      
    85 00003239 3C72                        cmp al, 'r'
    86 0000323B 740E                        je .retry
    87 0000323D 3C52                        cmp al, 'R'
    88 0000323F 740A                        je .retry
    89 00003241 3C71                        cmp al, 'q'
    90 00003243 740D                        je .quit_to_menu
    91 00003245 3C51                        cmp al, 'Q'
    92 00003247 7409                        je .quit_to_menu
    93 00003249 EBE7                        jmp .handle_gameover
    94                                  
    95                                  .retry:
    96 0000324B C606[0106]01                mov byte [game_state], STATE_GAME
    97 00003250 EB9A                        jmp game_loop
    98                                  
    99                                  .quit_to_menu:
   100 00003252 C606[0106]00                mov byte [game_state], STATE_MENU
   101 00003257 EB93                        jmp game_loop
   102                                  
   103                                  .exit_program:
   104                                      ; Return to text mode
   105 00003259 B80300                      mov ax, 0x0003
   106 0000325C CD10                        int 0x10
   107                                      
   108                                      ; Exit to DOS
   109 0000325E B8004C                      mov ax, 0x4C00
   110 00003261 CD21                        int 0x21
