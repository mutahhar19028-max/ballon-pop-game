   297                              <1> restoreAllBackgrounds:
   298 000045CF 50                  <1>     push ax
   299 000045D0 51                  <1>     push cx
   300 000045D1 56                  <1>     push si
   301                              <1> 
   302 000045D2 BE[6A32]            <1>     mov si, balloon_array
   303 000045D5 B90900              <1>     mov cx, MAX_BALLOONS
