   149 00002E96 BA1400              <1>     mov dx, TIMER_PANEL_HEIGHT
   150 00002E99 8B36[0700]          <1>     mov si, TIMER_PANEL_COLOR
   151 00002E9D 8B3E[0800]          <1>     mov di, TIMER_BORDER_COLOR
   152 00002EA1 E870D1              <1>     call drawRoundedRect
   153                              <1> 
   154                              <1>     ; Draw "TIME:" label
   155 00002EA4 B9D900              <1>     mov cx, TIMER_TEXT_X
   156 00002EA7 BA0A00              <1>     mov dx, TIMER_TEXT_Y
   157 00002EAA BE[C02E]            <1>     mov si, timer_label_text
   158 00002EAD 8A1E[1100]          <1>     mov bl, [dark_brown]
   159 00002EB1 B701                <1>     mov bh, 1
   160 00002EB3 E82AD3              <1>     call drawText
   161                              <1> 
   162                              <1>     ; Draw dynamic timer value (MM:SS)
   163 00002EB6 E80D00              <1>     call drawTimerValue
   164                              <1> 
