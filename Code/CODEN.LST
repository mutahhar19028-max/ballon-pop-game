    11                                  %include "Code\timer.asm"           ; Timer system
     1                              <1> ; ============================================================
     2                              <1> ; timer.asm — IRQ0-based Timer System (1 second updates)
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> ; ------------------------------------------------------------
     6                              <1> ; TIMER CONFIGURATION
     7                              <1> ; ------------------------------------------------------------
     8                              <1> %define PIT_CHANNEL0    0x40    ; PIT channel 0 data port
     9                              <1> %define PIT_COMMAND     0x43    ; PIT command port
    10                              <1> %define PIC_COMMAND     0x20    ; 8259 PIC command port
    11                              <1> %define PIC_DATA        0x21    ; 8259 PIC data port
    12                              <1> 
    13                              <1> %define TICKS_PER_SEC   18      ; Default: 18.2 Hz, we'll use 18 for simplicity
    14                              <1> %define GAME_TIME_SEC   120     ; 2 minutes = 120 seconds
    15                              <1> 
    16                              <1> ; ------------------------------------------------------------
    17                              <1> ; TIMER VARIABLES
    18                              <1> ; ------------------------------------------------------------
    19 000005FA 7800                <1> timer_seconds       dw GAME_TIME_SEC    ; Remaining seconds (120)
    20 000005FC 02                  <1> timer_minutes       db 2                ; Display minutes
    21 000005FD 00                  <1> timer_display_sec   db 0                ; Display seconds
    22 000005FE 00                  <1> timer_ticks         db 0                ; Tick counter (0-17)
    23 000005FF 00000000            <1> old_timer_vector    dd 0                ; Original IRQ0 handler address
    24 00000603 00                  <1> timer_active        db 0                ; Timer running flag
    25                              <1> 
    26                              <1> ; ------------------------------------------------------------
    27                              <1> ; installTimerISR
    28                              <1> ; Hooks IRQ0 (INT 08h) to custom timer handler
    29                              <1> ; Saves original vector for restoration
    30                              <1> ; ------------------------------------------------------------
    31                              <1> installTimerISR:
    32 00000604 50                  <1>     push ax
    33 00000605 53                  <1>     push bx
    34 00000606 51                  <1>     push cx
    35 00000607 52                  <1>     push dx
    36 00000608 06                  <1>     push es
    37                              <1> 
    38                              <1>     ; Save old INT 08h vector
    39 00000609 B80835              <1>     mov ax, 0x3508          ; AH=35h (Get interrupt vector), AL=08h
    40 0000060C CD21                <1>     int 0x21
    41 0000060E 891E[FF05]          <1>     mov word [old_timer_vector], bx
    42 00000612 8C06[0106]          <1>     mov word [old_timer_vector+2], es
    43                              <1> 
    44                              <1>     ; Install new handler
    45 00000616 1E                  <1>     push ds
    46 00000617 8CC8                <1>     mov ax, cs
    47 00000619 8ED8                <1>     mov ds, ax
    48 0000061B BA[5406]            <1>     mov dx, timerISR
    49 0000061E B80825              <1>     mov ax, 0x2508          ; AH=25h (Set interrupt vector), AL=08h
    50 00000621 CD21                <1>     int 0x21
    51 00000623 1F                  <1>     pop ds
    52                              <1> 
    53                              <1>     ; Initialize timer variables
    54 00000624 C706[FA05]7800      <1>     mov word [timer_seconds], GAME_TIME_SEC
    55 0000062A C606[FC05]02        <1>     mov byte [timer_minutes], 2
    56 0000062F C606[FD05]00        <1>     mov byte [timer_display_sec], 0
    57 00000634 C606[FE05]00        <1>     mov byte [timer_ticks], 0
    58 00000639 C606[0306]01        <1>     mov byte [timer_active], 1
    59                              <1> 
    60 0000063E 07                  <1>     pop es
    61 0000063F 5A                  <1>     pop dx
    62 00000640 59                  <1>     pop cx
    63 00000641 5B                  <1>     pop bx
    64 00000642 58                  <1>     pop ax
    65 00000643 C3                  <1>     ret
    66                              <1> 
    67                              <1> ; ------------------------------------------------------------
    68                              <1> ; restoreTimerISR
    69                              <1> ; Restores original IRQ0 handler
    70                              <1> ; Call before program exit!
    71                              <1> ; ------------------------------------------------------------
    72                              <1> restoreTimerISR:
    73 00000644 50                  <1>     push ax
    74 00000645 52                  <1>     push dx
    75 00000646 1E                  <1>     push ds
    76                              <1> 
    77                              <1>     ; Restore old INT 08h vector
    78 00000647 C516[FF05]          <1>     lds dx, [old_timer_vector]
    79 0000064B B80825              <1>     mov ax, 0x2508
    80 0000064E CD21                <1>     int 0x21
    81                              <1> 
    82 00000650 1F                  <1>     pop ds
    83 00000651 5A                  <1>     pop dx
    84 00000652 58                  <1>     pop ax
    85 00000653 C3                  <1>     ret
    86                              <1> 
    87                              <1> ; ------------------------------------------------------------
    88                              <1> ; timerISR
    89                              <1> ; Custom IRQ0 handler - called ~18.2 times per second
    90                              <1> ; Decrements timer every 18 ticks (approximately 1 second)
    91                              <1> ; ------------------------------------------------------------
    92                              <1> timerISR:
    93 00000654 50                  <1>     push ax
    94 00000655 53                  <1>     push bx
    95 00000656 51                  <1>     push cx
    96 00000657 52                  <1>     push dx
    97 00000658 56                  <1>     push si
    98 00000659 57                  <1>     push di
    99 0000065A 1E                  <1>     push ds
   100 0000065B 06                  <1>     push es
   101                              <1> 
   102 0000065C 8306[E405]02        <1>     add word[current_score], 2
   103                              <1> 
   104                              <1>     ; Set DS to our data segment
   105 00000661 8CC8                <1>     mov ax, cs
   106 00000663 8ED8                <1>     mov ds, ax
   107                              <1> 
   108                              <1>     ; Check if timer is active
   109 00000665 803E[0306]01        <1>     cmp byte [timer_active], 1
   110 0000066A 751E                <1>     jne .chain_to_old
   111                              <1> 
   112                              <1>     ; Increment tick counter
   113 0000066C FE06[FE05]          <1>     inc byte [timer_ticks]
   114 00000670 803E[FE05]12        <1>     cmp byte [timer_ticks], TICKS_PER_SEC
   115 00000675 7213                <1>     jb .chain_to_old        ; Not 1 second yet
   116                              <1> 
   117                              <1>     ; Reset tick counter
   118 00000677 C606[FE05]00        <1>     mov byte [timer_ticks], 0
   119                              <1> 
   120                              <1>     ; Decrement seconds
   121 0000067C 833E[FA05]00        <1>     cmp word [timer_seconds], 0
   122 00000681 7414                <1>     je .timer_expired       ; Already at 0
   123                              <1> 
   124 00000683 FF0E[FA05]          <1>     dec word [timer_seconds]
   125                              <1> 
   126                              <1>     ; Update display format (MM:SS)
   127 00000687 E81400              <1>     call updateTimerDisplay
   128                              <1> 
   129                              <1> .chain_to_old:
   130                              <1>     ; Send EOI to PIC
   131 0000068A B020                <1>     mov al, 0x20
   132 0000068C E620                <1>     out PIC_COMMAND, al
   133                              <1> 
   134 0000068E 07                  <1>     pop es
   135 0000068F 1F                  <1>     pop ds
   136 00000690 5F                  <1>     pop di
   137 00000691 5E                  <1>     pop si
   138 00000692 5A                  <1>     pop dx
   139 00000693 59                  <1>     pop cx
   140 00000694 5B                  <1>     pop bx
   141 00000695 58                  <1>     pop ax
   142 00000696 CF                  <1>     iret                    ; Return from interrupt
   143                              <1> 
   144                              <1> .timer_expired:
   145                              <1>     ; Timer reached 0 - trigger game over
   146 00000697 C606[0306]00        <1>     mov byte [timer_active], 0
   147                              <1>     ; Game state will be checked in main loop
   148 0000069C EBEC                <1>     jmp .chain_to_old
   149                              <1> 
   150                              <1> ; ------------------------------------------------------------
   151                              <1> ; updateTimerDisplay
   152                              <1> ; Converts timer_seconds to MM:SS format
   153                              <1> ; Updates timer_minutes and timer_display_sec
   154                              <1> ; ------------------------------------------------------------
   155                              <1> updateTimerDisplay:
   156 0000069E 50                  <1>     push ax
   157 0000069F 53                  <1>     push bx
   158 000006A0 52                  <1>     push dx
   159                              <1> 
   160                              <1>     ; Get total seconds
   161 000006A1 A1[FA05]            <1>     mov ax, [timer_seconds]
   162                              <1> 
   163                              <1>     ; Divide by 60 to get minutes
   164 000006A4 31D2                <1>     xor dx, dx
   165 000006A6 BB3C00              <1>     mov bx, 60
   166 000006A9 F7F3                <1>     div bx                  ; AX = minutes, DX = seconds
   167                              <1> 
   168                              <1>     ; Store results
   169 000006AB A2[FC05]            <1>     mov [timer_minutes], al
   170 000006AE 8816[FD05]          <1>     mov [timer_display_sec], dl
   171                              <1> 
   172 000006B2 5A                  <1>     pop dx
   173 000006B3 5B                  <1>     pop bx
   174 000006B4 58                  <1>     pop ax
   175 000006B5 C3                  <1>     ret
   176                              <1> 
   177                              <1> ; ------------------------------------------------------------
   178                              <1> ; resetTimer
   179                              <1> ; Resets timer to initial value (120 seconds)
   180                              <1> ; ------------------------------------------------------------
   181                              <1> resetTimer:
   182 000006B6 50                  <1>     push ax
   183                              <1> 
   184 000006B7 C706[FA05]7800      <1>     mov word [timer_seconds], GAME_TIME_SEC
   185 000006BD C606[FC05]02        <1>     mov byte [timer_minutes], 2
   186 000006C2 C606[FD05]00        <1>     mov byte [timer_display_sec], 0
   187 000006C7 C606[FE05]00        <1>     mov byte [timer_ticks], 0
   188 000006CC C606[0306]01        <1>     mov byte [timer_active], 1
   189                              <1> 
   190 000006D1 58                  <1>     pop ax
   191 000006D2 C3                  <1>     ret
   192                              <1> 
   193                              <1> ; ------------------------------------------------------------
   194                              <1> ; pauseTimer
   195                              <1> ; Pauses the timer (stops decrementing)
   196                              <1> ; ------------------------------------------------------------
   197                              <1> pauseTimer:
   198 000006D3 C606[0306]00        <1>     mov byte [timer_active], 0
   199 000006D8 C3                  <1>     ret
   200                              <1> 
   201                              <1> ; ------------------------------------------------------------
   202                              <1> ; resumeTimer
   203                              <1> ; Resumes the timer (continues decrementing)
   204                              <1> ; ------------------------------------------------------------
   205                              <1> resumeTimer:
   206 000006D9 C606[0306]01        <1>     mov byte [timer_active], 1
   207 000006DE C3                  <1>     ret
   208                              <1> 
   209                              <1> ; ------------------------------------------------------------
   210                              <1> ; isTimerExpired
   211                              <1> ; Returns: AL = 1 if timer expired, 0 otherwise
   212                              <1> ; ------------------------------------------------------------
   213                              <1> isTimerExpired:
   214 000006DF 53                  <1>     push bx
   215                              <1>     
   216 000006E0 B000                <1>     mov al, 0
   217 000006E2 833E[FA05]00        <1>     cmp word [timer_seconds], 0
   218 000006E7 7502                <1>     jne .not_expired
   219 000006E9 B001                <1>     mov al, 1
   220                              <1> 
   221                              <1> .not_expired:
   222 000006EB 5B                  <1>     pop bx
   223 000006EC C3                  <1>     ret
   224                              <1> 
   225                              <1> ; ------------------------------------------------------------
   226                              <1> ; getTimerString
   227                              <1> ; Converts timer to "MM:SS" string format
   228                              <1> ; INPUT: SI = pointer to 6-byte buffer (output)
   229                              <1> ; OUTPUT: Buffer filled with "MM:SS\0"
   230                              <1> ; ------------------------------------------------------------
   231                              <1> getTimerString:
   232 000006ED 50                  <1>     push ax
   233 000006EE 53                  <1>     push bx
   234 000006EF 51                  <1>     push cx
   235 000006F0 52                  <1>     push dx
   236 000006F1 57                  <1>     push di
   237                              <1> 
   238 000006F2 89F7                <1>     mov di, si              ; DI = output buffer
   239                              <1> 
   240                              <1>     ; Convert minutes to ASCII
   241 000006F4 30E4                <1>     xor ah, ah
   242 000006F6 A0[FC05]            <1>     mov al, [timer_minutes]
   243 000006F9 B30A                <1>     mov bl, 10
   244 000006FB F6F3                <1>     div bl                  ; AH = ones, AL = tens
   245 000006FD 0430                <1>     add al, '0'
   246 000006FF 8805                <1>     mov [di], al
   247 00000701 47                  <1>     inc di
   248 00000702 88E0                <1>     mov al, ah
   249 00000704 0430                <1>     add al, '0'
   250 00000706 8805                <1>     mov [di], al
   251 00000708 47                  <1>     inc di
   252                              <1> 
   253                              <1>     ; Add colon
   254 00000709 C6053A              <1>     mov byte [di], ':'
   255 0000070C 47                  <1>     inc di
   256                              <1> 
   257                              <1>     ; Convert seconds to ASCII
   258 0000070D 30E4                <1>     xor ah, ah
   259 0000070F A0[FD05]            <1>     mov al, [timer_display_sec]
   260 00000712 B30A                <1>     mov bl, 10
   261 00000714 F6F3                <1>     div bl                  ; AH = ones, AL = tens
   262 00000716 0430                <1>     add al, '0'
   263 00000718 8805                <1>     mov [di], al
   264 0000071A 47                  <1>     inc di
   265 0000071B 88E0                <1>     mov al, ah
   266 0000071D 0430                <1>     add al, '0'
   267 0000071F 8805                <1>     mov [di], al
   268 00000721 47                  <1>     inc di
   269                              <1> 
   270                              <1>     ; Null terminator
   271 00000722 C60500              <1>     mov byte [di], 0
   272                              <1> 
   273 00000725 5F                  <1>     pop di
   274 00000726 5A                  <1>     pop dx
   275 00000727 59                  <1>     pop cx
   276 00000728 5B                  <1>     pop bx
   277 00000729 58                  <1>     pop ax
   278 0000072A C3                  <1>     ret
    12                                  %include "Code\sound.asm"
     1                              <1> ; sound.asm — PC Speaker victory sound
     2                              <1> ; Compatible with NASM (COM or EXE)
     3                              <1> 
     4                              <1> melodyFreqs:
     5 0000072B 20038403E8034C04B0- <1>     dw 800, 900, 1000, 1100, 1200, 1300, 1400, 1500
     5 00000734 0414057805DC05      <1>
     6 0000073B DC0578051405B0044C- <1>     dw 1500, 1400, 1300, 1200, 1100, 1000, 900, 800
     6 00000744 04E80384032003      <1>
     7                              <1> numNotes    equ 16
     8 0000074B 0200                <1> tempo       dw 2
     9 0000074D DC341200            <1> pit_constant: dd 1193180    ; Store as 32-bit constant
    10                              <1> 
    11                              <1> ; ---------------------------------------
    12                              <1> ; playCompletionSound — main entry
    13                              <1> ; ---------------------------------------
    14                              <1> playCompletionSound:
    15 00000751 50                  <1>     push ax
    16 00000752 53                  <1>     push bx
    17 00000753 51                  <1>     push cx
    18 00000754 52                  <1>     push dx
    19 00000755 56                  <1>     push si
    20                              <1> 
    21 00000756 BE[2B07]            <1>     mov si, melodyFreqs
    22 00000759 B91000              <1>     mov cx, numNotes
    23                              <1> .loopNotes:
    24 0000075C AD                  <1>     lodsw                  ; AX = frequency
    25 0000075D 09C0                <1>     or  ax, ax
    26 0000075F 7405                <1>     jz  .done
    27 00000761 E80800              <1>     call playTone
    28 00000764 E2F6                <1>     loop .loopNotes
    29                              <1> 
    30                              <1> .done:
    31 00000766 5E                  <1>     pop si
    32 00000767 5A                  <1>     pop dx
    33 00000768 59                  <1>     pop cx
    34 00000769 5B                  <1>     pop bx
    35 0000076A 58                  <1>     pop ax
    36 0000076B C3                  <1>     ret
    37                              <1> 
    38                              <1> ; ---------------------------------------
    39                              <1> ; playTone — AX = frequency (Hz)
    40                              <1> ; ---------------------------------------
    41                              <1> playTone:
    42 0000076C 50                  <1>     push ax
    43 0000076D 53                  <1>     push bx
    44 0000076E 51                  <1>     push cx
    45 0000076F 52                  <1>     push dx
    46                              <1> 
    47 00000770 89C3                <1>     mov bx, ax              ; Save frequency in BX
    48                              <1>     
    49                              <1>     ; Load 1193180 into DX:AX
    50 00000772 A1[4D07]            <1>     mov ax, word [pit_constant]      ; Low word
    51 00000775 8B16[4F07]          <1>     mov dx, word [pit_constant + 2]  ; High word
    52                              <1>     
    53                              <1>     ; Divide DX:AX by BX -> quotient in AX
    54 00000779 F7F3                <1>     div bx                  ; DX:AX / BX = AX (remainder in DX)
    55 0000077B 89C3                <1>     mov bx, ax              ; BX = divisor
    56                              <1> 
    57                              <1>     ; Program PIT channel 2
    58 0000077D B0B6                <1>     mov al, 0xB6
    59 0000077F E643                <1>     out 0x43, al
    60 00000781 89D8                <1>     mov ax, bx
    61 00000783 E642                <1>     out 0x42, al            ; low byte
    62 00000785 88E0                <1>     mov al, ah
    63 00000787 E642                <1>     out 0x42, al            ; high byte
    64                              <1> 
    65                              <1>     ; Enable speaker
    66 00000789 E461                <1>     in al, 0x61
    67 0000078B 0C03                <1>     or al, 3
    68 0000078D E661                <1>     out 0x61, al
    69                              <1> 
    70                              <1>     ; Hold tone
    71 0000078F E80B00              <1>     call toneDelay
    72                              <1> 
    73                              <1>     ; Disable speaker
    74 00000792 E461                <1>     in al, 0x61
    75 00000794 24FC                <1>     and al, 0xFC
    76 00000796 E661                <1>     out 0x61, al
    77                              <1> 
    78 00000798 5A                  <1>     pop dx
    79 00000799 59                  <1>     pop cx
    80 0000079A 5B                  <1>     pop bx
    81 0000079B 58                  <1>     pop ax
    82 0000079C C3                  <1>     ret
    83                              <1> 
    84                              <1> ; ---------------------------------------
    85                              <1> ; toneDelay — simple busy wait
    86                              <1> ; ---------------------------------------
    87                              <1> toneDelay:
    88 0000079D 51                  <1>     push cx
    89 0000079E 52                  <1>     push dx
    90 0000079F 8B16[4B07]          <1>     mov dx, [tempo]
    91                              <1> .delayOuter:
    92 000007A3 B9FFAF              <1>     mov cx, 0xAFFF
    93                              <1> .delayInner:
    94 000007A6 E2FE                <1>     loop .delayInner
    95 000007A8 4A                  <1>     dec dx
    96 000007A9 75F8                <1>     jnz .delayOuter
    97 000007AB 5A                  <1>     pop dx
    98 000007AC 59                  <1>     pop cx
    99 000007AD C3                  <1>     ret
    13                                  %include "Code\show_bg.asm"
     1                              <1> ; ============================================================
     2                              <1> ; show_bg.asm — Draws VGA 320x200x256 background with palette
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> %define MODE_VGA13H  0x0013
     6                              <1> %define VIDEO_SEG    0xA000
     7                              <1> %define SCREEN_SIZE  64000
     8                              <1> %define CHUNK_SIZE   8192
     9                              <1> 
    10                              <1> ; ------------------------------------------------------------
    11                              <1> ; PUBLIC: showBackground320x200
    12                              <1> ; Loads and displays final.raw using vga.bin palette
    13                              <1> ; Palette is loaded only on first call.
    14                              <1> ; ------------------------------------------------------------
    15                              <1> showBackground320x200:
    16 000007AE 50                  <1>     push ax
    17 000007AF 53                  <1>     push bx
    18 000007B0 51                  <1>     push cx
    19 000007B1 52                  <1>     push dx
    20 000007B2 56                  <1>     push si
    21 000007B3 57                  <1>     push di
    22 000007B4 1E                  <1>     push ds
    23 000007B5 06                  <1>     push es
    24                              <1> 
    25                              <1>     ; If palette not loaded yet -> load it once
    26 000007B6 A0[622B]            <1>     mov al, [palette_loaded]
    27 000007B9 3C01                <1>     cmp al, 1
    28 000007BB 7408                <1>     je .skip_palette
    29 000007BD E84E00              <1>     call load_palette
    30 000007C0 C606[622B]01        <1>     mov byte [palette_loaded], 1
    31                              <1> 
    32                              <1> .skip_palette:
    33                              <1>     ; --------------------------------------------------------
    34                              <1>     ; Load and display background image from "final.raw"
    35                              <1>     ; (same behavior as before)
    36                              <1>     ; --------------------------------------------------------
    37 000007C5 B800A0              <1>     mov ax, VIDEO_SEG
    38 000007C8 8EC0                <1>     mov es, ax
    39 000007CA 31FF                <1>     xor di, di
    40                              <1> 
    41                              <1>     ; Open RAW file (read-only)
    42 000007CC 8D16[4A08]          <1>     lea dx, [filename]
    43 000007D0 B43D                <1>     mov ah, 0x3D
    44 000007D2 30C0                <1>     xor al, al
    45 000007D4 CD21                <1>     int 0x21
    46 000007D6 722D                <1>     jc .cleanup
    47 000007D8 89C3                <1>     mov bx, ax                  ; BX = file handle
    48                              <1> 
    49                              <1> .read_loop:
    50                              <1>     ; Read chunk into buffer
    51 000007DA B43F                <1>     mov ah, 0x3F
    52 000007DC B90020              <1>     mov cx, CHUNK_SIZE
    53 000007DF 8D16[6208]          <1>     lea dx, [buffer]
    54 000007E3 CD21                <1>     int 0x21
    55 000007E5 721A                <1>     jc .close_file
    56 000007E7 09C0                <1>     or ax, ax
    57 000007E9 7416                <1>     jz .close_file              ; EOF reached
    58                              <1> 
    59                              <1>     ; Copy to VGA memory (use ES:DI for video, DS:SI for buffer)
    60 000007EB 1E                  <1>     push ds
    61 000007EC BE[6208]            <1>     mov si, buffer
    62 000007EF 89C1                <1>     mov cx, ax
    63                              <1> .copy_loop:
    64 000007F1 8A04                <1>     mov al, [si]
    65 000007F3 268805              <1>     mov [es:di], al
    66 000007F6 46                  <1>     inc si
    67 000007F7 47                  <1>     inc di
    68 000007F8 E2F7                <1>     loop .copy_loop
    69 000007FA 1F                  <1>     pop ds
    70                              <1> 
    71 000007FB 81FF00FA            <1>     cmp di, SCREEN_SIZE
    72 000007FF 72D9                <1>     jb .read_loop
    73                              <1> 
    74                              <1> .close_file:
    75 00000801 B43E                <1>     mov ah, 0x3E
    76 00000803 CD21                <1>     int 0x21
    77                              <1> 
    78                              <1> .cleanup:
    79 00000805 07                  <1>     pop es
    80 00000806 1F                  <1>     pop ds
    81 00000807 5F                  <1>     pop di
    82 00000808 5E                  <1>     pop si
    83 00000809 5A                  <1>     pop dx
    84 0000080A 59                  <1>     pop cx
    85 0000080B 5B                  <1>     pop bx
    86 0000080C 58                  <1>     pop ax
    87 0000080D C3                  <1>     ret
    88                              <1> 
    89                              <1> 
    90                              <1> ; ------------------------------------------------------------
    91                              <1> ; load_palette — Loads "vga.bin" and programs VGA DAC registers
    92                              <1> ; (Unchanged from your original; called only once now)
    93                              <1> ; ------------------------------------------------------------
    94                              <1> load_palette:
    95 0000080E 50                  <1>     push ax
    96 0000080F 53                  <1>     push bx
    97 00000810 51                  <1>     push cx
    98 00000811 52                  <1>     push dx
    99 00000812 56                  <1>     push si
   100 00000813 1E                  <1>     push ds
   101                              <1> 
   102                              <1>     ; Open palette file
   103 00000814 8D16[5608]          <1>     lea dx, [palette_filename]
   104 00000818 B43D                <1>     mov ah, 0x3D
   105 0000081A 30C0                <1>     xor al, al
   106 0000081C CD21                <1>     int 0x21
   107 0000081E 7223                <1>     jc .lp_exit
   108 00000820 89C3                <1>     mov bx, ax
   109                              <1> 
   110                              <1>     ; Read 768 bytes (256 colors * 3 bytes)
   111 00000822 B43F                <1>     mov ah, 0x3F
   112 00000824 B90003              <1>     mov cx, 768
   113 00000827 8D16[6228]          <1>     lea dx, [palette_buffer]
   114 0000082B CD21                <1>     int 0x21
   115                              <1> 
   116                              <1>     ; Close palette file
   117 0000082D B43E                <1>     mov ah, 0x3E
   118 0000082F CD21                <1>     int 0x21
   119                              <1> 
   120                              <1>     ; Write to VGA DAC registers
   121 00000831 BAC803              <1>     mov dx, 0x03C8
   122 00000834 30C0                <1>     xor al, al
   123 00000836 EE                  <1>     out dx, al                 ; start from color 0
   124 00000837 42                  <1>     inc dx
   125 00000838 8D36[6228]          <1>     lea si, [palette_buffer]
   126 0000083C B90003              <1>     mov cx, 768
