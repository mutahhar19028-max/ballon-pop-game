     5                              <1> ; ------------------------------------------------------------
     6                              <1> ; drawRoundedRect
     7                              <1> ; ------------------------------------------------------------
     8                              <1> ; INPUT:
     9                              <1> ;   AX = X coordinate (top-left)
    10                              <1> ;   BX = Y coordinate (top-left)
    11                              <1> ;   CX = Width in pixels
    12                              <1> ;   DX = Height in pixels
    13                              <1> ;   SI = Fill color
    14                              <1> ;   DI = Border color
    15                              <1> ; OUTPUT:
    16                              <1> ;   Rounded rectangle with 2-pixel corner radius
    17                              <1> ; EFFECT:
    18                              <1> ;   Draws main body as filled rect (offset by 2 pixels)
    19                              <1> ;   Draws top/bottom strips for rounded edges
    20                              <1> ;   Draws border outline using drawRectOutline
    21                              <1> ;   Creates visual effect of rounded corners by omitting corner pixels
    22                              <1> ; ------------------------------------------------------------
    23                              <1> drawRoundedRect:
    24 00000014 50                  <1>     push ax
    25 00000015 53                  <1>     push bx
    26 00000016 51                  <1>     push cx
    27 00000017 52                  <1>     push dx
