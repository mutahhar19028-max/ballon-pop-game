   180                              <1> %define TIMER_TEXT_Y        ((TIMER_PANEL_Y + TIMER_PANEL_HEIGHT) / 2) - PADDING
   181                              <1> %define TIMER_VALUE_X       TIMER_PANEL_X + 50
   182                              <1> %define TIMER_VALUE_Y       TIMER_PANEL_Y + 6
   183                              <1> 
   184                              <1> ; === SOUND BUTTON ===
