    65 00002BAE 51                  <1>     push cx
    66 00002BAF 52                  <1>     push dx
    67                              <1> 
    68 00002BB0 C606[F805]00        <1>     mov byte [current_selection], MENU_OPTION_PLAY
    69                              <1> 
    70                              <1> .input_loop:
    71 00002BB5 E8ABFF              <1>     call drawMenuArrow
    72                              <1> 
    73 00002BB8 B400                <1>     mov ah, 0x00
    74 00002BBA CD16                <1>     int 0x16            ; wait key
    75                              <1> 
    76 00002BBC 80FC48              <1>     cmp ah, KEY_UP
    77 00002BBF 7411                <1>     je .move_up
    78 00002BC1 80FC50              <1>     cmp ah, KEY_DOWN
    79 00002BC4 7423                <1>     je .move_down
    80 00002BC6 80FC1C              <1>     cmp ah, KEY_ENTER
    81 00002BC9 7435                <1>     je .select_option
    82 00002BCB 80FC01              <1>     cmp ah, KEY_ESC
    83 00002BCE 743A                <1>     je .exit_pressed
    84 00002BD0 EBE3                <1>     jmp .input_loop
    85                              <1> 
    86                              <1> .move_up:
    87 00002BD2 E8B3FF              <1>     call clearMenuArrow
    88 00002BD5 A0[F805]            <1>     mov al, [current_selection]
    89 00002BD8 3C00                <1>     cmp al, 0
    90 00002BDA 7406                <1>     je .wrap_bottom
    91 00002BDC FE0E[F805]          <1>     dec byte [current_selection]
    92 00002BE0 EBD3                <1>     jmp .input_loop
    93                              <1> 
    94                              <1> .wrap_bottom:
    95 00002BE2 C606[F805]02        <1>     mov byte [current_selection], TOTAL_MENU_OPTIONS - 1
    96 00002BE7 EBCC                <1>     jmp .input_loop
    97                              <1> 
    98                              <1> .move_down:
    99 00002BE9 E89CFF              <1>     call clearMenuArrow
   100 00002BEC A0[F805]            <1>     mov al, [current_selection]
   101 00002BEF 3C02                <1>     cmp al, TOTAL_MENU_OPTIONS - 1
   102 00002BF1 7406                <1>     je .wrap_top
   103 00002BF3 FE06[F805]          <1>     inc byte [current_selection]
   104 00002BF7 EBBC                <1>     jmp .input_loop
   105                              <1> 
   106                              <1> .wrap_top:
   107 00002BF9 C606[F805]00        <1>     mov byte [current_selection], 0
   108 00002BFE EBB5                <1>     jmp .input_loop
   109                              <1> 
   110                              <1> .select_option:
   111 00002C00 E885FF              <1>     call clearMenuArrow
   112 00002C03 A0[F805]            <1>     mov al, [current_selection]
   113 00002C06 5A                  <1>     pop dx
   114 00002C07 59                  <1>     pop cx
   115 00002C08 5B                  <1>     pop bx
   116 00002C09 C3                  <1>     ret
   117                              <1> 
