   164 00003908 BE[6532]            <1>     mov si, balloon_array
   165 0000390B B90300              <1>     mov cx, MAX_BALLOONS
   166                              <1> 
   167                              <1> .render_loop:
   168                              <1>     ; Check active flag
   169 0000390E 8A4406              <1>     mov al, [si+6]
   170 00003911 3C01                <1>     cmp al, 1
   171 00003913 7524                <1>     jne .next_balloon
   172                              <1> 
   173                              <1>     ; Get balloon data
   174 00003915 8B04                <1>     mov ax, [si+0]              ; X position
   175 00003917 8B5C02              <1>     mov bx, [si+2]              ; Y position
   176 0000391A 8A5404              <1>     mov dl, [si+4]              ; Letter
   177 0000391D 8A7405              <1>     mov dh, [si+5]              ; Color index
   178                              <1> 
   179                              <1>     ; Get actual color
   180 00003920 56                  <1>     push si
   181 00003921 51                  <1>     push cx
   182 00003922 30ED                <1>     xor ch, ch
   183 00003924 88F1                <1>     mov cl, dh
   184 00003926 80E107              <1>     and cl, 0x07
   185 00003929 BE[5D32]            <1>     mov si, balloon_colors
   186 0000392C 01CE                <1>     add si, cx
   187 0000392E 8A0C                <1>     mov cl, [si]
   188 00003930 59                  <1>     pop cx
   189 00003931 5E                  <1>     pop si
   190                              <1> 
   191                              <1>     ; Draw balloon
   192 00003932 56                  <1>     push si
   193 00003933 51                  <1>     push cx
   194 00003934 E81202              <1>     call drawBalloon
   195 00003937 59                  <1>     pop cx
   196 00003938 5E                  <1>     pop si
   197                              <1> 
   198                              <1> .next_balloon:
