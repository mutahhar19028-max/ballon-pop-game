   155 00002EAA B9D900              <1>     mov cx, TIMER_TEXT_X
   156 00002EAD BA0A00              <1>     mov dx, TIMER_TEXT_Y
   157 00002EB0 BE[C62E]            <1>     mov si, timer_label_text
