   434 00004665 8B7408              <1>     mov si, [si+8]              ; Buffer offset
   435                              <1> 
   436                              <1>     ; Check bounds
   437 00004668 83FB00              <1>     cmp bx, 0
   438 0000466B 7C47                <1>     jl .done_restore
   439 0000466D 81FBC800            <1>     cmp bx, 200
   440 00004671 7D41                <1>     jge .done_restore
   441                              <1> 
   442                              <1>     ; Setup segments
   443 00004673 0E                  <1>     push cs
   444 00004674 1F                  <1>     pop ds                      ; DS = our data segment
   445 00004675 81C6[0033]          <1>     add si, background_buffer   ; SI = buffer address
   446 00004679 BA00A0              <1>     mov dx, 0xA000
   447 0000467C 8EC2                <1>     mov es, dx                  ; ES = VGA segment
   448                              <1> 
   449                              <1>     ; Restore 14 rows
   450 0000467E B91500              <1>     mov cx, BALLOON_HEIGHT
   451                              <1> 
   452                              <1> .restore_row:
   453 00004681 51                  <1>     push cx
   454 00004682 50                  <1>     push ax
   455 00004683 53                  <1>     push bx
   456                              <1> 
   457                              <1>     ; Check if row is visible
   458 00004684 83FB00              <1>     cmp bx, 0
   459 00004687 7C22                <1>     jl .skip_restore_row
   460 00004689 81FBC800            <1>     cmp bx, 200
   461 0000468D 7D1C                <1>     jge .skip_restore_row
   462                              <1> 
   463                              <1>     ; Calculate VGA offset
   464 0000468F 50                  <1>     push ax
   465 00004690 89D8                <1>     mov ax, bx
   466 00004692 BA4001              <1>     mov dx, 320
   467 00004695 F7E2                <1>     mul dx
   468 00004697 5A                  <1>     pop dx
   469 00004698 01D0                <1>     add ax, dx
   470 0000469A 89C7                <1>     mov di, ax
   471                              <1> 
   472                              <1>     ; Copy 16 pixels
   473 0000469C B91800              <1>     mov cx, BALLOON_WIDTH
   474                              <1> .restore_pixel:
   475 0000469F 3E8A04              <1>     mov al, [ds:si]
   476 000046A2 268805              <1>     mov [es:di], al
   477 000046A5 46                  <1>     inc si
   478 000046A6 47                  <1>     inc di
   479 000046A7 E2F6                <1>     loop .restore_pixel
   480 000046A9 EB03                <1>     jmp .next_restore_row
   481                              <1> 
   482                              <1> .skip_restore_row:
   483 000046AB 83C618              <1>     add si, BALLOON_WIDTH       ; Skip buffer row
   484                              <1> 
   485                              <1> .next_restore_row:
   486 000046AE 5B                  <1>     pop bx
   487 000046AF 58                  <1>     pop ax
   488 000046B0 43                  <1>     inc bx
   489 000046B1 59                  <1>     pop cx
   490 000046B2 E2CD                <1>     loop .restore_row
   491                              <1> 
   492                              <1> .done_restore:
   493 000046B4 1F                  <1>     pop ds
   494 000046B5 07                  <1>     pop es
   495 000046B6 5E                  <1>     pop si
   496 000046B7 5F                  <1>     pop di
   497 000046B8 5A                  <1>     pop dx
   498 000046B9 59                  <1>     pop cx
   499 000046BA 5B                  <1>     pop bx
   500 000046BB 58                  <1>     pop ax
   501 000046BC C3                  <1>     ret
   502                              <1> 
