    64                              <1> ; ------------------------------------------------------------
    65                              <1> ; PUBLIC: drawScoreValue
    66                              <1> ; Draws the current score at defined position
    67                              <1> ; Called by drawScorePanel
    68                              <1> ; ------------------------------------------------------------
    69                              <1> drawScoreValue:
    70 00002E3A 50                  <1>     push ax
    71 00002E3B 53                  <1>     push bx
    72 00002E3C 51                  <1>     push cx
    73 00002E3D 52                  <1>     push dx
    74 00002E3E 56                  <1>     push si
    75 00002E3F 57                  <1>     push di
    76 00002E40 55                  <1>     push bp
    77                              <1> 
    78                              <1>     ; Allocate 5 bytes for "0000\0"
    79 00002E41 83EC05              <1>     sub sp, 5
    80 00002E44 89E5                <1>     mov bp, sp          ; BP points to buffer
    81                              <1> 
    82 00002E46 A1[E905]            <1>     mov ax, [current_score]  ; AX = current score
    83                              <1> 
    84                              <1>     ; --- Thousands digit ---
    85 00002E49 B9E803              <1>     mov cx, 1000
    86 00002E4C 31D2                <1>     xor dx, dx
    87 00002E4E F7F1                <1>     div cx                  ; AX / 1000 -> AX = quotient in AL, DX = remainder
    88 00002E50 0430                <1>     add al, '0'
    89 00002E52 884600              <1>     mov [bp], al            ; store thousands digit
    90                              <1> 
    91                              <1>     ; --- Hundreds digit ---
    92 00002E55 89D0                <1>     mov ax, dx               ; remainder from thousands division
    93 00002E57 B96400              <1>     mov cx, 100
    94 00002E5A 31D2                <1>     xor dx, dx
    95 00002E5C F7F1                <1>     div cx                   ; AX / 100 -> AL = hundreds, DX = remainder
    96 00002E5E 0430                <1>     add al, '0'
    97 00002E60 884601              <1>     mov [bp+1], al
    98                              <1> 
    99                              <1>     ; --- Tens digit ---
   100 00002E63 89D0                <1>     mov ax, dx               ; remainder from hundreds
   101 00002E65 B90A00              <1>     mov cx, 10
   102 00002E68 31D2                <1>     xor dx, dx
   103 00002E6A F7F1                <1>     div cx                   ; AX / 10 -> AL = tens, DX = ones
   104 00002E6C 0430                <1>     add al, '0'
   105 00002E6E 884602              <1>     mov [bp+2], al
   106                              <1> 
   107                              <1>     ; --- Ones digit ---
   108 00002E71 88D0                <1>     mov al, dl               ; remainder from tens division
   109 00002E73 0430                <1>     add al, '0'
   110 00002E75 884603              <1>     mov [bp+3], al
   111                              <1> 
   112                              <1>     ; --- Null terminator ---
   113 00002E78 C6460400            <1>     mov byte [bp+4], 0
   114                              <1> 
   115                              <1>     ; Draw score string
   116 00002E7C B98C00              <1>     mov cx, SCORE_VALUE_X - 14
   117 00002E7F BA0A00              <1>     mov dx, SCORE_VALUE_Y - 2
   118 00002E82 89EE                <1>     mov si, bp
   119 00002E84 8A1E[1100]          <1>     mov bl, [dark_brown]
   120 00002E88 B701                <1>     mov bh, 1
   121 00002E8A E853D3              <1>     call drawText
   122                              <1> 
   123 00002E8D 83C405              <1>     add sp, 5
   124 00002E90 5D                  <1>     pop bp
   125 00002E91 5F                  <1>     pop di
   126 00002E92 5E                  <1>     pop si
   127 00002E93 5A                  <1>     pop dx
   128 00002E94 59                  <1>     pop cx
   129 00002E95 5B                  <1>     pop bx
   130 00002E96 58                  <1>     pop ax
   131 00002E97 C3                  <1>     ret
   132                              <1> 
   133                              <1> ;; ------------------------------------------------------------
   134                              <1> ; drawTimerPanel
   135                              <1> ; Draws timer panel with dynamic time display
   136                              <1> ; ------------------------------------------------------------
   137                              <1> drawTimerPanel:
   138 00002E98 50                  <1>     push ax
   139 00002E99 53                  <1>     push bx
   140 00002E9A 51                  <1>     push cx
   141 00002E9B 52                  <1>     push dx
   142 00002E9C 56                  <1>     push si
   143 00002E9D 57                  <1>     push di
   144                              <1> 
   145                              <1>     ; Draw panel background
   146 00002E9E B8D100              <1>     mov ax, TIMER_PANEL_X
   147 00002EA1 BB0400              <1>     mov bx, TIMER_PANEL_Y
   148 00002EA4 B96900              <1>     mov cx, TIMER_PANEL_WIDTH
   149 00002EA7 BA1400              <1>     mov dx, TIMER_PANEL_HEIGHT
   150 00002EAA 8B36[0700]          <1>     mov si, TIMER_PANEL_COLOR
   151 00002EAE 8B3E[0800]          <1>     mov di, TIMER_BORDER_COLOR
   152 00002EB2 E85FD1              <1>     call drawRoundedRect
   153                              <1> 
   154                              <1>     ; Draw "TIME:" label
   155 00002EB5 B9D900              <1>     mov cx, TIMER_TEXT_X
   156 00002EB8 BA0A00              <1>     mov dx, TIMER_TEXT_Y
   157 00002EBB BE[D12E]            <1>     mov si, timer_label_text
   158 00002EBE 8A1E[1100]          <1>     mov bl, [dark_brown]
   159 00002EC2 B701                <1>     mov bh, 1
   160 00002EC4 E819D3              <1>     call drawText
   161                              <1> 
