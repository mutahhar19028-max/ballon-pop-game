   166 00002EBA 5E                  <1>     pop si
   167 00002EBB 5A                  <1>     pop dx
   168 00002EBC 59                  <1>     pop cx
   169 00002EBD 5B                  <1>     pop bx
   170 00002EBE 58                  <1>     pop ax
   171 00002EBF C3                  <1>     ret
