   750                              <1>     
   751 000003D2 8B46F2              <1>     mov ax, [bp-14]
   752 000003D5 8B56F6              <1>     mov dx, [bp-10]
   753 000003D8 D1E2                <1>     shl dx, 1
   754 000003DA 8B76F4              <1>     mov si, [bp-12]
   755 000003DD D1E6                <1>     shl si, 1
   756 000003DF 29F2                <1>     sub dx, si
   757 000003E1 01D0                <1>     add ax, dx
   758 000003E3 83C005              <1>     add ax, 5
   759 000003E6 8946F2              <1>     mov [bp-14], ax
