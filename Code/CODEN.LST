   718                              <1> 
   719                              <1>     ; 5: (cx + y, cy + x)
   720 0000038E 8B4EFE              <1>     mov cx, [bp-2]
   721 00000391 034EF4              <1>     add cx, [bp-12]
   722 00000394 8B56FC              <1>     mov dx, [bp-4]
   723 00000397 0356F6              <1>     add dx, [bp-10]
   724 0000039A E823FF              <1>     call putPixel
