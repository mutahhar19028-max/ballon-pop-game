   140                              <1> ; CONFIGURATION CONSTANTS - Customize these for easy changes
   141                              <1> ; ------------------------------------------------------------
   142                              <1> 
   143                              <1> ; === COLORS (VGA 256-color palette indices) ===
   144                              <1> %define COLOR_WHITE         180 ; border
   145                              <1> %define COLOR_BLACK         200 ; score text
   146                              <1> %define COLOR_BLUE          250 ; panel
   147                              <1> %define COLOR_DARK_BLUE     0x01
   148                              <1> %define COLOR_RED           0x0C
   149                              <1> %define COLOR_ORANGE        0x06
   150                              <1> %define COLOR_YELLOW        0x0E
   151                              <1> %define COLOR_LIGHT_GRAY    0x07
   152                              <1> %define COLOR_DARK_GRAY     0x08
   153                              <1> 
   154                              <1> %define PADDING 2
   155                              <1> %define MAX_WIDTH 320
   156                              <1> %define BOX_WIDTH 90
   157                              <1> %define BOX_HEIGHT 20
   158                              <1> %define BASE_RADIUS 10
   159                              <1> 
   160                              <1> ; === SCORE PANEL ===
   161                              <1> %define SCORE_PANEL_X       2 * PADDING
   162                              <1> %define SCORE_PANEL_Y       2 * PADDING
   163                              <1> %define SCORE_PANEL_WIDTH   BOX_WIDTH
   164                              <1> %define SCORE_PANEL_HEIGHT  BOX_HEIGHT
   165                              <1> %define SCORE_PANEL_COLOR   [light_orange]
   166                              <1> %define SCORE_BORDER_COLOR  [dark_orange]
   167                              <1> %define SCORE_TEXT_X        (SCORE_PANEL_X + (SCORE_PANEL_WIDTH / 16)) + PADDING
   168                              <1> %define SCORE_TEXT_Y        ((SCORE_PANEL_Y + SCORE_PANEL_HEIGHT) / 2) - PADDING
   169                              <1> %define SCORE_VALUE_X       ((SCORE_PANEL_X + (SCORE_PANEL_WIDTH / 2)) + (SCORE_PANEL_WIDTH / 3))
   170                              <1> %define SCORE_VALUE_Y       ((SCORE_PANEL_Y + SCORE_PANEL_HEIGHT) / 2)
   171                              <1> 
   172                              <1> ; === TIMER PANEL ===
   173                              <1> %define TIMER_PANEL_X       MAX_WIDTH - (TIMER_PANEL_WIDTH + 3 * PADDING)
   174                              <1> %define TIMER_PANEL_Y       2 * PADDING
   175                              <1> %define TIMER_PANEL_WIDTH   BOX_WIDTH + 15
   176                              <1> %define TIMER_PANEL_HEIGHT  BOX_HEIGHT
   177                              <1> %define TIMER_PANEL_COLOR   [light_orange]
   178                              <1> %define TIMER_BORDER_COLOR  [dark_orange]
   179                              <1> %define TIMER_TEXT_X        TIMER_PANEL_X + 4 * PADDING
   180                              <1> %define TIMER_TEXT_Y        ((TIMER_PANEL_Y + TIMER_PANEL_HEIGHT) / 2) - PADDING
   181                              <1> %define TIMER_VALUE_X       TIMER_PANEL_X + 50
   182                              <1> %define TIMER_VALUE_Y       TIMER_PANEL_Y + 6
   183                              <1> 
   184                              <1> ; === SOUND BUTTON ===
   185                              <1> %define SOUND_BTN_RADIUS    BASE_RADIUS
   186                              <1> %define SOUND_BTN_X         PADDING + ((SOUND_BTN_RADIUS / 2) + SOUND_BTN_RADIUS)
   187                              <1> %define SOUND_BTN_Y         ((PADDING / 2) + PADDING) + SOUND_BTN_RADIUS
   188                              <1> %define SOUND_BTN_COLOR     [light_orange]
   189                              <1> %define SOUND_BTN_BORDER    [dark_orange]
   190                              <1> 
   191                              <1> ; === PAUSE BUTTON ===
   192                              <1> %define PAUSE_BTN_RADIUS    BASE_RADIUS
   193                              <1> %define PAUSE_BTN_X         SOUND_BTN_X + (((SOUND_BTN_RADIUS / 2) + SOUND_BTN_RADIUS) + PADDING + PAUSE_BTN_RADIUS)
   194                              <1> %define PAUSE_BTN_Y         ((PADDING / 2) + PADDING) + PAUSE_BTN_RADIUS
   195                              <1> %define PAUSE_BTN_COLOR     [light_orange]
   196                              <1> %define PAUSE_BTN_BORDER    [dark_brown]
   197                              <1> 
