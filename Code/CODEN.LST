     1                              <1> ; ============================================================
     2                              <1> ; timer.asm — IRQ0-based Timer System (1 second updates)
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> ; ------------------------------------------------------------
     6                              <1> ; TIMER CONFIGURATION
     7                              <1> ; ------------------------------------------------------------
     8                              <1> %define PIT_CHANNEL0    0x40    ; PIT channel 0 data port
     9                              <1> %define PIT_COMMAND     0x43    ; PIT command port
    10                              <1> %define PIC_COMMAND     0x20    ; 8259 PIC command port
    11                              <1> %define PIC_DATA        0x21    ; 8259 PIC data port
    12                              <1> 
    13                              <1> %define TICKS_PER_SEC   18      ; Default: 18.2 Hz, we'll use 18 for simplicity
    14                              <1> %define GAME_TIME_SEC   120     ; 2 minutes = 120 seconds
    15 000005FF 0000                <1> ticks       dw 0            ; global tick counter
    16                              <1> 
    17                              <1> 
    18                              <1> ; ------------------------------------------------------------
    19                              <1> ; TIMER VARIABLES
    20                              <1> ; ------------------------------------------------------------
    21 00000601 7800                <1> timer_seconds       dw GAME_TIME_SEC    ; Remaining seconds (120)
    22 00000603 02                  <1> timer_minutes       db 2                ; Display minutes
    23 00000604 00                  <1> timer_display_sec   db 0                ; Display seconds
    24 00000605 00                  <1> timer_ticks         db 0                ; Tick counter (0-17)
    25 00000606 00000000            <1> old_timer_vector    dd 0                ; Original IRQ0 handler address
    26 0000060A 00                  <1> timer_active        db 0                ; Timer running flag
    27                              <1> 
    28                              <1> ; ------------------------------------------------------------
    29                              <1> ; installTimerISR
    30                              <1> ; Hooks IRQ0 (INT 08h) to custom timer handler
    31                              <1> ; Saves original vector for restoration
    32                              <1> ; ------------------------------------------------------------
    33                              <1> installTimerISR:
    34 0000060B 50                  <1>     push ax
    35 0000060C 53                  <1>     push bx
    36 0000060D 51                  <1>     push cx
    37 0000060E 52                  <1>     push dx
    38 0000060F 06                  <1>     push es
    39                              <1> 
    40                              <1>     ; Save old INT 08h vector
    41 00000610 B80835              <1>     mov ax, 0x3508          ; AH=35h (Get interrupt vector), AL=08h
    42 00000613 CD21                <1>     int 0x21
    43 00000615 891E[0606]          <1>     mov word [old_timer_vector], bx
    44 00000619 8C06[0806]          <1>     mov word [old_timer_vector+2], es
    45                              <1> 
    46                              <1>     ; Install new handler
    47 0000061D 1E                  <1>     push ds
    48 0000061E 8CC8                <1>     mov ax, cs
    49 00000620 8ED8                <1>     mov ds, ax
    50 00000622 BA[5B06]            <1>     mov dx, timerISR
    51 00000625 B80825              <1>     mov ax, 0x2508          ; AH=25h (Set interrupt vector), AL=08h
    52 00000628 CD21                <1>     int 0x21
    53 0000062A 1F                  <1>     pop ds
    54                              <1> 
    55                              <1>     ; Initialize timer variables
    56 0000062B C706[0106]7800      <1>     mov word [timer_seconds], GAME_TIME_SEC
    57 00000631 C606[0306]02        <1>     mov byte [timer_minutes], 2
    58 00000636 C606[0406]00        <1>     mov byte [timer_display_sec], 0
    59 0000063B C606[0506]00        <1>     mov byte [timer_ticks], 0
    60 00000640 C606[0A06]01        <1>     mov byte [timer_active], 1
    61                              <1> 
    62 00000645 07                  <1>     pop es
    63 00000646 5A                  <1>     pop dx
    64 00000647 59                  <1>     pop cx
    65 00000648 5B                  <1>     pop bx
    66 00000649 58                  <1>     pop ax
    67 0000064A C3                  <1>     ret
    68                              <1> 
    69                              <1> ; ------------------------------------------------------------
    70                              <1> ; restoreTimerISR
    71                              <1> ; Restores original IRQ0 handler
    72                              <1> ; Call before program exit!
    73                              <1> ; ------------------------------------------------------------
    74                              <1> restoreTimerISR:
    75 0000064B 50                  <1>     push ax
    76 0000064C 52                  <1>     push dx
    77 0000064D 1E                  <1>     push ds
    78                              <1> 
    79                              <1>     ; Restore old INT 08h vector
    80 0000064E C516[0606]          <1>     lds dx, [old_timer_vector]
    81 00000652 B80825              <1>     mov ax, 0x2508
    82 00000655 CD21                <1>     int 0x21
    83                              <1> 
    84 00000657 1F                  <1>     pop ds
    85 00000658 5A                  <1>     pop dx
    86 00000659 58                  <1>     pop ax
    87 0000065A C3                  <1>     ret
    88                              <1> 
    89                              <1> ; ------------------------------------------------------------
    90                              <1> ; timerISR
    91                              <1> ; Custom IRQ0 handler - called ~18.2 times per second
    92                              <1> ; Decrements timer every 18 ticks (approximately 1 second)
    93                              <1> ; ------------------------------------------------------------
    94                              <1> timerISR:
    95 0000065B 50                  <1>     push ax
    96 0000065C 53                  <1>     push bx
    97 0000065D 51                  <1>     push cx
    98 0000065E 52                  <1>     push dx
    99 0000065F 56                  <1>     push si
   100 00000660 57                  <1>     push di
   101 00000661 1E                  <1>     push ds
   102 00000662 06                  <1>     push es
   103                              <1> 
   104                              <1>     ; Set DS to our data segment
   105 00000663 8CC8                <1>     mov ax, cs
   106 00000665 8ED8                <1>     mov ds, ax
   107                              <1> 
   108                              <1>     ; Check if timer is active
   109 00000667 803E[0A06]01        <1>     cmp byte [timer_active], 1
   110 0000066C 7522                <1>     jne .chain_to_old
   111                              <1> 
   112                              <1>     ; Increment tick counter
   113 0000066E FE06[0506]          <1>     inc byte [timer_ticks]
   114 00000672 803E[0506]12        <1>     cmp byte [timer_ticks], TICKS_PER_SEC
   115 00000677 7217                <1>     jb .chain_to_old        ; Not 1 second yet
   116                              <1> 
   117                              <1>     ; Reset tick counter
   118 00000679 C606[0506]00        <1>     mov byte [timer_ticks], 0
   119                              <1> 
   120                              <1>     ; Decrement seconds
   121 0000067E 833E[0106]00        <1>     cmp word [timer_seconds], 0
   122 00000683 7418                <1>     je .timer_expired       ; Already at 0
   123                              <1> 
   124 00000685 FF0E[0106]          <1>     dec word [timer_seconds]
   125 00000689 FF06[FF05]          <1>     inc word [ticks]
   126                              <1> 
   127                              <1>     ; Update display format (MM:SS)
   128 0000068D E81400              <1>     call updateTimerDisplay
   129                              <1> 
   130                              <1> .chain_to_old:
   131                              <1>     ; Send EOI to PIC
   132 00000690 B020                <1>     mov al, 0x20
   133 00000692 E620                <1>     out PIC_COMMAND, al
   134                              <1> 
   135 00000694 07                  <1>     pop es
   136 00000695 1F                  <1>     pop ds
   137 00000696 5F                  <1>     pop di
   138 00000697 5E                  <1>     pop si
   139 00000698 5A                  <1>     pop dx
   140 00000699 59                  <1>     pop cx
   141 0000069A 5B                  <1>     pop bx
   142 0000069B 58                  <1>     pop ax
   143 0000069C CF                  <1>     iret                    ; Return from interrupt
   144                              <1> 
   145                              <1> .timer_expired:
   146                              <1>     ; Timer reached 0 - trigger game over
   147 0000069D C606[0A06]00        <1>     mov byte [timer_active], 0
   148                              <1>     ; Game state will be checked in main loop
   149 000006A2 EBEC                <1>     jmp .chain_to_old
   150                              <1> 
   151                              <1> ; ------------------------------------------------------------
   152                              <1> ; updateTimerDisplay
   153                              <1> ; Converts timer_seconds to MM:SS format
   154                              <1> ; Updates timer_minutes and timer_display_sec
   155                              <1> ; ------------------------------------------------------------
   156                              <1> updateTimerDisplay:
   157 000006A4 50                  <1>     push ax
   158 000006A5 53                  <1>     push bx
   159 000006A6 52                  <1>     push dx
   160                              <1> 
   161                              <1>     ; Get total seconds
   162 000006A7 A1[0106]            <1>     mov ax, [timer_seconds]
   163                              <1> 
   164                              <1>     ; Divide by 60 to get minutes
   165 000006AA 31D2                <1>     xor dx, dx
   166 000006AC BB3C00              <1>     mov bx, 60
   167 000006AF F7F3                <1>     div bx                  ; AX = minutes, DX = seconds
   168                              <1> 
   169                              <1>     ; Store results
   170 000006B1 A2[0306]            <1>     mov [timer_minutes], al
   171 000006B4 8816[0406]          <1>     mov [timer_display_sec], dl
   172                              <1> 
   173 000006B8 5A                  <1>     pop dx
   174 000006B9 5B                  <1>     pop bx
   175 000006BA 58                  <1>     pop ax
   176 000006BB C3                  <1>     ret
   177                              <1> 
   178                              <1> ; ------------------------------------------------------------
   179                              <1> ; resetTimer
   180                              <1> ; Resets timer to initial value (120 seconds)
   181                              <1> ; ------------------------------------------------------------
   182                              <1> resetTimer:
   183 000006BC 50                  <1>     push ax
   184                              <1> 
   185 000006BD C706[0106]7800      <1>     mov word [timer_seconds], GAME_TIME_SEC
   186 000006C3 C606[0306]02        <1>     mov byte [timer_minutes], 2
   187 000006C8 C606[0406]00        <1>     mov byte [timer_display_sec], 0
   188 000006CD C606[0506]00        <1>     mov byte [timer_ticks], 0
   189 000006D2 C606[0A06]01        <1>     mov byte [timer_active], 1
   190                              <1> 
   191 000006D7 58                  <1>     pop ax
   192 000006D8 C3                  <1>     ret
   193                              <1> 
   194                              <1> ; ------------------------------------------------------------
   195                              <1> ; pauseTimer
   196                              <1> ; Pauses the timer (stops decrementing)
   197                              <1> ; ------------------------------------------------------------
   198                              <1> pauseTimer:
   199 000006D9 C606[0A06]00        <1>     mov byte [timer_active], 0
   200 000006DE C3                  <1>     ret
   201                              <1> 
   202                              <1> ; ------------------------------------------------------------
   203                              <1> ; resumeTimer
   204                              <1> ; Resumes the timer (continues decrementing)
   205                              <1> ; ------------------------------------------------------------
   206                              <1> resumeTimer:
   207 000006DF C606[0A06]01        <1>     mov byte [timer_active], 1
   208 000006E4 C3                  <1>     ret
   209                              <1> 
   210                              <1> ; ------------------------------------------------------------
   211                              <1> ; isTimerExpired
   212                              <1> ; Returns: AL = 1 if timer expired, 0 otherwise
   213                              <1> ; ------------------------------------------------------------
   214                              <1> isTimerExpired:
   215 000006E5 53                  <1>     push bx
   216                              <1>     
   217 000006E6 B000                <1>     mov al, 0
   218 000006E8 833E[0106]00        <1>     cmp word [timer_seconds], 0
   219 000006ED 7502                <1>     jne .not_expired
   220 000006EF B001                <1>     mov al, 1
   221                              <1> 
   222                              <1> .not_expired:
   223 000006F1 5B                  <1>     pop bx
   224 000006F2 C3                  <1>     ret
   225                              <1> 
   226                              <1> ; ------------------------------------------------------------
   227                              <1> ; getTimerString
   228                              <1> ; Converts timer to "MM:SS" string format
   229                              <1> ; INPUT: SI = pointer to 6-byte buffer (output)
   230                              <1> ; OUTPUT: Buffer filled with "MM:SS\0"
   231                              <1> ; ------------------------------------------------------------
   232                              <1> getTimerString:
   233 000006F3 50                  <1>     push ax
   234 000006F4 53                  <1>     push bx
   235 000006F5 51                  <1>     push cx
   236 000006F6 52                  <1>     push dx
   237 000006F7 57                  <1>     push di
   238                              <1> 
   239 000006F8 89F7                <1>     mov di, si              ; DI = output buffer
   240                              <1> 
   241                              <1>     ; Convert minutes to ASCII
   242 000006FA 30E4                <1>     xor ah, ah
   243 000006FC A0[0306]            <1>     mov al, [timer_minutes]
   244 000006FF B30A                <1>     mov bl, 10
   245 00000701 F6F3                <1>     div bl                  ; AH = ones, AL = tens
   246 00000703 0430                <1>     add al, '0'
   247 00000705 8805                <1>     mov [di], al
   248 00000707 47                  <1>     inc di
   249 00000708 88E0                <1>     mov al, ah
   250 0000070A 0430                <1>     add al, '0'
   251 0000070C 8805                <1>     mov [di], al
   252 0000070E 47                  <1>     inc di
   253                              <1> 
   254                              <1>     ; Add colon
   255 0000070F C6053A              <1>     mov byte [di], ':'
   256 00000712 47                  <1>     inc di
   257                              <1> 
   258                              <1>     ; Convert seconds to ASCII
   259 00000713 30E4                <1>     xor ah, ah
   260 00000715 A0[0406]            <1>     mov al, [timer_display_sec]
   261 00000718 B30A                <1>     mov bl, 10
   262 0000071A F6F3                <1>     div bl                  ; AH = ones, AL = tens
   263 0000071C 0430                <1>     add al, '0'
   264 0000071E 8805                <1>     mov [di], al
   265 00000720 47                  <1>     inc di
   266 00000721 88E0                <1>     mov al, ah
   267 00000723 0430                <1>     add al, '0'
   268 00000725 8805                <1>     mov [di], al
   269 00000727 47                  <1>     inc di
   270                              <1> 
   271                              <1>     ; Null terminator
   272 00000728 C60500              <1>     mov byte [di], 0
   273                              <1> 
   274 0000072B 5F                  <1>     pop di
   275 0000072C 5A                  <1>     pop dx
   276 0000072D 59                  <1>     pop cx
   277 0000072E 5B                  <1>     pop bx
   278 0000072F 58                  <1>     pop ax
   279 00000730 C3                  <1>     ret
    12                                  %include "Code\sound.asm"
     1                              <1> ; sound.asm — PC Speaker victory sound
     2                              <1> ; Compatible with NASM (COM or EXE)
     3                              <1> 
     4                              <1> melodyFreqs:
     5 00000731 20038403E8034C04B0- <1>     dw 800, 900, 1000, 1100, 1200, 1300, 1400, 1500
     5 0000073A 0414057805DC05      <1>
     6 00000741 DC0578051405B0044C- <1>     dw 1500, 1400, 1300, 1200, 1100, 1000, 900, 800
     6 0000074A 04E80384032003      <1>
     7                              <1> numNotes    equ 16
     8 00000751 0200                <1> tempo       dw 2
     9 00000753 DC341200            <1> pit_constant: dd 1193180    ; Store as 32-bit constant
    10                              <1> 
    11                              <1> ; ---------------------------------------
    12                              <1> ; playCompletionSound — main entry
    13                              <1> ; ---------------------------------------
    14                              <1> playCompletionSound:
    15 00000757 50                  <1>     push ax
    16 00000758 53                  <1>     push bx
    17 00000759 51                  <1>     push cx
    18 0000075A 52                  <1>     push dx
    19 0000075B 56                  <1>     push si
    20                              <1> 
    21 0000075C BE[3107]            <1>     mov si, melodyFreqs
    22 0000075F B91000              <1>     mov cx, numNotes
    23                              <1> .loopNotes:
    24 00000762 AD                  <1>     lodsw                  ; AX = frequency
    25 00000763 09C0                <1>     or  ax, ax
    26 00000765 7405                <1>     jz  .done
    27 00000767 E80800              <1>     call playTune
    28 0000076A E2F6                <1>     loop .loopNotes
    29                              <1> 
    30                              <1> .done:
    31 0000076C 5E                  <1>     pop si
    32 0000076D 5A                  <1>     pop dx
    33 0000076E 59                  <1>     pop cx
    34 0000076F 5B                  <1>     pop bx
    35 00000770 58                  <1>     pop ax
    36 00000771 C3                  <1>     ret
    37                              <1> 
    38                              <1> ; ---------------------------------------
    39                              <1> ; playTune — AX = frequency (Hz)
    40                              <1> ; ---------------------------------------
    41                              <1> playTune:
    42 00000772 50                  <1>     push ax
    43 00000773 53                  <1>     push bx
    44 00000774 51                  <1>     push cx
    45 00000775 52                  <1>     push dx
    46                              <1> 
    47 00000776 89C3                <1>     mov bx, ax              ; Save frequency in BX
    48                              <1>     
    49                              <1>     ; Load 1193180 into DX:AX
    50 00000778 A1[5307]            <1>     mov ax, word [pit_constant]      ; Low word
    51 0000077B 8B16[5507]          <1>     mov dx, word [pit_constant + 2]  ; High word
    52                              <1>     
    53                              <1>     ; Divide DX:AX by BX -> quotient in AX
    54 0000077F F7F3                <1>     div bx                  ; DX:AX / BX = AX (remainder in DX)
    55 00000781 89C3                <1>     mov bx, ax              ; BX = divisor
    56                              <1> 
    57                              <1>     ; Program PIT channel 2
    58 00000783 B0B6                <1>     mov al, 0xB6
    59 00000785 E643                <1>     out 0x43, al
    60 00000787 89D8                <1>     mov ax, bx
    61 00000789 E642                <1>     out 0x42, al            ; low byte
    62 0000078B 88E0                <1>     mov al, ah
    63 0000078D E642                <1>     out 0x42, al            ; high byte
    64                              <1> 
    65                              <1>     ; Enable speaker
    66 0000078F E461                <1>     in al, 0x61
    67 00000791 0C03                <1>     or al, 3
    68 00000793 E661                <1>     out 0x61, al
    69                              <1> 
    70                              <1>     ; Hold tone
    71 00000795 E80B00              <1>     call toneDelay
    72                              <1> 
    73                              <1>     ; Disable speaker
    74 00000798 E461                <1>     in al, 0x61
    75 0000079A 24FC                <1>     and al, 0xFC
    76 0000079C E661                <1>     out 0x61, al
    77                              <1> 
    78 0000079E 5A                  <1>     pop dx
    79 0000079F 59                  <1>     pop cx
    80 000007A0 5B                  <1>     pop bx
    81 000007A1 58                  <1>     pop ax
    82 000007A2 C3                  <1>     ret
    83                              <1> 
    84                              <1> ; ---------------------------------------
    85                              <1> ; toneDelay — simple busy wait
    86                              <1> ; ---------------------------------------
    87                              <1> toneDelay:
    88 000007A3 51                  <1>     push cx
    89 000007A4 52                  <1>     push dx
    90 000007A5 8B16[5107]          <1>     mov dx, [tempo]
    91                              <1> .delayOuter:
    92 000007A9 B9FFAF              <1>     mov cx, 0xAFFF
    93                              <1> .delayInner:
    94 000007AC E2FE                <1>     loop .delayInner
    95 000007AE 4A                  <1>     dec dx
    96 000007AF 75F8                <1>     jnz .delayOuter
    97 000007B1 5A                  <1>     pop dx
    98 000007B2 59                  <1>     pop cx
    99 000007B3 C3                  <1>     ret
    13                                  %include "Code\show_bg.asm"
     1                              <1> ; ============================================================
     2                              <1> ; show_bg.asm — Draws VGA 320x200x256 background with palette
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> %define MODE_VGA13H  0x0013
     6                              <1> %define VIDEO_SEG    0xA000
     7                              <1> %define SCREEN_SIZE  64000
     8                              <1> %define CHUNK_SIZE   8192
     9                              <1> 
    10                              <1> ; ------------------------------------------------------------
    11                              <1> ; PUBLIC: showBackground320x200
    12                              <1> ; Loads and displays final.raw using vga.bin palette
    13                              <1> ; Palette is loaded only on first call.
    14                              <1> ; ------------------------------------------------------------
    15                              <1> showBackground320x200:
    16 000007B4 50                  <1>     push ax
    17 000007B5 53                  <1>     push bx
    18 000007B6 51                  <1>     push cx
    19 000007B7 52                  <1>     push dx
    20 000007B8 56                  <1>     push si
    21 000007B9 57                  <1>     push di
    22 000007BA 1E                  <1>     push ds
    23 000007BB 06                  <1>     push es
    24                              <1> 
    25                              <1>     ; If palette not loaded yet -> load it once
    26 000007BC A0[682B]            <1>     mov al, [palette_loaded]
    27 000007BF 3C01                <1>     cmp al, 1
    28 000007C1 7408                <1>     je .skip_palette
    29 000007C3 E84E00              <1>     call load_palette
    30 000007C6 C606[682B]01        <1>     mov byte [palette_loaded], 1
    31                              <1> 
    32                              <1> .skip_palette:
    33                              <1>     ; --------------------------------------------------------
    34                              <1>     ; Load and display background image from "final.raw"
    35                              <1>     ; (same behavior as before)
    36                              <1>     ; --------------------------------------------------------
    37 000007CB B800A0              <1>     mov ax, VIDEO_SEG
    38 000007CE 8EC0                <1>     mov es, ax
    39 000007D0 31FF                <1>     xor di, di
    40                              <1> 
    41                              <1>     ; Open RAW file (read-only)
    42 000007D2 8D16[5008]          <1>     lea dx, [filename]
    43 000007D6 B43D                <1>     mov ah, 0x3D
    44 000007D8 30C0                <1>     xor al, al
    45 000007DA CD21                <1>     int 0x21
    46 000007DC 722D                <1>     jc .cleanup
    47 000007DE 89C3                <1>     mov bx, ax                  ; BX = file handle
    48                              <1> 
    49                              <1> .read_loop:
    50                              <1>     ; Read chunk into buffer
    51 000007E0 B43F                <1>     mov ah, 0x3F
    52 000007E2 B90020              <1>     mov cx, CHUNK_SIZE
    53 000007E5 8D16[6808]          <1>     lea dx, [buffer]
    54 000007E9 CD21                <1>     int 0x21
    55 000007EB 721A                <1>     jc .close_file
    56 000007ED 09C0                <1>     or ax, ax
    57 000007EF 7416                <1>     jz .close_file              ; EOF reached
    58                              <1> 
    59                              <1>     ; Copy to VGA memory (use ES:DI for video, DS:SI for buffer)
    60 000007F1 1E                  <1>     push ds
    61 000007F2 BE[6808]            <1>     mov si, buffer
    62 000007F5 89C1                <1>     mov cx, ax
    63                              <1> .copy_loop:
    64 000007F7 8A04                <1>     mov al, [si]
    65 000007F9 268805              <1>     mov [es:di], al
    66 000007FC 46                  <1>     inc si
    67 000007FD 47                  <1>     inc di
    68 000007FE E2F7                <1>     loop .copy_loop
    69 00000800 1F                  <1>     pop ds
    70                              <1> 
    71 00000801 81FF00FA            <1>     cmp di, SCREEN_SIZE
    72 00000805 72D9                <1>     jb .read_loop
    73                              <1> 
    74                              <1> .close_file:
    75 00000807 B43E                <1>     mov ah, 0x3E
    76 00000809 CD21                <1>     int 0x21
    77                              <1> 
    78                              <1> .cleanup:
    79 0000080B 07                  <1>     pop es
    80 0000080C 1F                  <1>     pop ds
    81 0000080D 5F                  <1>     pop di
    82 0000080E 5E                  <1>     pop si
    83 0000080F 5A                  <1>     pop dx
    84 00000810 59                  <1>     pop cx
    85 00000811 5B                  <1>     pop bx
    86 00000812 58                  <1>     pop ax
    87 00000813 C3                  <1>     ret
    88                              <1> 
    89                              <1> 
    90                              <1> ; ------------------------------------------------------------
    91                              <1> ; load_palette — Loads "vga.bin" and programs VGA DAC registers
    92                              <1> ; (Unchanged from your original; called only once now)
    93                              <1> ; ------------------------------------------------------------
    94                              <1> load_palette:
    95 00000814 50                  <1>     push ax
    96 00000815 53                  <1>     push bx
    97 00000816 51                  <1>     push cx
    98 00000817 52                  <1>     push dx
    99 00000818 56                  <1>     push si
   100 00000819 1E                  <1>     push ds
   101                              <1> 
   102                              <1>     ; Open palette file
   103 0000081A 8D16[5C08]          <1>     lea dx, [palette_filename]
   104 0000081E B43D                <1>     mov ah, 0x3D
   105 00000820 30C0                <1>     xor al, al
   106 00000822 CD21                <1>     int 0x21
   107 00000824 7223                <1>     jc .lp_exit
   108 00000826 89C3                <1>     mov bx, ax
   109                              <1> 
   110                              <1>     ; Read 768 bytes (256 colors * 3 bytes)
   111 00000828 B43F                <1>     mov ah, 0x3F
   112 0000082A B90003              <1>     mov cx, 768
   113 0000082D 8D16[6828]          <1>     lea dx, [palette_buffer]
   114 00000831 CD21                <1>     int 0x21
   115                              <1> 
   116                              <1>     ; Close palette file
   117 00000833 B43E                <1>     mov ah, 0x3E
   118 00000835 CD21                <1>     int 0x21
   119                              <1> 
   120                              <1>     ; Write to VGA DAC registers
   121 00000837 BAC803              <1>     mov dx, 0x03C8
   122 0000083A 30C0                <1>     xor al, al
   123 0000083C EE                  <1>     out dx, al                 ; start from color 0
   124 0000083D 42                  <1>     inc dx
   125 0000083E 8D36[6828]          <1>     lea si, [palette_buffer]
   126 00000842 B90003              <1>     mov cx, 768
   127                              <1> .lp_out:
   128 00000845 AC                  <1>     lodsb
   129 00000846 EE                  <1>     out dx, al
   130 00000847 E2FC                <1>     loop .lp_out
   131                              <1> 
   132                              <1> .lp_exit:
   133 00000849 1F                  <1>     pop ds
   134 0000084A 5E                  <1>     pop si
   135 0000084B 5A                  <1>     pop dx
   136 0000084C 59                  <1>     pop cx
   137 0000084D 5B                  <1>     pop bx
   138 0000084E 58                  <1>     pop ax
   139 0000084F C3                  <1>     ret
   140                              <1> 
   141                              <1> 
   142                              <1> ; ------------------------------------------------------------
   143                              <1> ; Data Buffers and Filenames
   144                              <1> ; ------------------------------------------------------------
   145 00000850 696D67446174612E72- <1> filename          db "imgData.raw",0
   145 00000859 617700              <1>
   146 0000085C 70616C657474652E62- <1> palette_filename  db "palette.bin",0
   146 00000865 696E00              <1>
   147                              <1> 
   148 00000868 00<rep 2000h>       <1> buffer            times CHUNK_SIZE db 0
   149 00002868 00<rep 300h>        <1> palette_buffer    times 768 db 0
   150                              <1> 
   151                              <1> ; NEW: one-byte flag: 0 = palette not loaded yet, 1 = loaded
   152 00002B68 00                  <1> palette_loaded    db 0
