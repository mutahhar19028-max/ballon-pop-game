   160 0000453A 52                  <1>     push dx
   161 0000453B 56                  <1>     push si
   162 0000453C 57                  <1>     push di
   163                              <1> 
   164 0000453D BE[6A32]            <1>     mov si, balloon_array
   165 00004540 B90900              <1>     mov cx, MAX_BALLOONS
   166                              <1> 
   167                              <1> .render_loop:
   168                              <1>     ; Check active flag
   169 00004543 8A4406              <1>     mov al, [si+6]
   170 00004546 3C01                <1>     cmp al, 1
   171 00004548 7524                <1>     jne .next_balloon
   172                              <1> 
   173                              <1>     ; Get balloon data
