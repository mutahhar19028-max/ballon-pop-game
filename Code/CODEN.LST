   576                              <1> ; putPixel (VGA 320x200)
   577                              <1> ; CX=x, DX=y, color in [dt_color]
   578                              <1> ; ======================================================================
   579                              <1> putPixel:
   580 000002C0 50                  <1>     push ax
   581 000002C1 53                  <1>     push bx
   582 000002C2 51                  <1>     push cx
   583 000002C3 52                  <1>     push dx
   584 000002C4 57                  <1>     push di
   585 000002C5 06                  <1>     push es
