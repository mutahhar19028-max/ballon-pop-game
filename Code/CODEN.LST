     1                              <1> ; ============================================================================
     2                              <1> ; drawBalloon - ADJUSTED FOR 24x21 pixels
     3                              <1> ; ============================================================================
     4                              <1> ; INPUT: AX=x, BX=y, CL=color, DL=letter
     5                              <1> ; Draws a wider balloon perfect for 8x8 character at scale 1
     6                              <1> ; ============================================================================
     7                              <1> drawBalloon:
     8 0000477E 50                  <1>     push ax
     9 0000477F 53                  <1>     push bx
    10 00004780 51                  <1>     push cx
    11 00004781 52                  <1>     push dx
    12 00004782 56                  <1>     push si
    13 00004783 57                  <1>     push di
    14 00004784 55                  <1>     push bp
    15                              <1> 
    16 00004785 89E5                <1>     mov bp, sp
    17 00004787 83EC08              <1>     sub sp, 8
    18 0000478A 8946FE              <1>     mov [bp-2], ax          ; Save X
    19 0000478D 895EFC              <1>     mov [bp-4], bx          ; Save Y
    20 00004790 884EFA              <1>     mov [bp-6], cl          ; Save color
    21 00004793 8856F8              <1>     mov [bp-8], dl          ; Save letter
    22                              <1> 
    23                              <1>     ; Draw balloon body (oval shape using filled circle)
    24 00004796 8B46FE              <1>     mov ax, [bp-2]
    25 00004799 83C00C              <1>     add ax, 12              ; Center X (24/2 = 12)
    26 0000479C 8B5EFC              <1>     mov bx, [bp-4]
    27 0000479F 83C308              <1>     add bx, 8               ; Center Y (16/2 = 8, for body height)
    28 000047A2 B90700              <1>     mov cx, 7               ; Radius for oval
    29 000047A5 8A56FA              <1>     mov dl, byte [bp-6]
    30 000047A8 E86BBC              <1>     call drawCircleFilled
    31                              <1> 
    32                              <1>     ; Draw wider horizontal lines to make it oval (not perfectly round)
    33                              <1>     ; Middle horizontal line (widest part)
    34 000047AB 8B46FE              <1>     mov ax, [bp-2]
    35 000047AE 83C002              <1>     add ax, 2
    36 000047B1 8B5EFC              <1>     mov bx, [bp-4]
    37 000047B4 83C308              <1>     add bx, 8               ; Middle Y
    38 000047B7 B91400              <1>     mov cx, 20              ; Width of oval
    39 000047BA 31F6                <1>     xor si, si
    40 000047BC 8B76FA              <1>     mov si, [bp-6]
    41 000047BF 81E6FF00            <1>     and si, 0x00FF
    42 000047C3 E86CB9              <1>     call drawHorizontalLine
    43                              <1> 
    44                              <1>     ; Upper-middle horizontal line
    45 000047C6 8B46FE              <1>     mov ax, [bp-2]
    46 000047C9 83C003              <1>     add ax, 3
    47 000047CC 8B5EFC              <1>     mov bx, [bp-4]
    48 000047CF 83C306              <1>     add bx, 6
    49 000047D2 B91200              <1>     mov cx, 18
    50 000047D5 31F6                <1>     xor si, si
    51 000047D7 8B76FA              <1>     mov si, [bp-6]
    52 000047DA 81E6FF00            <1>     and si, 0x00FF
    53 000047DE E851B9              <1>     call drawHorizontalLine
    54                              <1> 
    55                              <1>     ; Lower-middle horizontal line
    56 000047E1 8B46FE              <1>     mov ax, [bp-2]
    57 000047E4 83C003              <1>     add ax, 3
    58 000047E7 8B5EFC              <1>     mov bx, [bp-4]
    59 000047EA 83C30A              <1>     add bx, 10
    60 000047ED B91200              <1>     mov cx, 18
    61 000047F0 31F6                <1>     xor si, si
    62 000047F2 8B76FA              <1>     mov si, [bp-6]
    63 000047F5 81E6FF00            <1>     and si, 0x00FF
    64 000047F9 E836B9              <1>     call drawHorizontalLine
    65                              <1> 
    66                              <1>     ; Draw balloon outline (darker shade for definition)
    67 000047FC 8B46FE              <1>     mov ax, [bp-2]
    68 000047FF 83C00C              <1>     add ax, 12
    69 00004802 8B5EFC              <1>     mov bx, [bp-4]
    70 00004805 83C308              <1>     add bx, 8
    71 00004808 B90700              <1>     mov cx, 7
    72 0000480B 8A16[1100]          <1>     mov dl, [dark_brown]    ; Dark outline
    73 0000480F E80ABB              <1>     call drawCircleOutline
    74                              <1> 
    75                              <1>     ; Draw knot (small rectangle at bottom of balloon)
    76 00004812 8B46FE              <1>     mov ax, [bp-2]
    77 00004815 83C00A              <1>     add ax, 10              ; Center knot (24/2 - 2 = 10)
    78 00004818 8B5EFC              <1>     mov bx, [bp-4]
    79 0000481B 83C310              <1>     add bx, 16              ; Below balloon body
    80 0000481E B90400              <1>     mov cx, 4               ; Width
    81 00004821 BA0200              <1>     mov dx, 2               ; Height
    82 00004824 31F6                <1>     xor si, si
    83 00004826 8B76FA              <1>     mov si, [bp-6]
    84 00004829 81E6FF00            <1>     and si, 0x00FF
    85 0000482D E869B8              <1>     call drawFilledRect
    86                              <1> 
    87                              <1>     ; Draw string (vertical line)
    88 00004830 8B46FE              <1>     mov ax, [bp-2]
    89 00004833 83C00C              <1>     add ax, 12              ; Center string (24/2 = 12)
    90 00004836 8B5EFC              <1>     mov bx, [bp-4]
    91 00004839 83C312              <1>     add bx, 18              ; Below knot
    92 0000483C BA0300              <1>     mov dx, 3               ; String length
    93 0000483F 31F6                <1>     xor si, si
    94 00004841 8B36[1100]          <1>     mov si, [dark_brown]    ; Dark string
    95 00004845 81E6FF00            <1>     and si, 0x00FF
    96 00004849 E81EB9              <1>     call drawVerticalLine
    97                              <1> 
    98                              <1>     ; Draw letter on balloon (8x8 at scale 1)
    99 0000484C 8B4EFE              <1>     mov cx, [bp-2]
   100 0000484F 83C109              <1>     add cx, 9               ; Center letter X (24/2 - 8/2 = 8)
   101 00004852 8B56FC              <1>     mov dx, [bp-4]
   102 00004855 83C203              <1>     add dx, 3               ; Center letter Y
   103 00004858 B701                <1>     mov bh, 1               ; Scale 1 (8x8 pixels)
   104 0000485A 8A1E[1100]          <1>     mov bl, [dark_brown]    ; Dark letter color for contrast
   105                              <1>     
   106                              <1>     ; Create single-char string
   107 0000485E 83EC02              <1>     sub sp, 2
   108 00004861 89E7                <1>     mov di, sp
   109 00004863 8A46F8              <1>     mov al, [bp-8]          ; Get letter
   110 00004866 8805                <1>     mov [di], al
   111 00004868 C6450100            <1>     mov byte [di+1], 0      ; Null terminator
   112 0000486C 89FE                <1>     mov si, di
   113 0000486E E86FB9              <1>     call drawText
   114 00004871 83C402              <1>     add sp, 2
   115                              <1> 
   116 00004874 83C408              <1>     add sp, 8
   117 00004877 5D                  <1>     pop bp
   118 00004878 5F                  <1>     pop di
   119 00004879 5E                  <1>     pop si
   120 0000487A 5A                  <1>     pop dx
   121 0000487B 59                  <1>     pop cx
   122 0000487C 5B                  <1>     pop bx
   123 0000487D 58                  <1>     pop ax
   124 0000487E C3                  <1>     ret
