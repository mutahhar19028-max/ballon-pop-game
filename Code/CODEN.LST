   249 000045A8 8306[E905]0A        <1>     add word [current_score], 10
   250                              <1> 
   251 000045AD B001                <1>     mov al, 1
   252                              <1> 
   253                              <1> .done:
   254 000045AF 5E                  <1>     pop si
   255 000045B0 59                  <1>     pop cx
   256 000045B1 5B                  <1>     pop bx
   257 000045B2 C3                  <1>     ret
   258                              <1> 
