    60 00000065 8B5EFC              <1>     mov bx, [bp-4]
    61 00000068 035EF8              <1>     add bx, [bp-8]
    62 0000006B 83EB02              <1>     sub bx, 2
    63 0000006E 8B4EFA              <1>     mov cx, [bp-6]
    64 00000071 83E904              <1>     sub cx, 4
    65 00000074 BA0200              <1>     mov dx, 2
