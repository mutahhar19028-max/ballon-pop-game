   174 00002EC6 54494D453A00        <1> timer_label_text    db "TIME:", 0
   175                              <1> 
   176                              <1> ; ------------------------------------------------------------
   177                              <1> ; drawTimerValue
   178                              <1> ; Draws the current timer value in MM:SS format
   179                              <1> ; Called every frame by drawTimerPanel
   180                              <1> ; Reads current values from timer_minutes and timer_display_sec
   181                              <1> ; These variables are updated by the timer ISR (once per second)
   182                              <1> ; ------------------------------------------------------------
   183                              <1> drawTimerValue:
   184 00002ECC 50                  <1>     push ax
   185 00002ECD 53                  <1>     push bx
   186 00002ECE 51                  <1>     push cx
   187 00002ECF 52                  <1>     push dx
   188 00002ED0 56                  <1>     push si
   189 00002ED1 57                  <1>     push di
   190 00002ED2 55                  <1>     push bp
   191                              <1> 
   192                              <1>     ; Allocate 6 bytes on stack for timer string "MM:SS\0"
   193 00002ED3 83EC06              <1>     sub sp, 6
   194 00002ED6 89E5                <1>     mov bp, sp              ; BP points to buffer
   195                              <1> 
   196                              <1>     ; Build "MM:SS" string from current timer values
   197                              <1>     ; --- Minutes tens digit ---
   198 00002ED8 30E4                <1>     xor ah, ah
   199 00002EDA A0[FC05]            <1>     mov al, [timer_minutes]
   200 00002EDD B30A                <1>     mov bl, 10
   201 00002EDF F6F3                <1>     div bl                  ; AL = tens, AH = ones
   202 00002EE1 0430                <1>     add al, '0'             ; Convert to ASCII
   203 00002EE3 884600              <1>     mov [bp], al            ; Store tens digit
   204                              <1>     
   205                              <1>     ; --- Minutes ones digit ---
   206 00002EE6 88E0                <1>     mov al, ah              ; Get ones from AH
   207 00002EE8 0430                <1>     add al, '0'
   208 00002EEA 884601              <1>     mov [bp+1], al
   209                              <1> 
   210                              <1>     ; --- Colon separator ---
   211 00002EED C646023A            <1>     mov byte [bp+2], ':'
   212                              <1> 
   213                              <1>     ; --- Seconds tens digit ---
   214 00002EF1 30E4                <1>     xor ah, ah
   215 00002EF3 A0[FD05]            <1>     mov al, [timer_display_sec]
   216 00002EF6 B30A                <1>     mov bl, 10
   217 00002EF8 F6F3                <1>     div bl                  ; AL = tens, AH = ones
   218 00002EFA 0430                <1>     add al, '0'
   219 00002EFC 884603              <1>     mov [bp+3], al
   220                              <1> 
   221                              <1>     ; --- Seconds ones digit ---
   222 00002EFF 88E0                <1>     mov al, ah
   223 00002F01 0430                <1>     add al, '0'
   224 00002F03 884604              <1>     mov [bp+4], al
   225                              <1> 
   226                              <1>     ; --- Null terminator ---
   227 00002F06 C6460500            <1>     mov byte [bp+5], 0
   228                              <1> 
   229                              <1>     ; Draw the timer string at defined position
   230 00002F0A B90301              <1>     mov cx, TIMER_VALUE_X
   231 00002F0D BA0A00              <1>     mov dx, TIMER_VALUE_Y
   232 00002F10 89EE                <1>     mov si, bp              ; SI points to our string buffer
   233 00002F12 8A1E[1100]          <1>     mov bl, [dark_brown]    ; Text color
   234 00002F16 B701                <1>     mov bh, 1              ; Scale (2 = medium size)
   235 00002F18 E8C5D2              <1>     call drawText
   236                              <1> 
   237                              <1>     ; Clean up stack
   238 00002F1B 83C406              <1>     add sp, 6
   239                              <1> 
   240 00002F1E 5D                  <1>     pop bp
   241 00002F1F 5F                  <1>     pop di
   242 00002F20 5E                  <1>     pop si
   243 00002F21 5A                  <1>     pop dx
   244 00002F22 59                  <1>     pop cx
   245 00002F23 5B                  <1>     pop bx
   246 00002F24 58                  <1>     pop ax
   247 00002F25 C3                  <1>     ret
   248                              <1> 
   249                              <1> ; ------------------------------------------------------------
