   108                              <1> ; ------------------------------------------------------------
   109                              <1> ; updateBalloons
   110                              <1> ; ------------------------------------------------------------
   111                              <1> updateBalloons:
   112 000044FD 50                  <1>     push ax
   113 000044FE 53                  <1>     push bx
   114 000044FF 51                  <1>     push cx
   115 00004500 52                  <1>     push dx
   116                              <1> 
   117                              <1>     ; Restore old backgrounds first
   118 00004501 E8CB00              <1>     call restoreAllBackgrounds
   119                              <1> 
   120                              <1>     ; Check spawn timer
   121 00004504 FF06[FB32]          <1>     inc word [spawn_timer]
   122 00004508 A1[FB32]            <1>     mov ax, [spawn_timer]
   123 0000450B 83F864              <1>     cmp ax, SPAWN_DELAY
   124 0000450E 7209                <1>     jb .skip_spawn
   125                              <1>     
   126 00004510 E8AA01              <1>     call spawnBalloon
   127 00004513 C706[FB32]0000      <1>     mov word [spawn_timer], 0
   128                              <1> 
   129                              <1> .skip_spawn:
   130                              <1>     ; Check movement timer (move every N frames)
   131 00004519 FE06[FF32]          <1>     inc byte [movement_counter]
   132 0000451D A0[FF32]            <1>     mov al, [movement_counter]
   133 00004520 3C03                <1>     cmp al, MOVEMENT_DELAY
   134 00004522 7208                <1>     jb .skip_move
   135                              <1>     
   136 00004524 C606[FF32]00        <1>     mov byte [movement_counter], 0
   137 00004529 E8ED01              <1>     call moveBalloons           ; Only move every MOVEMENT_DELAY frames
   138                              <1>     
   139                              <1> .skip_move:
   140                              <1>     ; Remove off-screen balloons
   141 0000452C E80B02              <1>     call removeOffscreenBalloons
   142                              <1> 
   143                              <1>     ; Save new backgrounds
   144 0000452F E88100              <1>     call saveAllBackgrounds
   145                              <1> 
   146 00004532 5A                  <1>     pop dx
   147 00004533 59                  <1>     pop cx
   148 00004534 5B                  <1>     pop bx
   149 00004535 58                  <1>     pop ax
   150 00004536 C3                  <1>     ret
   151                              <1> 
