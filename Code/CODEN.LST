   870                              <1>     
   871 000004B9 8B46F2              <1>     mov ax, [bp-14]
   872 000004BC 8B56F6              <1>     mov dx, [bp-10]
   873 000004BF D1E2                <1>     shl dx, 1
   874 000004C1 8B76F4              <1>     mov si, [bp-12]
   875 000004C4 D1E6                <1>     shl si, 1
   876 000004C6 29F2                <1>     sub dx, si
   877 000004C8 01D0                <1>     add ax, dx
   878 000004CA 83C005              <1>     add ax, 5
   879 000004CD 8946F2              <1>     mov [bp-14], ax
   880 000004D0 FF4EF4              <1>     dec word [bp-12]
   881 000004D3 EB10                <1>     jmp .f_d_done
   882                              <1> 
   883                              <1> .f_d_less_zero:
   884 000004D5 8B46F2              <1>     mov ax, [bp-14]
   885 000004D8 8B56F6              <1>     mov dx, [bp-10]
   886 000004DB D1E2                <1>     shl dx, 1
   887 000004DD 01D0                <1>     add ax, dx
   888 000004DF 83C003              <1>     add ax, 3
   889 000004E2 8946F2              <1>     mov [bp-14], ax
   890                              <1> 
   891                              <1> .f_d_done:
   892 000004E5 FF46F6              <1>     inc word [bp-10]
   893 000004E8 8B46F6              <1>     mov ax, [bp-10]
   894 000004EB 3B46F4              <1>     cmp ax, [bp-12]
   895 000004EE 0F8E4BFF            <1>     jle .fill_loop
   896                              <1> 
   897 000004F2 83C410              <1>     add sp, 16
   898 000004F5 5D                  <1>     pop bp
   899 000004F6 5F                  <1>     pop di
   900 000004F7 5E                  <1>     pop si
   901 000004F8 5A                  <1>     pop dx
   902 000004F9 59                  <1>     pop cx
   903 000004FA 5B                  <1>     pop bx
   904 000004FB 58                  <1>     pop ax
   905 000004FC C3                  <1>     ret
