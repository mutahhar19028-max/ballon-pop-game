   160                              <1> ; === SCORE PANEL ===
   161                              <1> %define SCORE_PANEL_X       (MAX_WIDTH / 2) -  (SCORE_PANEL_WIDTH / 2) - 8 * PADDING - 20
   162                              <1> %define SCORE_PANEL_Y       2 * PADDING
   163                              <1> %define SCORE_PANEL_WIDTH   BOX_WIDTH
   164                              <1> %define SCORE_PANEL_HEIGHT  BOX_HEIGHT
   165                              <1> %define SCORE_PANEL_COLOR   [light_orange]
   166                              <1> %define SCORE_BORDER_COLOR  [dark_orange]
   167                              <1> %define SCORE_TEXT_X        (SCORE_PANEL_X + (SCORE_PANEL_WIDTH / 16)) + PADDING
   168                              <1> %define SCORE_TEXT_Y        ((SCORE_PANEL_Y + SCORE_PANEL_HEIGHT) / 2) - PADDING
   169                              <1> %define SCORE_VALUE_X       ((SCORE_PANEL_X + (SCORE_PANEL_WIDTH / 2)) + (SCORE_PANEL_WIDTH / 3))
   170                              <1> %define SCORE_VALUE_Y       ((SCORE_PANEL_Y + SCORE_PANEL_HEIGHT) / 2)
   171                              <1> 
