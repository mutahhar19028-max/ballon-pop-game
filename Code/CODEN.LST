   727 0000039D 8B4EFE              <1>     mov cx, [bp-2]
   728 000003A0 2B4EF4              <1>     sub cx, [bp-12]
   729 000003A3 8B56FC              <1>     mov dx, [bp-4]
   730 000003A6 0356F6              <1>     add dx, [bp-10]
