   119 00002C10 B0FF                <1>     mov al, 0xFF
   120 00002C12 5A                  <1>     pop dx
   121 00002C13 59                  <1>     pop cx
   122 00002C14 5B                  <1>     pop bx
   123 00002C15 C3                  <1>     ret
