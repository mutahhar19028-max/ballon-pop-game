    43 00000038 8B4EFA              <1>     mov cx, [bp-6]
    44 0000003B 8B56F8              <1>     mov dx, [bp-8]
    45 0000003E 83EA04              <1>     sub dx, 4
    46 00000041 8B76F6              <1>     mov si, [bp-10]
    47 00000044 E85200              <1>     call drawFilledRect
    48                              <1> 
    49 00000047 8B46FE              <1>     mov ax, [bp-2]
    50 0000004A 83C002              <1>     add ax, 2
    51 0000004D 8B5EFC              <1>     mov bx, [bp-4]
    52 00000050 8B4EFA              <1>     mov cx, [bp-6]
    53 00000053 83E904              <1>     sub cx, 4
    54 00000056 BA0200              <1>     mov dx, 2
    55 00000059 8B76F6              <1>     mov si, [bp-10]
    56 0000005C E83A00              <1>     call drawFilledRect
    57                              <1> 
    58 0000005F 8B46FE              <1>     mov ax, [bp-2]
