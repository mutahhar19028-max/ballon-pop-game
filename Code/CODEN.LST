   907                              <1> ; ------------------------------------------------------------
   908                              <1> ; clearScreen320x200
   909                              <1> ; Clears entire 320x200 VGA screen to specified color
   910                              <1> ; INPUT: AL = Color value (0-255)
   911                              <1> ; Uses BIOS interrupt for compatibility
   912                              <1> ; ------------------------------------------------------------
   913                              <1> clearScreen320x200:
   914 000004FD 50                  <1>     push ax
   915 000004FE 53                  <1>     push bx
   916 000004FF 51                  <1>     push cx
   917 00000500 52                  <1>     push dx
   918 00000501 57                  <1>     push di
   919 00000502 06                  <1>     push es
   920                              <1> 
   921                              <1>     ; Method 1: Direct VGA memory write (faster)
   922 00000503 BB00A0              <1>     mov bx, VGA_SEGMENT
   923 00000506 8EC3                <1>     mov es, bx
   924 00000508 31FF                <1>     xor di, di
   925 0000050A B900FA              <1>     mov cx, SCREEN_WIDTH * SCREEN_HEIGHT   ; 64000
   926 0000050D 88C4                <1>     mov ah, al              ; Duplicate color in AH
   927 0000050F F3AA                <1>     rep stosb
   928                              <1> 
   929 00000511 07                  <1>     pop es
   930 00000512 5F                  <1>     pop di
   931 00000513 5A                  <1>     pop dx
   932 00000514 59                  <1>     pop cx
   933 00000515 5B                  <1>     pop bx
   934 00000516 58                  <1>     pop ax
   935 00000517 C3                  <1>     ret
   936                              <1> 
   937                              <1> ; ------------------------------------------------------------
   938                              <1> ; clearScreenBIOS
   939                              <1> ; Alternative: Uses BIOS scroll to clear screen (slower but safer)
   940                              <1> ; INPUT: AL = Color value
   941                              <1> ; ------------------------------------------------------------
   942                              <1> clearScreenBIOS:
   943 00000518 50                  <1>     push ax
   944 00000519 53                  <1>     push bx
   945 0000051A 51                  <1>     push cx
   946 0000051B 52                  <1>     push dx
   947                              <1> 
   948                              <1>     ; BIOS: Scroll window (clear screen)
   949 0000051C B406                <1>     mov ah, 0x06        ; Scroll up function
   950 0000051E B000                <1>     mov al, 0           ; Clear entire window
   951 00000520 B700                <1>     mov bh, 0           ; Attribute (ignored in mode 13h)
   952 00000522 B90000              <1>     mov cx, 0           ; Upper left (0,0)
   953 00000525 BA13C8              <1>     mov dx, 0xC813      ; Lower right (200, 320 in rows/cols)
   954 00000528 CD10                <1>     int 0x10
   955                              <1> 
   956 0000052A 5A                  <1>     pop dx
   957 0000052B 59                  <1>     pop cx
   958 0000052C 5B                  <1>     pop bx
   959 0000052D 58                  <1>     pop ax
   960 0000052E C3                  <1>     ret
   961                              <1> 
   962                              <1> ; ------------------------------------------------------------
   963                              <1> ; setVideoMode13h
   964                              <1> ; Sets VGA mode 320x200x256 using BIOS interrupt
   965                              <1> ; ------------------------------------------------------------
   966                              <1> setVideoMode13h:
   967 0000052F 50                  <1>     push ax
   968 00000530 B81300              <1>     mov ax, 0x0013
   969 00000533 CD10                <1>     int 0x10
   970 00000535 58                  <1>     pop ax
   971 00000536 C3                  <1>     ret
   972                              <1> 
   973                              <1> ; ------------------------------------------------------------
   974                              <1> ; setTextMode
   975                              <1> ; Returns to text mode 80x25
   976                              <1> ; ------------------------------------------------------------
   977                              <1> setTextMode:
   978 00000537 50                  <1>     push ax
   979 00000538 B80300              <1>     mov ax, 0x0003
   980 0000053B CD10                <1>     int 0x10
   981 0000053D 58                  <1>     pop ax
   982 0000053E C3                  <1>     ret
