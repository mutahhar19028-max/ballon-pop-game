   322                              <1> ; ------------------------------------------------------------
   323                              <1> ; saveBalloonBackground
   324                              <1> ; INPUT: SI = pointer to balloon structure
   325                              <1> ; Saves 16x14 pixel area to buffer
   326                              <1> ; ------------------------------------------------------------
   327                              <1> saveBalloonBackground:
   328 000045EB 50                  <1>     push ax
   329 000045EC 53                  <1>     push bx
   330 000045ED 51                  <1>     push cx
   331 000045EE 52                  <1>     push dx
   332 000045EF 57                  <1>     push di
   333 000045F0 56                  <1>     push si
   334 000045F1 06                  <1>     push es
   335 000045F2 1E                  <1>     push ds
   336                              <1> 
   337                              <1>     ; Get balloon position
   338 000045F3 8B04                <1>     mov ax, [si+0]              ; X
   339 000045F5 8B5C02              <1>     mov bx, [si+2]              ; Y
   340 000045F8 8B7C08              <1>     mov di, [si+8]              ; Buffer offset
   341                              <1> 
   342                              <1>     ; Check bounds
   343 000045FB 83FB00              <1>     cmp bx, 0
   344 000045FE 7C4F                <1>     jl .done_save
   345 00004600 81FBC800            <1>     cmp bx, 200
   346 00004604 7D49                <1>     jge .done_save
   347                              <1> 
   348                              <1>     ; Setup segments
   349 00004606 BA00A0              <1>     mov dx, 0xA000
   350 00004609 8EDA                <1>     mov ds, dx                  ; DS = VGA segment
   351 0000460B 0E                  <1>     push cs
   352 0000460C 07                  <1>     pop es                      ; ES = our data segment
   353 0000460D 81C7[0033]          <1>     add di, background_buffer   ; DI = buffer address
   354                              <1> 
   355                              <1>     ; Save 14 rows
   356 00004611 B91500              <1>     mov cx, BALLOON_HEIGHT
   357                              <1> 
   358                              <1> .save_row:
   359 00004614 51                  <1>     push cx
   360 00004615 50                  <1>     push ax
   361 00004616 53                  <1>     push bx
   362                              <1> 
   363                              <1>     ; Check if row is visible
   364 00004617 83FB00              <1>     cmp bx, 0
   365 0000461A 7C22                <1>     jl .skip_row
   366 0000461C 81FBC800            <1>     cmp bx, 200
   367 00004620 7D1C                <1>     jge .skip_row
   368                              <1> 
   369                              <1>     ; Calculate VGA offset: Y * 320 + X
   370 00004622 50                  <1>     push ax
   371 00004623 89D8                <1>     mov ax, bx
   372 00004625 BA4001              <1>     mov dx, 320
   373 00004628 F7E2                <1>     mul dx
   374 0000462A 5A                  <1>     pop dx
   375 0000462B 01D0                <1>     add ax, dx                  ; AX = VGA offset
   376 0000462D 89C6                <1>     mov si, ax
   377                              <1> 
   378                              <1>     ; Copy 16 pixels
   379 0000462F B91800              <1>     mov cx, BALLOON_WIDTH
   380                              <1> .copy_pixel:
   381 00004632 3E8A04              <1>     mov al, [ds:si]
   382 00004635 268805              <1>     mov [es:di], al
   383 00004638 46                  <1>     inc si
   384 00004639 47                  <1>     inc di
   385 0000463A E2F6                <1>     loop .copy_pixel
   386 0000463C EB0B                <1>     jmp .next_row
   387                              <1> 
   388                              <1> .skip_row:
   389                              <1>     ; Fill with zeros if off-screen
   390 0000463E B91800              <1>     mov cx, BALLOON_WIDTH
   391 00004641 30C0                <1>     xor al, al
   392                              <1> .fill_zero:
   393 00004643 268805              <1>     mov [es:di], al
   394 00004646 47                  <1>     inc di
   395 00004647 E2FA                <1>     loop .fill_zero
   396                              <1> 
   397                              <1> .next_row:
   398 00004649 5B                  <1>     pop bx
   399 0000464A 58                  <1>     pop ax
   400 0000464B 43                  <1>     inc bx                      ; Next Y
   401 0000464C 59                  <1>     pop cx
   402 0000464D E2C5                <1>     loop .save_row
   403                              <1> 
   404                              <1> .done_save:
   405 0000464F 1F                  <1>     pop ds
   406 00004650 07                  <1>     pop es
   407 00004651 5E                  <1>     pop si
   408 00004652 5F                  <1>     pop di
   409 00004653 5A                  <1>     pop dx
   410 00004654 59                  <1>     pop cx
   411 00004655 5B                  <1>     pop bx
   412 00004656 58                  <1>     pop ax
   413 00004657 C3                  <1>     ret
   414                              <1> 
   415                              <1> 
   416                              <1> ; ------------------------------------------------------------
   417                              <1> ; restoreBalloonBackground
   418                              <1> ; INPUT: SI = pointer to balloon structure
   419                              <1> ; Restores 16x14 pixel area from buffer
   420                              <1> ; ------------------------------------------------------------
   421                              <1> restoreBalloonBackground:
   422 00004658 50                  <1>     push ax
   423 00004659 53                  <1>     push bx
   424 0000465A 51                  <1>     push cx
   425 0000465B 52                  <1>     push dx
   426 0000465C 57                  <1>     push di
   427 0000465D 56                  <1>     push si
   428 0000465E 06                  <1>     push es
   429 0000465F 1E                  <1>     push ds
   430                              <1> 
   431                              <1>     ; Get balloon position
   432 00004660 8B04                <1>     mov ax, [si+0]              ; X
