    23                              <1> .loopNotes:
    24 00000633 AD                  <1>     lodsw                  ; AX = frequency
    25 00000634 09C0                <1>     or  ax, ax
    26 00000636 7405                <1>     jz  .done
    27 00000638 E80800              <1>     call playTone
    28 0000063B E2F6                <1>     loop .loopNotes
    29                              <1> 
    30                              <1> .done:
    31 0000063D 5E                  <1>     pop si
    32 0000063E 5A                  <1>     pop dx
    33 0000063F 59                  <1>     pop cx
    34 00000640 5B                  <1>     pop bx
    35 00000641 58                  <1>     pop ax
    36 00000642 C3                  <1>     ret
    37                              <1> 
    38                              <1> ; ---------------------------------------
    39                              <1> ; playTone — AX = frequency (Hz)
    40                              <1> ; ---------------------------------------
    41                              <1> playTone:
    42 00000643 50                  <1>     push ax
    43 00000644 53                  <1>     push bx
    44 00000645 51                  <1>     push cx
    45 00000646 52                  <1>     push dx
    46                              <1> 
    47 00000647 89C3                <1>     mov bx, ax              ; Save frequency in BX
    48                              <1>     
    49                              <1>     ; Load 1193180 into DX:AX
    50 00000649 A1[2406]            <1>     mov ax, word [pit_constant]      ; Low word
    51 0000064C 8B16[2606]          <1>     mov dx, word [pit_constant + 2]  ; High word
    52                              <1>     
    53                              <1>     ; Divide DX:AX by BX -> quotient in AX
    54 00000650 F7F3                <1>     div bx                  ; DX:AX / BX = AX (remainder in DX)
    55 00000652 89C3                <1>     mov bx, ax              ; BX = divisor
    56                              <1> 
    57                              <1>     ; Program PIT channel 2
    58 00000654 B0B6                <1>     mov al, 0xB6
    59 00000656 E643                <1>     out 0x43, al
    60 00000658 89D8                <1>     mov ax, bx
    61 0000065A E642                <1>     out 0x42, al            ; low byte
    62 0000065C 88E0                <1>     mov al, ah
    63 0000065E E642                <1>     out 0x42, al            ; high byte
    64                              <1> 
    65                              <1>     ; Enable speaker
    66 00000660 E461                <1>     in al, 0x61
    67 00000662 0C03                <1>     or al, 3
    68 00000664 E661                <1>     out 0x61, al
    69                              <1> 
    70                              <1>     ; Hold tone
    71 00000666 E80B00              <1>     call toneDelay
    72                              <1> 
    73                              <1>     ; Disable speaker
    74 00000669 E461                <1>     in al, 0x61
    75 0000066B 24FC                <1>     and al, 0xFC
    76 0000066D E661                <1>     out 0x61, al
    77                              <1> 
    78 0000066F 5A                  <1>     pop dx
    79 00000670 59                  <1>     pop cx
    80 00000671 5B                  <1>     pop bx
    81 00000672 58                  <1>     pop ax
    82 00000673 C3                  <1>     ret
    83                              <1> 
    84                              <1> ; ---------------------------------------
    85                              <1> ; toneDelay — simple busy wait
    86                              <1> ; ---------------------------------------
    87                              <1> toneDelay:
    88 00000674 51                  <1>     push cx
    89 00000675 52                  <1>     push dx
    90 00000676 8B16[2206]          <1>     mov dx, [tempo]
    91                              <1> .delayOuter:
    92 0000067A B9FFAF              <1>     mov cx, 0xAFFF
    93                              <1> .delayInner:
    94 0000067D E2FE                <1>     loop .delayInner
    95 0000067F 4A                  <1>     dec dx
    96 00000680 75F8                <1>     jnz .delayOuter
    97 00000682 5A                  <1>     pop dx
    98 00000683 59                  <1>     pop cx
    99 00000684 C3                  <1>     ret
    12                                  %include "Code\show_bg.asm"
     1                              <1> ; ============================================================
     2                              <1> ; show_bg.asm — Draws VGA 320x200x256 background with palette
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> ; No ORG / BITS — This is a callable module
     6                              <1> 
     7                              <1> %define MODE_VGA13H  0x0013
     8                              <1> %define VIDEO_SEG    0xA000
     9                              <1> %define SCREEN_SIZE  64000
    10                              <1> %define CHUNK_SIZE   8192
    11                              <1> 
    12                              <1> ; ------------------------------------------------------------
    13                              <1> ; PUBLIC: showBackground320x200
    14                              <1> ; Loads and displays final.raw using vga.bin palette
    15                              <1> ; ------------------------------------------------------------
    16                              <1> showBackground320x200:
    17 00000685 50                  <1>     push ax
    18 00000686 53                  <1>     push bx
    19 00000687 51                  <1>     push cx
    20 00000688 52                  <1>     push dx
    21 00000689 56                  <1>     push si
    22 0000068A 57                  <1>     push di
    23 0000068B 1E                  <1>     push ds
    24 0000068C 06                  <1>     push es
    25                              <1> 
    26                              <1>     ; --------------------------------------------------------
    27                              <1>     ; Load custom 256-color palette from "vga.bin"
    28                              <1>     ; --------------------------------------------------------
    29 0000068D E84900              <1>     call load_palette
    30                              <1> 
    31                              <1>     ; --------------------------------------------------------
    32                              <1>     ; Load and display background image from "final.raw"
    33                              <1>     ; --------------------------------------------------------
    34 00000690 B800A0              <1>     mov ax, VIDEO_SEG
    35 00000693 8EC0                <1>     mov es, ax
    36 00000695 31FF                <1>     xor di, di
    37                              <1> 
    38                              <1>     ; Open RAW file (read-only)
    39 00000697 8D16[1507]          <1>     lea dx, [filename]
    40 0000069B B43D                <1>     mov ah, 0x3D
    41 0000069D 30C0                <1>     xor al, al
    42 0000069F CD21                <1>     int 0x21
    43 000006A1 722D                <1>     jc .cleanup
    44 000006A3 89C3                <1>     mov bx, ax                  ; BX = file handle
    45                              <1> 
    46                              <1> .read_loop:
    47                              <1>     ; Read chunk into buffer
    48 000006A5 B43F                <1>     mov ah, 0x3F
    49 000006A7 B90020              <1>     mov cx, CHUNK_SIZE
    50 000006AA 8D16[2D07]          <1>     lea dx, [buffer]
    51 000006AE CD21                <1>     int 0x21
    52 000006B0 721A                <1>     jc .close_file
    53 000006B2 09C0                <1>     or ax, ax
    54 000006B4 7416                <1>     jz .close_file              ; EOF reached
    55                              <1> 
    56                              <1>     ; Copy to VGA memory (use ES:DI for video, DS:SI for buffer)
    57 000006B6 1E                  <1>     push ds
    58 000006B7 BE[2D07]            <1>     mov si, buffer
    59 000006BA 89C1                <1>     mov cx, ax
    60                              <1> .copy_loop:
    61 000006BC 8A04                <1>     mov al, [si]
    62 000006BE 268805              <1>     mov [es:di], al
    63 000006C1 46                  <1>     inc si
    64 000006C2 47                  <1>     inc di
    65 000006C3 E2F7                <1>     loop .copy_loop
    66 000006C5 1F                  <1>     pop ds
    67                              <1> 
    68 000006C6 81FF00FA            <1>     cmp di, SCREEN_SIZE
    69 000006CA 72D9                <1>     jb .read_loop
    70                              <1> 
    71                              <1> .close_file:
    72 000006CC B43E                <1>     mov ah, 0x3E
    73 000006CE CD21                <1>     int 0x21
    74                              <1> 
    75                              <1> .cleanup:
    76 000006D0 07                  <1>     pop es
    77 000006D1 1F                  <1>     pop ds
    78 000006D2 5F                  <1>     pop di
    79 000006D3 5E                  <1>     pop si
    80 000006D4 5A                  <1>     pop dx
    81 000006D5 59                  <1>     pop cx
    82 000006D6 5B                  <1>     pop bx
    83 000006D7 58                  <1>     pop ax
    84 000006D8 C3                  <1>     ret
    85                              <1> 
    86                              <1> 
    87                              <1> ; ------------------------------------------------------------
    88                              <1> ; load_palette — Loads "vga.bin" and programs VGA DAC registers
    89                              <1> ; ------------------------------------------------------------
    90                              <1> load_palette:
    91 000006D9 50                  <1>     push ax
    92 000006DA 53                  <1>     push bx
    93 000006DB 51                  <1>     push cx
    94 000006DC 52                  <1>     push dx
    95 000006DD 56                  <1>     push si
    96 000006DE 1E                  <1>     push ds
    97                              <1> 
    98                              <1>     ; Open palette file
    99 000006DF 8D16[2107]          <1>     lea dx, [palette_filename]
   100 000006E3 B43D                <1>     mov ah, 0x3D
   101 000006E5 30C0                <1>     xor al, al
   102 000006E7 CD21                <1>     int 0x21
   103 000006E9 7223                <1>     jc .lp_exit
   104 000006EB 89C3                <1>     mov bx, ax
   105                              <1> 
   106                              <1>     ; Read 768 bytes (256 colors * 3 bytes)
   107 000006ED B43F                <1>     mov ah, 0x3F
   108 000006EF B90003              <1>     mov cx, 768
   109 000006F2 8D16[2D27]          <1>     lea dx, [palette_buffer]
   110 000006F6 CD21                <1>     int 0x21
   111                              <1> 
   112                              <1>     ; Close palette file
   113 000006F8 B43E                <1>     mov ah, 0x3E
   114 000006FA CD21                <1>     int 0x21
   115                              <1> 
   116                              <1>     ; Write to VGA DAC registers
   117 000006FC BAC803              <1>     mov dx, 0x03C8
   118 000006FF 30C0                <1>     xor al, al
   119 00000701 EE                  <1>     out dx, al                 ; start from color 0
   120 00000702 42                  <1>     inc dx
   121 00000703 8D36[2D27]          <1>     lea si, [palette_buffer]
   122 00000707 B90003              <1>     mov cx, 768
   123                              <1> .lp_out:
   124 0000070A AC                  <1>     lodsb
   125 0000070B EE                  <1>     out dx, al
   126 0000070C E2FC                <1>     loop .lp_out
   127                              <1> 
   128                              <1> .lp_exit:
   129 0000070E 1F                  <1>     pop ds
   130 0000070F 5E                  <1>     pop si
   131 00000710 5A                  <1>     pop dx
   132 00000711 59                  <1>     pop cx
   133 00000712 5B                  <1>     pop bx
   134 00000713 58                  <1>     pop ax
   135 00000714 C3                  <1>     ret
   136                              <1> 
   137                              <1> 
   138                              <1> ; ------------------------------------------------------------
   139                              <1> ; Data Buffers and Filenames
   140                              <1> ; ------------------------------------------------------------
   141 00000715 696D67446174612E72- <1> filename          db "imgData.raw",0
   141 0000071E 617700              <1>
   142 00000721 70616C657474652E62- <1> palette_filename  db "palette.bin",0
   142 0000072A 696E00              <1>
   143                              <1> 
   144 0000072D 00<rep 2000h>       <1> buffer            times CHUNK_SIZE db 0
   145 0000272D 00<rep 300h>        <1> palette_buffer    times 768 db 0
    13                                  %include "Code\navigation.asm"      ; NEW: Navigation system
     1                              <1> ; ============================================================
     2                              <1> ; navigation.asm — Menu Navigation System with Arrow Keys
     3                              <1> ; ============================================================
     4                              <1> 
     5                              <1> ; ------------------------------------------------------------
     6                              <1> ; handleMainMenuInput
     7                              <1> ; Handles arrow key navigation and Enter selection
     8                              <1> ; RETURNS: AL = selected option (0=Play, 1=Help, 2=Exit, 0xFF=ESC)
     9                              <1> ; ------------------------------------------------------------
    10                              <1> handleMainMenuInput:
    11 00002A2D 53                  <1>     push bx
    12 00002A2E 51                  <1>     push cx
    13 00002A2F 52                  <1>     push dx
    14                              <1> 
    15                              <1>     ; Initialize selection to first option
    16 00002A30 C606[0006]00        <1>     mov byte [current_selection], MENU_OPTION_PLAY
    17                              <1> 
    18                              <1> .input_loop:
    19                              <1>     ; Draw arrow at current selection
    20 00002A35 E85800              <1>     call drawMenuArrow
    21                              <1> 
    22                              <1>     ; Wait for keypress
    23 00002A38 B400                <1>     mov ah, 0x00
    24 00002A3A CD16                <1>     int 0x16                ; AH=scan code, AL=ASCII
    25                              <1> 
    26 00002A3C 80FC48              <1>     cmp ah, KEY_UP
    27 00002A3F 7411                <1>     je .move_up
    28 00002A41 80FC50              <1>     cmp ah, KEY_DOWN
    29 00002A44 7423                <1>     je .move_down
    30 00002A46 80FC1C              <1>     cmp ah, KEY_ENTER
    31 00002A49 7435                <1>     je .select_option
    32 00002A4B 80FC01              <1>     cmp ah, KEY_ESC
    33 00002A4E 743A                <1>     je .exit_pressed
    34 00002A50 EBE3                <1>     jmp .input_loop         ; Ignore other keys
    35                              <1> 
    36                              <1> .move_up:
    37                              <1>     ; Clear current arrow
    38 00002A52 E86000              <1>     call clearMenuArrow
    39                              <1>     
    40                              <1>     ; Move selection up (with wrap-around)
    41 00002A55 A0[0006]            <1>     mov al, [current_selection]
    42 00002A58 3C00                <1>     cmp al, 0
    43 00002A5A 7406                <1>     je .wrap_to_bottom
    44 00002A5C FE0E[0006]          <1>     dec byte [current_selection]
    45 00002A60 EBD3                <1>     jmp .input_loop
    46                              <1> 
    47                              <1> .wrap_to_bottom:
    48 00002A62 C606[0006]02        <1>     mov byte [current_selection], TOTAL_MENU_OPTIONS - 1
    49 00002A67 EBCC                <1>     jmp .input_loop
    50                              <1> 
    51                              <1> .move_down:
    52                              <1>     ; Clear current arrow
    53 00002A69 E84900              <1>     call clearMenuArrow
    54                              <1>     
    55                              <1>     ; Move selection down (with wrap-around)
    56 00002A6C A0[0006]            <1>     mov al, [current_selection]
    57 00002A6F 3C02                <1>     cmp al, TOTAL_MENU_OPTIONS - 1
    58 00002A71 7406                <1>     je .wrap_to_top
    59 00002A73 FE06[0006]          <1>     inc byte [current_selection]
    60 00002A77 EBBC                <1>     jmp .input_loop
    61                              <1> 
    62                              <1> .wrap_to_top:
    63 00002A79 C606[0006]00        <1>     mov byte [current_selection], 0
    64 00002A7E EBB5                <1>     jmp .input_loop
    65                              <1> 
    66                              <1> .select_option:
    67 00002A80 E83200              <1>     call clearMenuArrow
    68 00002A83 A0[0006]            <1>     mov al, [current_selection]
    69 00002A86 5A                  <1>     pop dx
    70 00002A87 59                  <1>     pop cx
    71 00002A88 5B                  <1>     pop bx
    72 00002A89 C3                  <1>     ret
    73                              <1> 
    74                              <1> .exit_pressed:
    75 00002A8A B0FF                <1>     mov al, 0xFF            ; Return special value for ESC
    76 00002A8C 5A                  <1>     pop dx
    77 00002A8D 59                  <1>     pop cx
    78 00002A8E 5B                  <1>     pop bx
    79 00002A8F C3                  <1>     ret
    80                              <1> 
    81                              <1> ; ------------------------------------------------------------
    82                              <1> ; drawMenuArrow
    83                              <1> ; Draws '>' arrow at current selection position
    84                              <1> ; ------------------------------------------------------------
    85                              <1> drawMenuArrow:
    86 00002A90 50                  <1>     push ax
    87 00002A91 53                  <1>     push bx
    88 00002A92 51                  <1>     push cx
    89 00002A93 52                  <1>     push dx
    90                              <1> 
    91                              <1>     ; Calculate Y position based on selection
    92 00002A94 31C0                <1>     xor ax, ax
    93 00002A96 A0[0006]            <1>     mov al, [current_selection]
    94 00002A99 BB1700              <1>     mov bx, MENU_BUTTON_HEIGHT
    95 00002A9C 83C30B              <1>     add bx, MENU_BUTTON_HEIGHT / 2  ; Spacing between buttons
    96 00002A9F F7E3                <1>     mul bx
    97 00002AA1 83C058              <1>     add ax, ARROW_FIRST_Y
    98 00002AA4 89C2                <1>     mov dx, ax
    99                              <1> 
   100                              <1>     ; Draw arrow
   101 00002AA6 B96400              <1>     mov cx, ARROW_X_OFFSET
   102 00002AA9 8A1E[1100]          <1>     mov bl, [dark_brown]     ; Arrow color
   103 00002AAD E83FD8              <1>     call drawSelectionArrow
   104                              <1> 
   105 00002AB0 5A                  <1>     pop dx
   106 00002AB1 59                  <1>     pop cx
   107 00002AB2 5B                  <1>     pop bx
   108 00002AB3 58                  <1>     pop ax
   109 00002AB4 C3                  <1>     ret
   110                              <1> 
   111                              <1> ; ------------------------------------------------------------
   112                              <1> ; clearMenuArrow
   113                              <1> ; Erases arrow at current selection (draws space in bg color)
   114                              <1> ; ------------------------------------------------------------
   115                              <1> clearMenuArrow:
   116 00002AB5 50                  <1>     push ax
   117 00002AB6 53                  <1>     push bx
   118 00002AB7 51                  <1>     push cx
   119 00002AB8 52                  <1>     push dx
   120                              <1> 
   121                              <1>     ; Calculate Y position
   122 00002AB9 31C0                <1>     xor ax, ax
   123 00002ABB A0[0006]            <1>     mov al, [current_selection]
   124 00002ABE BB1700              <1>     mov bx, MENU_BUTTON_HEIGHT
   125 00002AC1 83C30B              <1>     add bx, MENU_BUTTON_HEIGHT / 2
   126 00002AC4 F7E3                <1>     mul bx
   127 00002AC6 83C058              <1>     add ax, ARROW_FIRST_Y
   128 00002AC9 89C2                <1>     mov dx, ax
   129                              <1> 
   130                              <1>     ; Draw space (or redraw background color)
   131 00002ACB B96400              <1>     mov cx, ARROW_X_OFFSET
   132 00002ACE 8A1E[0300]          <1>     mov bl, [char_color]     ; Background color
   133 00002AD2 E81AD8              <1>     call drawSelectionArrow  ; Draws space in bg color
   134                              <1> 
   135 00002AD5 5A                  <1>     pop dx
   136 00002AD6 59                  <1>     pop cx
   137 00002AD7 5B                  <1>     pop bx
   138 00002AD8 58                  <1>     pop ax
   139 00002AD9 C3                  <1>     ret
   140                              <1> 
   141                              <1> ; ------------------------------------------------------------
   142                              <1> ; executeMenuChoice
   143                              <1> ; Executes the selected menu option
   144                              <1> ; INPUT: AL = selected option (0-2)
   145                              <1> ; ------------------------------------------------------------
   146                              <1> executeMenuChoice:
   147 00002ADA 50                  <1>     push ax
   148 00002ADB 53                  <1>     push bx
   149                              <1> 
   150 00002ADC 3C00                <1>     cmp al, MENU_OPTION_PLAY
   151 00002ADE 740A                <1>     je .start_game
   152 00002AE0 3C01                <1>     cmp al, MENU_OPTION_HELP
   153 00002AE2 7410                <1>     je .show_help
   154 00002AE4 3C02                <1>     cmp al, MENU_OPTION_EXIT
   155 00002AE6 7416                <1>     je .exit_game
   156 00002AE8 EB1B                <1>     jmp .done
   157                              <1> 
   158                              <1> .start_game:
   159 00002AEA C606[0106]01        <1>     mov byte [game_state], STATE_GAME
   160 00002AEF E8C401              <1>     call showMainGameScreen
   161 00002AF2 EB11                <1>     jmp .done
   162                              <1> 
   163                              <1> .show_help:
   164                              <1>     ; TODO: Implement help screen
   165                              <1>     ; For now, just show a message and return to menu
   166 00002AF4 E81100              <1>     call showHelpScreen
   167 00002AF7 C606[0106]00        <1>     mov byte [game_state], STATE_MENU
   168 00002AFC EB07                <1>     jmp .done
   169                              <1> 
   170                              <1> .exit_game:
   171 00002AFE C606[0106]04        <1>     mov byte [game_state], STATE_EXIT
   172 00002B03 EB00                <1>     jmp .done
   173                              <1> 
   174                              <1> .done:
   175 00002B05 5B                  <1>     pop bx
   176 00002B06 58                  <1>     pop ax
   177 00002B07 C3                  <1>     ret
   178                              <1> 
   179                              <1> ; ------------------------------------------------------------
   180                              <1> ; showHelpScreen (Placeholder)
   181                              <1> ; Shows instructions, press any key to return
   182                              <1> ; ------------------------------------------------------------
   183                              <1> showHelpScreen:
   184 00002B08 50                  <1>     push ax
   185 00002B09 53                  <1>     push bx
   186 00002B0A 51                  <1>     push cx
   187 00002B0B 52                  <1>     push dx
   188 00002B0C 56                  <1>     push si
   189                              <1> 
   190                              <1>     ; Clear screen to background
   191 00002B0D E88DD6              <1>     call clearScreen
   192                              <1> 
   193                              <1>     ; Display help text
   194 00002B10 B92800              <1>     mov cx, 40
   195 00002B13 BA3C00              <1>     mov dx, 60
   196 00002B16 BE[7A2B]            <1>     mov si, help_title
   197 00002B19 8A1E[1100]          <1>     mov bl, [dark_brown]
   198 00002B1D B702                <1>     mov bh, 2
   199 00002B1F E8BED6              <1>     call drawText
