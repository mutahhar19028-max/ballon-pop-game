     1                              <1> ; ============================================================
     2                              <1> ; navigation.asm — Menu Navigation System with Arrow Keys
     3                              <1> ; ============================================================
     4                              <1> ; ------------------------------------------------------------
     5                              <1> ; drawMenuArrow
     6                              <1> ; Draws '>' arrow at current selection position
     7                              <1> ; ------------------------------------------------------------
     8                              <1> drawMenuArrow:
     9 00002B63 50                  <1>     push ax
    10 00002B64 53                  <1>     push bx
    11 00002B65 51                  <1>     push cx
    12 00002B66 52                  <1>     push dx
    13                              <1> 
    14                              <1>     ; Calculate Y position based on selection
    15 00002B67 31C0                <1>     xor ax, ax
    16 00002B69 A0[F805]            <1>     mov al, [current_selection]
    17 00002B6C BB1700              <1>     mov bx, MENU_BUTTON_HEIGHT
    18 00002B6F 83C30B              <1>     add bx, MENU_BUTTON_HEIGHT / 2  ; Spacing between buttons
    19 00002B72 F7E3                <1>     mul bx
    20 00002B74 83C058              <1>     add ax, ARROW_FIRST_Y
    21 00002B77 89C2                <1>     mov dx, ax
    22                              <1> 
    23                              <1>     ; Draw arrow
    24 00002B79 B96400              <1>     mov cx, ARROW_X_OFFSET
    25 00002B7C 8A1E[1100]          <1>     mov bl, [dark_brown]     ; Arrow color
    26 00002B80 E86CD7              <1>     call drawSelectionArrow
    27                              <1> 
    28 00002B83 5A                  <1>     pop dx
    29 00002B84 59                  <1>     pop cx
    30 00002B85 5B                  <1>     pop bx
    31 00002B86 58                  <1>     pop ax
    32 00002B87 C3                  <1>     ret
    33                              <1> 
    34                              <1> ; ------------------------------------------------------------
    35                              <1> ; clearMenuArrow
    36                              <1> ; Erases arrow at current selection (draws space in bg color)
    37                              <1> ; ------------------------------------------------------------
    38                              <1> clearMenuArrow:
    39 00002B88 50                  <1>     push ax
    40 00002B89 53                  <1>     push bx
    41 00002B8A 51                  <1>     push cx
    42 00002B8B 52                  <1>     push dx
    43                              <1> 
    44                              <1>     ; Calculate Y position
    45 00002B8C 31C0                <1>     xor ax, ax
    46 00002B8E A0[F805]            <1>     mov al, [current_selection]
    47 00002B91 BB1700              <1>     mov bx, MENU_BUTTON_HEIGHT
    48 00002B94 83C30B              <1>     add bx, MENU_BUTTON_HEIGHT / 2
    49 00002B97 F7E3                <1>     mul bx
    50 00002B99 83C058              <1>     add ax, ARROW_FIRST_Y
    51 00002B9C 89C2                <1>     mov dx, ax
    52                              <1> 
    53                              <1>     ; Draw space (or redraw background color)
    54 00002B9E B96400              <1>     mov cx, ARROW_X_OFFSET
    55 00002BA1 8A1E[0300]          <1>     mov bl, [char_color]     ; Background color
    56 00002BA5 E847D7              <1>     call drawSelectionArrow  ; Draws space in bg color
    57                              <1> 
    58 00002BA8 5A                  <1>     pop dx
    59 00002BA9 59                  <1>     pop cx
    60 00002BAA 5B                  <1>     pop bx
    61 00002BAB 58                  <1>     pop ax
    62 00002BAC C3                  <1>     ret
    63                              <1> handleMainMenuInput:
