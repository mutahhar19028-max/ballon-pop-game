    21                                  %include "Code\balloon_system.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; balloon_system.asm — Balloon System with Background Buffer
     3                              <1> ; ============================================================================
     4                              <1> ; Uses background buffering to avoid redrawing entire screen
     5                              <1> ; Saves pixels before drawing, restores them before moving
     6                              <1> ; ============================================================================
     7                              <1> 
     8                              <1> ; ------------------------------------------------------------
     9                              <1> ; BALLOON CONSTANTS
    10                              <1> ; ------------------------------------------------------------
    11                              <1> %define MAX_BALLOONS        9
    12                              <1> %define BALLOON_WIDTH       24              ; Pixels wide
    13                              <1> %define BALLOON_HEIGHT      21              ; Pixels tall
    14                              <1> %define BALLOON_STRING_LEN  2
    15                              <1> 
    16                              <1> %define SPAWN_Y             186             ; 200 - 14 = 186 (bottom)
    17                              <1> %define DESPAWN_Y           40
    18                              <1> %define MIN_SPAWN_X         30
    19                              <1> %define MAX_SPAWN_X         286             ; 320 - 16 = 304
    20                              <1> 
    21                              <1> %define BALLOON_SPEED       1
    22                              <1> %define MOVEMENT_DELAY      3               ; Move every 3 frames (slower!)
    23                              <1> %define SPAWN_DELAY         100
    24                              <1> 
    25                              <1> ; Buffer size per balloon: 16 * 14 = 224 bytes
    26                              <1> %define BUFFER_SIZE         504
    27                              <1> 
    28                              <1> ; Balloon colors (8 vibrant colors from your palette)
    29                              <1> balloon_colors:
    30 000032CB [0D][12][13][0A]-   <1>     db baby_light_light_blue, violet, grey, bright_cyan, light_orange, bright_yellow
    30 000032CF [07][05]            <1>
    31                              <1> ; ------------------------------------------------------------
    32                              <1> ; BALLOON DATA STRUCTURE (16 bytes per balloon)
    33                              <1> ; ------------------------------------------------------------
    34                              <1> ; Offset | Size | Description
    35                              <1> ; -------+------+---------------------------
    36                              <1> ; +0     | 2    | x_position (word)
    37                              <1> ; +2     | 2    | y_position (word)
    38                              <1> ; +4     | 1    | letter (byte, ASCII 'A'-'Z')
    39                              <1> ; +5     | 1    | color_index (byte, 0-7)
    40                              <1> ; +6     | 1    | active_flag (byte, 0=inactive, 1=active)
    41                              <1> ; +7     | 1    | speed (byte, pixels/frame)
    42                              <1> ; +8     | 2    | buffer_offset (word, pointer to background buffer)
    43                              <1> ; +10-15 | 6    | Reserved
    44                              <1> ; ------------------------------------------------------------
    45                              <1> 
    46 000032D1 00<rep 90h>         <1> balloon_array:      times (MAX_BALLOONS * 16) db 0
    47 00003361 00                  <1> balloon_count:      db 0
    48 00003362 0000                <1> spawn_timer:        dw 0
    49 00003364 0000                <1> random_seed:        dw 0
    50 00003366 00                  <1> movement_counter:   db 0        ; NEW: Frame counter for slower movement
    51                              <1> 
