    90                              <1> ; ------------------------------------------------------------
    91                              <1> ; load_palette — Loads "vga.bin" and programs VGA DAC registers
    92                              <1> ; (Unchanged from your original; called only once now)
    93                              <1> ; ------------------------------------------------------------
    94                              <1> load_palette:
    95 00000822 50                  <1>     push ax
    96 00000823 53                  <1>     push bx
    97 00000824 51                  <1>     push cx
    98 00000825 52                  <1>     push dx
    99 00000826 56                  <1>     push si
   100 00000827 1E                  <1>     push ds
   101                              <1> 
   102                              <1>     ; Open palette file
   103 00000828 8D16[6A08]          <1>     lea dx, [palette_filename]
   104 0000082C B43D                <1>     mov ah, 0x3D
   105 0000082E 30C0                <1>     xor al, al
   106 00000830 CD21                <1>     int 0x21
   107 00000832 7223                <1>     jc .lp_exit
   108 00000834 89C3                <1>     mov bx, ax
   109                              <1> 
   110                              <1>     ; Read 768 bytes (256 colors * 3 bytes)
   111 00000836 B43F                <1>     mov ah, 0x3F
   112 00000838 B90003              <1>     mov cx, 768
   113 0000083B 8D16[7628]          <1>     lea dx, [palette_buffer]
   114 0000083F CD21                <1>     int 0x21
   115                              <1> 
   116                              <1>     ; Close palette file
   117 00000841 B43E                <1>     mov ah, 0x3E
   118 00000843 CD21                <1>     int 0x21
   119                              <1> 
   120                              <1>     ; Write to VGA DAC registers
   121 00000845 BAC803              <1>     mov dx, 0x03C8
   122 00000848 30C0                <1>     xor al, al
   123 0000084A EE                  <1>     out dx, al                 ; start from color 0
   124 0000084B 42                  <1>     inc dx
   125 0000084C 8D36[7628]          <1>     lea si, [palette_buffer]
   126 00000850 B90003              <1>     mov cx, 768
   127                              <1> .lp_out:
   128 00000853 AC                  <1>     lodsb
   129 00000854 EE                  <1>     out dx, al
   130 00000855 E2FC                <1>     loop .lp_out
   131                              <1> 
   132                              <1> .lp_exit:
   133 00000857 1F                  <1>     pop ds
   134 00000858 5E                  <1>     pop si
   135 00000859 5A                  <1>     pop dx
   136 0000085A 59                  <1>     pop cx
   137 0000085B 5B                  <1>     pop bx
   138 0000085C 58                  <1>     pop ax
   139 0000085D C3                  <1>     ret
   140                              <1> 
   141                              <1> 
   142                              <1> ; ------------------------------------------------------------
   143                              <1> ; Data Buffers and Filenames
   144                              <1> ; ------------------------------------------------------------
   145 0000085E 696D67446174612E72- <1> filename          db "imgData.raw",0
   145 00000867 617700              <1>
   146 0000086A 70616C657474652E62- <1> palette_filename  db "palette.bin",0
   146 00000873 696E00              <1>
   147                              <1> 
   148 00000876 00<rep 2000h>       <1> buffer            times CHUNK_SIZE db 0
   149 00002876 00<rep 300h>        <1> palette_buffer    times 768 db 0
   150                              <1> 
   151                              <1> ; NEW: one-byte flag: 0 = palette not loaded yet, 1 = loaded
   152 00002B76 00                  <1> palette_loaded    db 0
