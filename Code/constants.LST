   154                                  ;;;;;;;;;;;;;;;;;;;;MAIN GAME SCREEN;;;;;;;;;;;;;;;;;;;;;;;;;;
   155                                  ; ============================================================
   156                                  ; main_game_screen.asm — Game UI Components (Static Display)
   157                                  ; Draws score, timer, buttons, and game elements
   158                                  ; ============================================================
   159                                  
   160                                  ; ------------------------------------------------------------
   161                                  ; CONFIGURATION CONSTANTS - Customize these for easy changes
   162                                  ; ------------------------------------------------------------
   163                                  
   164                                  ; === COLORS (VGA 256-color palette indices) ===
   165                                  %define COLOR_WHITE         180 ; border
   166                                  %define COLOR_BLACK         200 ; score text
   167                                  %define COLOR_BLUE          250 ; panel
   168                                  %define COLOR_DARK_BLUE     0x01
   169                                  %define COLOR_RED           0x0C
   170                                  %define COLOR_ORANGE        0x06
   171                                  %define COLOR_YELLOW        0x0E
   172                                  %define COLOR_LIGHT_GRAY    0x07
   173                                  %define COLOR_DARK_GRAY     0x08
   174                                  
   175                                  %define PADDING 2
   176                                  %define MAX_WIDTH 320
   177                                  %define BOX_WIDTH 90
   178                                  %define BOX_HEIGHT 20
   179                                  %define BASE_RADIUS 10
   180                                  
   181                                  ; === SCORE PANEL ===
   182                                  %define SCORE_PANEL_X       (MAX_WIDTH / 2) -  (SCORE_PANEL_WIDTH / 2) - PADDING
   183                                  %define SCORE_PANEL_Y       2 * PADDING
   184                                  %define SCORE_PANEL_WIDTH   BOX_WIDTH
   185                                  %define SCORE_PANEL_HEIGHT  BOX_HEIGHT
   186                                  %define SCORE_PANEL_COLOR   [light_blue]
   187                                  %define SCORE_BORDER_COLOR  [bold_leaves_green]
   188                                  %define SCORE_TEXT_X        (SCORE_PANEL_X + (SCORE_PANEL_WIDTH / 16)) + PADDING
   189                                  %define SCORE_TEXT_Y        ((SCORE_PANEL_Y + SCORE_PANEL_HEIGHT) / 2) - PADDING
   190                                  %define SCORE_VALUE_X       ((SCORE_PANEL_X + (SCORE_PANEL_WIDTH / 2)) + (SCORE_PANEL_WIDTH / 3))
   191                                  %define SCORE_VALUE_Y       ((SCORE_PANEL_Y + SCORE_PANEL_HEIGHT) / 2)
   192                                  
   193                                  ; === TIMER PANEL ===
   194                                  %define TIMER_PANEL_X       MAX_WIDTH - (TIMER_PANEL_WIDTH + 3 * PADDING)
   195                                  %define TIMER_PANEL_Y       2 * PADDING
   196                                  %define TIMER_PANEL_WIDTH   BOX_WIDTH
   197                                  %define TIMER_PANEL_HEIGHT  BOX_HEIGHT
   198                                  %define TIMER_PANEL_COLOR   [baby_light_light_blue]
   199                                  %define TIMER_BORDER_COLOR  [bold_leaves_green]
   200                                  %define TIMER_TEXT_X        (TIMER_PANEL_X + (TIMER_PANEL_WIDTH / 16)) + PADDING
   201                                  %define TIMER_TEXT_Y        ((TIMER_PANEL_Y + TIMER_PANEL_HEIGHT) / 2) - PADDING
   202                                  %define TIMER_VALUE_X       TIMER_PANEL_X 
   203                                  %define TIMER_VALUE_Y       ((TIMER_PANEL_Y + TIMER_PANEL_HEIGHT) / 2)
   204                                  
   205                                  ; === SOUND BUTTON ===
   206                                  %define SOUND_BTN_RADIUS    BASE_RADIUS
   207                                  %define SOUND_BTN_X         PADDING + ((SOUND_BTN_RADIUS / 2) + SOUND_BTN_RADIUS)
   208                                  %define SOUND_BTN_Y         ((PADDING / 2) + PADDING) + SOUND_BTN_RADIUS
   209                                  %define SOUND_BTN_COLOR     COLOR_BLUE
   210                                  %define SOUND_BTN_BORDER    COLOR_WHITE
   211                                  
   212                                  ; === PAUSE BUTTON ===
   213                                  %define PAUSE_BTN_RADIUS    BASE_RADIUS
   214                                  %define PAUSE_BTN_X         SOUND_BTN_X + (((SOUND_BTN_RADIUS / 2) + SOUND_BTN_RADIUS) + PADDING + PAUSE_BTN_RADIUS)
   215                                  %define PAUSE_BTN_Y         ((PADDING / 2) + PADDING) + PAUSE_BTN_RADIUS
   216                                  %define PAUSE_BTN_COLOR     COLOR_BLUE
   217                                  %define PAUSE_BTN_BORDER    COLOR_WHITE
   218                                  
   219                                  ; === BALLOONS ===
   220                                  %define BALLOON_WIDTH       30
   221                                  %define BALLOON_HEIGHT      40
   222                                  %define BALLOON_STRING_LEN  30
   223                                  
   224                                  ; === TEXT RENDERING ===
   225                                  %define CHAR_WIDTH          8
   226                                  %define CHAR_HEIGHT         8
