    58                                  %define MENU_SPACING            18
    59                                  %define MENU_OPTION_X           (PAUSE_PANEL_X + 30)
    60                                  
    61                                  %define PAUSE_MENU_BUTTON_WIDTH     120
    62                                  %define PAUSE_MENU_BUTTON_HEIGHT    20
    63                                  %define PAUSE_MENU_BUTTON_X         PAUSE_PANEL_X + 30
    64                                  %define PAUSE_MENU_BUTTON_Y         PAUSE_PANEL_Y + PAUSE_PANEL_HEIGHT / 3
    65                                  
