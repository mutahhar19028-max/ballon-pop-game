    24                                  ;;;;;;;;;;;;;;;;PAUSE;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    25                                  ; ============================================================
    26                                  ; pause_screen.asm — Enhanced Pause Overlay with Animations
    27                                  ; ============================================================
    28                                  ; NOTE: Add these NEW FUNCTIONS to ui.asm for reusability:
    29                                  ;   - drawGradientRect     (AX=x, BX=y, CX=width, DX=height, SI=color1, DI=color2)
    30                                  ;   - drawTextCentered     (DS:SI -> string, BX=y, AL=color) [auto-centers on screen]
    31                                  ;   - drawMenuOption       (AX=x, BX=y, DS:SI -> string, AL=color, DL=selected_flag)
    32                                  ;   - drawDarkenOverlay    (AL=darkness_level 0-3) [darkens entire screen]
    33                                  ;   - drawPulseEffect      (frame_counter -> returns pulsing color in AL)
    34                                  ;
    35                                  ; Call showPauseScreen from main game loop when pause key pressed
    36                                  ; ============================================================
    37                                  
    38                                  ; ------------------------------------------------------------
    39                                  ; CONFIGURATION CONSTANTS
    40                                  ; ------------------------------------------------------------
    41                                  
    42                                  ; === COLORS ===
    43                                  %define PAUSE_PANEL_COLOR       [light_orange]    ; Dark blue
    44                                  %define PAUSE_BORDER_COLOR      [dark_orange]    ; Cyan
    45                                  %define PAUSE_TITLE_COLOR       [white]
    46                                  
