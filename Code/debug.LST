   568                                  
   569                                      ; toggle flag for saving registers
   570 0000030E C606[E10A]01                mov byte [regsaved], 1
   571                                  
   572                                      ; saving padded registers in 32 bit form with upper 16 bits zeroed
   573 00000313 8B46FE                      mov ax, [bp - 2]
   574 00000316 A3[E20A]                    mov [regs + 0], ax      ; AX
   575 00000319 8B46F8                      mov ax, [bp - 8]
