  1473 000007E5 C1660604                    shl word [bp + 6], 4        ; higher nibble is empty
  1474 000007E9 C1460404                    rol word [bp + 4], 4        ; higher nibble that is to be shifted to bp+6 is now in lower nibble
  1475                                  
  1476 000007ED B40F                        mov ah, 0xF                 ; prepare mask
  1477 000007EF 226604                      and ah, [bp + 4]            ; extract the higher nibble
  1478 000007F2 836606F0                    and word [bp + 6], 0xFFF0   ; reset lower nibble of higher word
  1479 000007F6 086606                      or [bp + 6], ah             ; pasted higher nibble to the higher word
  1480                                  
  1481 000007F9 836604F0                    and word [bp + 4], 0xFFF0   ; reset lower nibble of higher word
  1482 000007FD 084604                      or [bp + 4], al             ; pasted extracted lower nibble to the lower word
  1483                                  
  1484 00000800 46                          inc si
  1485 00000801 E2D8                        loop extract_next_hex
  1486                                  
  1487 00000803 5E                          pop si
  1488 00000804 59                          pop cx
  1489 00000805 58                          pop ax
  1490                                  
  1491 00000806 5D                          pop bp
  1492 00000807 C3                          ret
