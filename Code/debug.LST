   543                                  ; check for interrupt instruction and apply temporary breakpoint
   544                                  check_interrupt:
   545 000002EE 8E4604                      mov es, [bp + 4]
   546 000002F1 8B7E02                      mov di, [bp + 2]
   547 000002F4 268A05                      mov al, [es:di]
   548                                  
   549                                      ; check if next instruction is an interrupt
   550 000002F7 3CCD                        cmp al, 0xCD
   551 000002F9 750C                        jne check_interrupt_done
   552                                  
   553                                      ; store next instructions opcode. if already a breakpoint then will ignore it due to default value
   554 000002FB 268A4502                    mov al, [es:di + 2]
   555 000002FF A2[480D]                    mov [intopcode], al
   556                                      ; apply temporary breakpoint and will be restored in brkisr
   557 00000302 26C64502CC                  mov byte [es:di + 2], 0xCC
   558                                  
