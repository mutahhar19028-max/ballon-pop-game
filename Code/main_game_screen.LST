   295                                  ;------------------------------------------------------------
   296                                  ; =============================================================
   297                                  ; Tiny 8x10 balloon sprite + fixed bitmap drawer + drawBalloon
   298                                  ; NASM syntax, VGA mode 13h (segment A000h)
   299                                  ; -------------------------------------------------------------
   300                                  ; balloon_bitmap: 8 pixels wide, 14 rows, one byte per pixel:
   301                                  ;   0 = transparent, 1 = filled pixel
   302                                  ; =============================================================
   303                                  balloon_bitmap:
   304 000000F9 0000010100000000            db 0,0,1,1,0,0,0,0   ; row 0
   305 00000101 0001010101000000            db 0,1,1,1,1,0,0,0   ; row 1
   306 00000109 0101010101010000            db 1,1,1,1,1,1,0,0   ; row 2
   307 00000111 0001010101000000            db 0,1,1,1,1,0,0,0   ; row 3
   308 00000119 0000010100000000            db 0,0,1,1,0,0,0,0   ; row 4
   309 00000121 0000000100000000            db 0,0,0,1,0,0,0,0   ; row 5  (start of tail)
   310 00000129 0000010000000000            db 0,0,1,0,0,0,0,0   ; row 6
   311 00000131 0001000000000000            db 0,1,0,0,0,0,0,0   ; row 7
   312 00000139 0001000000000000            db 0,1,0,0,0,0,0,0   ; row 8
   313 00000141 0100000000000000            db 1,0,0,0,0,0,0,0   ; row 9
   314                                  ; =============================================================
   315                                  ; small buffer to hold single char for drawText
   316 00000149 00                      balloon_char: db 0
   317                                  ; =============================================================
   318                                  
   319                                  ; =============================================================
   320                                  ; drawBitmap8x14
   321                                  ; Draws an 8x14 monochrome bitmap (1 byte per pixel)
   322                                  ; Inputs:
   323                                  ;   AX = X position (0..319)
   324                                  ;   BX = Y position (0..199)
   325                                  ;   BL = color palette index to draw filled pixels
   326                                  ;   SI = pointer to bitmap data (must be 8*14 bytes)
   327                                  ; Behavior:
   328                                  ;   - Writes to VGA frame buffer at segment 0xA000 (mode 13h)
   329                                  ;   - 0 byte = transparent, non-zero = draw pixel using BL
   330                                  ; Clobbers: AX,CX,DX,DI
   331                                  ; Preserves: SI is advanced by 8*14 (that's OK; caller may reload SI)
   332                                  ; =============================================================
   333                                  drawBitmap8x14:
   334 0000014A 50                          push ax
   335 0000014B 53                          push bx
   336 0000014C 51                          push cx
   337 0000014D 52                          push dx
   338 0000014E 57                          push di
   339 0000014F 06                          push es
   340                                  
   341                                      ; DI temporary = X
   342 00000150 89C7                        mov di, ax             ; DI = X
   343                                  
   344                                      ; set ES = VGA segment
   345 00000152 B800A0                      mov ax, 0xA000
   346 00000155 8EC0                        mov es, ax
   347                                  
   348                                      ; compute start offset = Y * 320 + X
   349                                      ; AX currently = (was X), but we need Y => use BX
   350 00000157 89D8                        mov ax, bx             ; AX = Y
   351 00000159 B94001                      mov cx, 320
   352 0000015C F7E1                        mul cx                 ; DX:AX = Y * 320  (fits in AX for Y<=199)
   353 0000015E 01F8                        add ax, di             ; AX = Y*320 + X
   354 00000160 89C7                        mov di, ax             ; DI = start offset in VGA memory
   355                                  
   356                                      ; Outer loop: 14 rows
   357 00000162 B90E00                      mov cx, 14             ; CX = row count
   358                                  
   359                                  .row_loop:
   360                                      ; Inner loop: 8 columns
   361 00000165 BB0800                      mov bx, 8              ; BX = column count
   362                                  .inner_col:
   363 00000168 AC                          lodsb                  ; AL = next bitmap byte, SI++
   364 00000169 3C00                        cmp al, 0
   365 0000016B 0F84B500                    je .skip_draw
   366 0000016F 26881D                      mov [es:di], bl        ; draw pixel color BL at ES:DI
   367                                  .skip_draw:
   368 00000172 47                          inc di                 ; advance destination
   369 00000173 4B                          dec bx
   370 00000174 75F2                        jnz .inner_col
   371                                  
   372                                      ; advance DI to next scanline start:
   373                                      ; DI currently = start_of_row + 8
   374                                      ; add (320 - 8) = 312 to DI
   375 00000176 81C73801                    add di, 312
   376                                  
   377 0000017A 49                          dec cx
   378 0000017B 75E8                        jnz .row_loop
   379                                  
   380 0000017D 07                          pop es
   381 0000017E 5F                          pop di
   382 0000017F 5A                          pop dx
   383 00000180 59                          pop cx
   384 00000181 5B                          pop bx
   385 00000182 58                          pop ax
   386 00000183 C3                          ret
   387                                  
   388                                  ; =============================================================
   389                                  ; drawBalloon
   390                                  ; Draws 8x14 balloon and prints one character centered inside.
   391                                  ; Inputs (caller must set):
   392                                  ;   AX = X position (left of balloon)
   393                                  ;   BX = Y position (top of balloon)
   394                                  ;   CL = color to use for balloon fill (palette index)
   395                                  ;   DL = ascii char to draw inside balloon
   396                                  ; Uses drawBitmap8x14 and your drawText routine (signature expected:
   397                                  ;   drawText: CX=x, DX=y, SI=ptr, BL=color, BH=scale)
   398                                  ; =============================================================
   399                                  drawBalloon:
   400 00000184 50                          push ax
   401 00000185 53                          push bx
   402 00000186 51                          push cx
   403 00000187 52                          push dx
   404 00000188 56                          push si
   405 00000189 57                          push di
   406 0000018A 55                          push bp
   407                                  
   408                                      ; store inputs in local regs/stack (so we can easily reference)
   409 0000018B 89E5                        mov bp, sp
   410                                      ; We'll write the char into balloon_char in data, then pass its address
   411 0000018D 8816[4901]                  mov [balloon_char], dl   ; store single char
   412                                  
   413                                      ; prepare args for drawBitmap8x14
   414 00000191 BE[F900]                    mov si, balloon_bitmap   ; SI -> bitmap data
   415 00000194 88CB                        mov bl, cl               ; BL = balloon color
   416                                      ; AX = X already, BX = Y already
   417 00000196 E8B1FF                      call drawBitmap8x14
   418                                  
   419                                      ; drawText parameters:
   420                                      ; choose offsets to center single char inside 8x14 balloon
   421                                      ; the font is 9x16 normally — but for single small char, choose offsets that look centered.
   422                                      ; set CX = X + 2, DX = Y + 3, SI = addr(balloon_char), BL = text color, BH = scale
   423 00000199 89C0                        mov ax, ax               ; AX still X (unless caller clobbered) — safer: recompute X from stack?
   424                                      ; We preserved AX at start, so it's still original X.
   425 0000019B 89C1                        mov cx, ax
   426 0000019D 83C102                      add cx, 2
   427                                  
   428 000001A0 89DA                        mov dx, bx
   429 000001A2 83C203                      add dx, 3
   430                                  
   431 000001A5 8D36[4901]                  lea si, [balloon_char]
   432 000001A9 B300                        mov bl, 0x00             ; text color index — change as needed (0=black)
   433 000001AB B701                        mov bh, 1                ; scale = 1
   434                                      call drawText
   434          ******************       error: symbol `drawText' not defined
   435                                  
   436 000001AD 5D                          pop bp
   437 000001AE 5F                          pop di
   438 000001AF 5E                          pop si
   439 000001B0 5A                          pop dx
   440 000001B1 59                          pop cx
   441 000001B2 5B                          pop bx
   442 000001B3 58                          pop ax
   443 000001B4 C3                          ret
   444                                  
   445                                  ; =============================================================
   446                                  ; drawSampleBalloons - simple demo draws a few balloons
   447                                  ; Adjust palette indices to your palette:
   448                                  ; =============================================================
   449                                  drawSampleBalloons:
   450 000001B5 50                          push ax
   451 000001B6 53                          push bx
   452 000001B7 51                          push cx
   453 000001B8 52                          push dx
   454                                  
   455                                      ; Balloon 1
   456 000001B9 B85000                      mov ax, 80
   457 000001BC BB5000                      mov bx, 80
   458 000001BF B10C                        mov cl, 12      ; balloon color palette index (example)
   459 000001C1 B231                        mov dl, '1'
   460 000001C3 E8BEFF                      call drawBalloon
   461                                  
   462                                      ; Balloon 2
   463 000001C6 B87800                      mov ax, 120
   464 000001C9 BB5A00                      mov bx, 90
   465 000001CC B109                        mov cl, 9
   466 000001CE B232                        mov dl, '2'
   467 000001D0 E8B1FF                      call drawBalloon
   468                                  
   469                                      ; Balloon 3
   470 000001D3 B8A000                      mov ax, 160
   471 000001D6 BB4600                      mov bx, 70
   472 000001D9 B10E                        mov cl, 14
   473 000001DB B233                        mov dl, '3'
   474 000001DD E8A4FF                      call drawBalloon
   475                                  
   476 000001E0 5A                          pop dx
   477 000001E1 59                          pop cx
   478 000001E2 5B                          pop bx
   479 000001E3 58                          pop ax
   480 000001E4 C3                          ret
