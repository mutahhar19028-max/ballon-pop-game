    63                                  ; ------------------------------------------------------------
    64                                  ; PUBLIC: drawScoreValue
    65                                  ; Draws the current score at defined position
    66                                  ; Called by drawScorePanel
    67                                  ; ------------------------------------------------------------
    68                                  drawScoreValue:
    69 00000027 50                          push ax
    70 00000028 53                          push bx
    71 00000029 51                          push cx
    72 0000002A 52                          push dx
    73 0000002B 56                          push si
    74 0000002C 57                          push di
    75 0000002D 55                          push bp
    76                                  
    77                                      ; Allocate 5 bytes for "0000\0"
    78 0000002E 83EC05                      sub sp, 5
    79 00000031 89E5                        mov bp, sp          ; BP points to buffer
    80                                  
    81                                      mov ax, [current_score]  ; AX = current score
    81          ******************       error: symbol `current_score' not defined
    82                                  
    83                                      ; --- Thousands digit ---
    84 00000033 B9E803                      mov cx, 1000
    85 00000036 31D2                        xor dx, dx
    86 00000038 F7F1                        div cx                  ; AX / 1000 -> AX = quotient in AL, DX = remainder
    87 0000003A 0430                        add al, '0'
    88 0000003C 884600                      mov [bp], al            ; store thousands digit
    89                                  
    90                                      ; --- Hundreds digit ---
    91 0000003F 89D0                        mov ax, dx               ; remainder from thousands division
    92 00000041 B96400                      mov cx, 100
    93 00000044 31D2                        xor dx, dx
    94 00000046 F7F1                        div cx                   ; AX / 100 -> AL = hundreds, DX = remainder
    95 00000048 0430                        add al, '0'
    96 0000004A 884601                      mov [bp+1], al
    97                                  
    98                                      ; --- Tens digit ---
    99 0000004D 89D0                        mov ax, dx               ; remainder from hundreds
   100 0000004F B90A00                      mov cx, 10
   101 00000052 31D2                        xor dx, dx
   102 00000054 F7F1                        div cx                   ; AX / 10 -> AL = tens, DX = ones
   103 00000056 0430                        add al, '0'
   104 00000058 884602                      mov [bp+2], al
   105                                  
   106                                      ; --- Ones digit ---
   107 0000005B 88D0                        mov al, dl               ; remainder from tens division
   108 0000005D 0430                        add al, '0'
   109 0000005F 884603                      mov [bp+3], al
   110                                  
   111                                      ; --- Null terminator ---
   112 00000062 C6460400                    mov byte [bp+4], 0
   113                                  
   114                                      ; Draw score string
   115                                      mov cx, SCORE_VALUE_X - 14
   115          ******************       error: symbol `SCORE_VALUE_X' not defined
   116                                      mov dx, SCORE_VALUE_Y - 2
   116          ******************       error: symbol `SCORE_VALUE_Y' not defined
   117 00000066 89EE                        mov si, bp
   118                                      mov bl, [dark_brown]
   118          ******************       error: symbol `dark_brown' not defined
   119 00000068 B701                        mov bh, 1
   120                                      call drawText
   120          ******************       error: symbol `drawText' not defined
   121                                  
   122 0000006A 83C405                      add sp, 5
   123 0000006D 5D                          pop bp
   124 0000006E 5F                          pop di
   125 0000006F 5E                          pop si
   126 00000070 5A                          pop dx
   127 00000071 59                          pop cx
   128 00000072 5B                          pop bx
   129 00000073 58                          pop ax
   130 00000074 C3                          ret
