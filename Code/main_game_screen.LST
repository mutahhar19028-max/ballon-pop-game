    65                                  ; PUBLIC: drawScoreValue
    66                                  ; Draws the current score at defined position
    67                                  ; Called by drawScorePanel
    68                                  ; ------------------------------------------------------------
    69                                  drawScoreValue:
    70 0000002D 50                          push ax
    71 0000002E 53                          push bx
    72 0000002F 51                          push cx
    73 00000030 52                          push dx
    74 00000031 56                          push si
    75 00000032 57                          push di
    76 00000033 55                          push bp
    77                                  
    78                                      ; Allocate 5 bytes for "0000\0"
    79 00000034 83EC05                      sub sp, 5
    80 00000037 89E5                        mov bp, sp          ; BP points to buffer
    81                                  
    82                                      mov ax, [current_score]  ; AX = current score
    82          ******************       error: symbol `current_score' not defined
    83                                  
    84                                      ; --- Thousands digit ---
    85 00000039 B9E803                      mov cx, 1000
    86 0000003C 31D2                        xor dx, dx
    87 0000003E F7F1                        div cx                  ; AX / 1000 -> AX = quotient in AL, DX = remainder
    88 00000040 0430                        add al, '0'
    89 00000042 884600                      mov [bp], al            ; store thousands digit
    90                                  
    91                                      ; --- Hundreds digit ---
    92 00000045 89D0                        mov ax, dx               ; remainder from thousands division
    93 00000047 B96400                      mov cx, 100
    94 0000004A 31D2                        xor dx, dx
    95 0000004C F7F1                        div cx                   ; AX / 100 -> AL = hundreds, DX = remainder
    96 0000004E 0430                        add al, '0'
    97 00000050 884601                      mov [bp+1], al
    98                                  
    99                                      ; --- Tens digit ---
   100 00000053 89D0                        mov ax, dx               ; remainder from hundreds
   101 00000055 B90A00                      mov cx, 10
   102 00000058 31D2                        xor dx, dx
   103 0000005A F7F1                        div cx                   ; AX / 10 -> AL = tens, DX = ones
   104 0000005C 0430                        add al, '0'
   105 0000005E 884602                      mov [bp+2], al
   106                                  
   107                                      ; --- Ones digit ---
   108 00000061 88D0                        mov al, dl               ; remainder from tens division
   109 00000063 0430                        add al, '0'
   110 00000065 884603                      mov [bp+3], al
   111                                  
   112                                      ; --- Null terminator ---
   113 00000068 C6460400                    mov byte [bp+4], 0
   114                                  
   115                                      ; Draw score string
   116                                      mov cx, SCORE_VALUE_X
   116          ******************       error: symbol `SCORE_VALUE_X' not defined
   117                                      mov dx, SCORE_VALUE_Y
   117          ******************       error: symbol `SCORE_VALUE_Y' not defined
   118 0000006C 89EE                        mov si, bp
   119                                      mov bl, [dark_brown]
   119          ******************       error: symbol `dark_brown' not defined
   120 0000006E B701                        mov bh, 1
   121                                      call drawText
   121          ******************       error: symbol `drawText' not defined
   122                                  
   123 00000070 83C405                      add sp, 5
